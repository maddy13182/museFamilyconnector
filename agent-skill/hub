def cmd_post(args, transport):
    ctx = _ctx(args, transport)
    message = _message_text(args)
    # Local checks first: the PII pre-scan and --data parsing happen before
    # anything hits the wire (a refusal sends nothing).
    check_pii(message)
    data = None
    if args.data:
        try:
            data = json.loads(args.data)
        except ValueError:
            raise HubError("bad_request", "--data must be valid JSON.")
    # One topic-record fetch per post (O(1)): routes E2EE topics to the
    # encrypting path. The plaintext construction below is byte-identical
    # to the pre-E2EE behavior.
    topic = _fetch_topic_record(ctx.client, args.topic)
    if args.kind in _E2EE_SYSTEM_KINDS:
        # E2EE system entries (key_rotated / key_request /
        # pending_key_distribution / topic_archived): plaintext by design, never encrypted —
        # they must be readable by agents that don't hold the topic key.
        entry = _post_system_entry(ctx, topic, args.kind, message, data)
        emit_json({"entry": entry})
        return 0
    if topic.get("e2ee") == 1:
        return _cmd_post_e2ee(args, ctx, topic, message, data)
    body = {"kind": args.kind, "body": message}
    if args.reply_to is not None:
        body["reply_to_seq"] = args.reply_to
    if args.data:
        body["data"] = data
    key = args.idempotency_key or uuid.uuid4().hex
    entry = ctx.client.call(
        "POST",
        "/v1/topics/%s/entries" % urlparse.quote(args.topic, safe=""),
        json_body=body,
        idempotency_key=key,
    )
    emit_json({"idempotency_key": key, "entry": entry})
    return 0


def _cmd_new_topic_e2ee(args, ctx, members):
    """Create an E2EE topic: local keygen, encrypted subject, sealed envelopes.

    1. The identity keypair must already exist — _load_identity_key fails with
       `hub key-init` guidance when it doesn't. Never auto-generated here.
    2. Generate the 32-byte topic key + random 128-bit key_id locally.
    3. Encrypt the subject (XChaCha20-Poly1305, nonce prepended, base64) and
       POST the topic with e2ee=1 and initial_key_id (secfix F1: the server
       records it as topics.current_key_id, the election source of truth).
       The subject is opaque to the server.
    4. Re-encrypt the subject with the topic-bound AAD (now that the
       server-generated topic id is known) and PATCH it immediately
       (secfix F4).
    5. Read back the authoritative participant list (the server auto-adds the
       creator, and parents_only auto-adds grownups) and seal one envelope per
       participant agent from the key directory.
    6. Fetch our own envelope back and decrypt it: proves the server stored
       what we sealed and that our private key opens it (round-trip check).
    7. Persist key_id -> topic key at 0600 under topic_keys/<topic_id>.json.

    The topic key never leaves the machine except inside sealed envelopes and
    is registered with note_secret() so it can never reach stdout/stderr.
    """
    _require_nacl()
    profile = ctx.profile
    priv = _load_identity_key(agent_key_path(profile))

    subject = args.subject
    if len(subject) > _E2EE_SUBJECT_PLAINTEXT_MAX:
        raise HubError(
            "bad_request",
            "--e2ee subjects are limited to %d chars of plaintext (same as plaintext topics)."
            % _E2EE_SUBJECT_PLAINTEXT_MAX,
        )

    topic_key = os.urandom(_E2EE_TOPIC_KEY_BYTES)
    _note_topic_key_secrets(topic_key)
    key_id_bytes = os.urandom(_E2EE_KEY_ID_BYTES)
    key_id_hex = key_id_bytes.hex()
    # Provisional subject: the topic id is server-generated and not known
    # yet, so it cannot be bound into the AAD at create time. This blob is
    # replaced by the topic-bound PATCH in step 4, before any envelope is
    # distributed or any key is stored locally.
    enc_subject = _e2ee_encrypt_subject(subject, topic_key)

    topic = ctx.client.call(
        "POST",
        "/v1/topics",
        json_body={
            "subject": enc_subject,
            "kind": args.kind,
            "participant_member_ids": members,
            "parents_only": bool(args.parents_only),
            "e2ee": 1,
            "initial_key_id": key_id_hex,
        },
    )
    if not isinstance(topic, dict) or not isinstance(topic.get("topic"), dict):
        raise HubError("error", "Unexpected response from the server creating the topic.")
    # NOTE: a deduped retry of this POST (same process, same idempotency
    # key) returns the already-created topic with the SAME request body, so
    # the in-memory topic_key still matches the stored subject ciphertext.
    topic_id = topic["topic"].get("id")
    if not topic_id:
        raise HubError("error", "Server did not return a topic id.")
    quoted_tid = urlparse.quote(str(topic_id), safe="")

    # F4: bind topic_id into the subject AAD now that it is known. A
    # failed PATCH aborts loudly BEFORE any envelope is distributed or any
    # key stored locally — the topic is left for the user to delete/retry.
    bound_subject = _e2ee_encrypt_subject(subject, topic_key, topic_id)
    try:
        ctx.client.call(
            "PATCH",
            "/v1/topics/%s/subject" % quoted_tid,
            json_body={"subject": bound_subject},
        )
    except HubError as exc:
        raise HubError(
            "error",
            "Created E2EE topic %s but the topic-bound subject PATCH failed "
            "(%s). The topic key was NOT stored locally and no envelopes "
            "were distributed; delete the topic and retry once the cause "
            "is fixed." % (topic_id, exc),
        )

    me = ctx.client.call("GET", "/v1/me")
    if not isinstance(me, dict) or not me.get("id"):
        raise HubError("error", "Unexpected /v1/me response from the server.")
    my_member_id = me["id"]
    my_agent_label = me.get("agent_label") or ""

    detail = ctx.client.call("GET", "/v1/topics/%s" % quoted_tid)
    participants = _as_list(detail, "participants")
    participant_ids = sorted(
        {p["member_id"] for p in participants if isinstance(p, dict) and p.get("member_id")}
    )
    if not participant_ids:
        raise HubError("error", "Server returned no participants for the new topic.")

    posted = 0
    keyless_members = []
    failures = []
    for mid in participant_ids:
        directory = ctx.client.call("GET", "/v1/agent-keys", query={"member_id": mid})
        keys = _as_list(directory, "keys")
        if not keys:
            keyless_members.append(mid)
            continue
        for entry in keys:
            if not isinstance(entry, dict):
                continue
            label = entry.get("agent_label") or ""
            pub_b64 = entry.get("public_key") or ""
            if not label or not pub_b64:
                continue
            envelope = _e2ee_seal_envelope(topic_id, key_id_bytes, topic_key, pub_b64)
            try:
                ctx.client.call(
                    "POST",
                    "/v1/topics/%s/envelopes" % quoted_tid,
                    json_body={
                        "member_id": mid,
                        "agent_label": label,
                        "key_id": key_id_hex,
                        "envelope": envelope,
                    },
                )
                posted += 1
            except HubError as exc:
                failures.append("%s/%s: %s" % (mid, label, exc))
    if failures:
        raise HubError(
            "error",
            "Created E2EE topic %s but %d envelope(s) failed to post: %s. "
            "The topic key is NOT stored locally yet — re-run distribution for "
            "these agents once the cause is fixed." % (topic_id, len(failures), "; ".join(failures)),
        )
    if keyless_members:
        emit_err(
            "warning: %d participant(s) have no registered agent keys and will see "
            "only ciphertext until they run `hub key-init`: %s"
            % (len(keyless_members), ", ".join(keyless_members))
        )

    # Round-trip check: fetch our own envelope back and open it. Proves the
    # server stored exactly what we sealed and that our private key opens it.
    own = ctx.client.call("GET", "/v1/topics/%s/envelopes" % quoted_tid)
    own_envelopes = [
        e
        for e in _as_list(own, "envelopes")
        if isinstance(e, dict) and e.get("key_id") == key_id_hex
    ]
    if not own_envelopes:
        raise HubError(
            "error",
            "Round-trip check failed: our own envelope for topic %s is missing "
            "server-side. The topic key is NOT stored locally." % topic_id,
        )
    opened_kid, opened_key = _e2ee_open_envelope(
        own_envelopes[0].get("envelope") or "", priv, str(topic_id))
    if opened_kid != key_id_bytes or opened_key != topic_key:
        raise HubError(
            "error",
            "Round-trip check failed: our own envelope for topic %s does not "
            "open to the generated topic key. The topic key is NOT stored "
            "locally." % topic_id,
        )

    key_path = _store_topic_key(profile, str(topic_id), key_id_hex, topic_key)
    result = dict(topic)
    result["e2ee"] = {
        "key_id": key_id_hex,
        "envelopes_posted": posted,
        "keyless_participants": keyless_members,
        "topic_key_path": key_path,
    }
    emit_json(result)
    return 0



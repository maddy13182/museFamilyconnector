def cmd_token_revoke(args, transport):
    """Emergency credential revocation (incident mechanism, spec §1.6/§3.8).

    POSTs /v1/auth/revoke for --token-id. The revocation is immediate and
    permanent: the token stops authenticating everywhere at once, on every
    device/agent that holds it; there is no undo. Requires an explicit
    confirmation prompt (bypass with --yes only when the incident demands
    it — this is the one command where unattended use is expected to be
    rare). If you revoke the token this CLI is currently using, re-enroll
    the agent afterwards: every later call 401s until then.
    """
    ctx = _ctx(args, transport)
    token_id = (args.token_id or "").strip()
    if not token_id:
        raise HubError(
            "bad_request",
            "--token-id is required: the id of the token to revoke (from "
            "`hub me` / circle membership output — the token VALUE is never "
            "accepted here). Nothing was revoked.",
        )
    if not args.yes:
        emit_err(
            "EMERGENCY REVOCATION: this permanently revokes token %r. The "
            "token stops authenticating immediately on every device/agent "
            "that holds it; there is no undo. Use this when a token is "
            "suspected compromised (incident runbook §3.8), then re-enroll "
            "the affected agent.\n"
            "Type 'yes' to revoke, anything else aborts." % token_id
        )
        try:
            answer = input()
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("yes", "y"):
            emit_err("revocation cancelled: the token is still valid.")
            return 1
    # Request shape {"token_id": ...} mirrors the command's --token-id 1:1
    # (spec keeps the endpoint but does not spell out the body; the
    # server's 400 names the expected field if this ever drifts).
    # Authenticated with the caller's (other) credential — revoking the
    # token in use is allowed, and expected in the incident flow.
    resp = ctx.client.call(
        "POST", "/v1/auth/revoke", json_body={"token_id": token_id}
    )
    emit_json(resp if isinstance(resp, dict) else {"ok": True, "token_id": token_id})
    emit_err("token %r revoked." % token_id)
    return 0



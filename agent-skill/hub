def cmd_agent_invite(args, transport):
    """Approve another own agent without exposing its single-use code in output."""
    output = os.path.abspath(args.output)
    resolved = os.path.realpath(output)
    root = os.path.realpath(os.path.join(config_home(), APP_DIR))
    if os.path.commonpath([resolved, root]) == root:
        raise HubError("config", "Store the approval outside the connector configuration directory.")
    ctx = _ctx(args, transport)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(output, flags, 0o600)
    except OSError as exc:
        raise HubError("config", "Cannot create private approval file; choose a new file in an existing directory.") from exc
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            me = ctx.client.call("GET", "/v2/me")
            member_id = me.get("id")
            if not member_id:
                raise HubError("config", "Select one of your active circles before approving an agent.")
            result = ctx.client.call("POST", "/v2/provisioning-codes", json_body={"member_id": member_id, "agent_label": args.label}, retries=0)
            code = result.get("provisioning_code")
            if not isinstance(code, str) or not re.fullmatch(r"fhp_[A-Za-z0-9_-]+", code):
                raise HubError("config", "Server returned an invalid agent approval.")
            note_secret(code)
            stream.write(code + "\n")
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        os.unlink(output)
        raise
    emit_json({"approval_file": output, "agent_label": args.label, "expires_at": result.get("expires_at"), "next_action": "Transfer this file privately; the new agent runs enroll --code-file PRIVATE-FILE with this label."})
    return 0



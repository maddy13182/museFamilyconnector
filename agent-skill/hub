def cmd_token_revoke(args, transport):
    """Emergency credential revocation (incident mechanism, spec §1.6/§3.8).

    POSTs /v2/auth/revoke for --token-id. The revocation is immediate and
    permanent: the token stops authenticating everywhere at once, on every
    device/agent that holds it; there is no undo. Requires an explicit
    confirmation prompt (bypass with --yes only when the incident demands
    it — this is the one command where unattended use is expected to be
    rare). If you revoke the token this CLI is currently using, re-enroll
    the agent afterwards: every later call 401s until then.
    """
    ctx = _ctx(args, transport)
    token_id = (args.token_id or "").strip()
    if not token_id:
        raise HubError(
            "bad_request",
            "--token-id is required: the id of the token to revoke (from "
            "`hub me` / circle membership output — the token VALUE is never "
            "accepted here). Nothing was revoked.",
        )
    if not args.yes:
        emit_err(
            "EMERGENCY REVOCATION: this permanently revokes token %r. The "
            "token stops authenticating immediately on every device/agent "
            "that holds it; there is no undo. Use this when a token is "
            "suspected compromised (incident runbook §3.8), then re-enroll "
            "the affected agent.\n"
            "Type 'yes' to revoke, anything else aborts." % token_id
        )
        try:
            answer = input()
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("yes", "y"):
            emit_err("revocation cancelled: the token is still valid.")
            return 1
    # Request shape {"token_id": ...} mirrors the command's --token-id 1:1
    # (spec keeps the endpoint but does not spell out the body; the
    # server's 400 names the expected field if this ever drifts).
    # Authenticated with the caller's (other) credential — revoking the
    # token in use is allowed, and expected in the incident flow.
    resp = ctx.client.call(
        "POST", "/v2/auth/revoke", json_body={"token_id": token_id}
    )
    emit_json(resp if isinstance(resp, dict) else {"ok": True, "token_id": token_id})
    emit_err("token %r revoked." % token_id)
    return 0


def _discovery_pages(client, kind, query=None):
    """Strict v1 envelope and keyset pagination; never accept a redirect/origin swap."""
    cursor = None
    seen = set()
    items = []
    for _page in range(1000):
        params = dict(query or {}, limit=100)
        if cursor:
            params["cursor"] = cursor
        response = client.call("GET", "/v2/discovery/" + kind, query=params)
        if (not isinstance(response, dict) or type(response.get("protocol_version")) is not int or response["protocol_version"] != 1
                or not isinstance(response.get("server"), dict)
                or response["server"].get("url") != client.base_url
                or not isinstance(response.get("data"), dict)
                or not isinstance(response.get("data", {}).get(kind), list)
                or not isinstance(response.get("page"), dict)
                or "next_cursor" not in response["page"]
                or type(response["page"].get("limit")) is not int
                or not 1 <= response["page"]["limit"] <= 100):
            raise HubError("protocol", "Invalid discovery response; refusing incomplete or misrouted results.")
        rows = response["data"][kind]
        id_key = "circle_id" if kind == "circles" else "user_id"
        if len(rows) > 100 or any(not isinstance(row, dict) or (not isinstance(row.get(id_key), str) or not row[id_key] or len(row[id_key]) > 128) for row in rows):
            raise HubError("protocol", "Invalid discovery items.")
        items.extend(rows)
        cursor = response["page"].get("next_cursor")
        if cursor is None:
            return items
        if not isinstance(cursor, str) or not cursor or cursor in seen:
            raise HubError("protocol", "Discovery returned an invalid or repeated cursor.")
        seen.add(cursor)
    raise HubError("protocol", "Discovery exceeded the page limit; narrow the search.")


def _discover(args, transport, kind):
    all_servers = getattr(args, "all_servers", False)
    if all_servers and args.server:
        raise HubError("config", "Choose --all-servers or one --server, not both.")
    if all_servers and getattr(args, "circle", None):
        raise HubError("config", "Select a server profile before filtering by a circle ID.")
    root = os.path.join(config_home(), APP_DIR, "profiles")
    if all_servers:
        profiles = sorted(entry.name for entry in os.scandir(root)
                          if entry.is_dir(follow_symlinks=False) and os.path.isfile(os.path.join(entry.path, "config.json"))) if os.path.isdir(root) else []
    else:
        profiles = [args.profile]

    def fetch_profile(profile):
        server = None
        try:
            cfg = load_config(profile)
            configured_server = cfg.get("server_url") if isinstance(cfg, dict) else None
            if not isinstance(configured_server, str) or not configured_server:
                raise HubError("config", "Profile has no valid server URL.")
            _validate_server_url(configured_server)
            server = configured_server.rstrip("/")
            if args.server and args.server.rstrip("/") != server:
                raise HubError("config", "Server does not match this profile; select the matching profile.")
            # Never broadcast an unscoped environment credential to other servers.
            token, _source = load_token(cfg, profile, allow_env=not all_servers)
            client = HubClient(server, token, debug=args.debug, transport=transport)
            health = client.call("GET", "/v2/health", auth=False, retries=1)
            if not isinstance(health, dict) or health.get("discovery_protocol") != 1:
                raise HubError("version", "This server does not support discovery protocol 1.")
            query = {"q": args.query} if kind == "people" and args.query else {}
            if kind == "people" and getattr(args, "circle", None):
                query["circle_id"] = args.circle
            rows = _discovery_pages(client, kind, query)
            return {"profile": profile, "server_url": server, "status": "ok"}, [dict(row, profile=profile, server_url=server) for row in rows], None
        except (HubError, OSError, ValueError, TypeError) as exc:
            code = exc.server_code or exc.code if isinstance(exc, HubError) else "config"
            # Fixed metadata only: raw exceptions can contain local paths or secrets.
            return {"profile": profile, "server_url": server, "status": "error"}, [], {"profile": profile, "server_url": server, "code": code}

    results = []
    if profiles:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, len(profiles))) as pool:
            results = list(pool.map(fetch_profile, profiles))
    servers = [result[0] for result in results]
    items = [item for result in results for item in result[1]]
    errors = [result[2] for result in results if result[2]]
    emit_json({"protocol_version": 1, "complete": not errors, "data": {kind: items}, "servers": servers, "errors": errors})
    return 1 if errors else 0



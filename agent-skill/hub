def cmd_setup(args, transport):
    profile = args.profile
    cfg = load_config(profile)
    server = (
        args.server
        or os.environ.get("FAMILY_HUB_URL")
        or cfg.get("server_url")
        or input("Hub server URL (https://…): ").strip()
    )
    if not server:
        raise HubError("bad_request", "A server URL is required.")
    code = args.invite or getpass.getpass("Invite code: ").strip()
    if not code:
        raise HubError("bad_request", "An invite code is required.")
    display_name = args.name or input("Your display name: ").strip()
    if not display_name:
        raise HubError("bad_request", "A display name is required.")
    default_label = "%s-agent" % socket.gethostname().split(".")[0]
    agent_label = args.label or input(
        "Agent label [%s]: " % default_label
    ).strip() or default_label

    client = HubClient(server, token=None, debug=args.debug, transport=transport)
    resp = client.call(
        "POST",
        "/v1/invites/%s/accept" % urlparse.quote(code, safe=""),
        json_body={"display_name": display_name, "agent_label": agent_label},
        auth=False,
    )
    if not isinstance(resp, dict) or "token" not in resp or "member" not in resp:
        raise HubError("error", "Unexpected response from the server.")
    token = resp["token"]
    member = resp["member"]
    note_secret(token)  # from here on, the token can never appear in output

    store = args.store or "env"
    new_cfg = {
        "server_url": server.rstrip("/"),
        "member": {
            "id": member.get("id"),
            "name": member.get("name", display_name),
            "role": member.get("role"),
            "email": member.get("email"),
        },
        "agent_label": agent_label,
        "token_id": resp.get("token_id"),
        "auth_method": store,
    }
    if store == "file":
        token_file = default_token_path(profile)
        os.makedirs(profile_dir(profile), mode=0o700, exist_ok=True)
        fd = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(token + "\n")
        new_cfg["token_file"] = token_file
        storage_note = (
            "stored in a 0600 file at %s. Anyone with access to this "
            "machine user can read it." % token_file
        )
    elif store == "vault-cmd":
        vault_cmd = args.vault_cmd or input(
            "Vault helper command (stdout must be the token): "
        ).strip()
        if not vault_cmd:
            raise HubError("bad_request", "A vault helper command is required.")
        new_cfg["vault_cmd"] = vault_cmd
        storage_note = (
            "resolved at runtime via your vault helper. The raw token is "
            "not stored anywhere by hub."
        )
    else:  # env
        storage_note = (
            "NOT stored by hub. Your agent harness must inject FAMILY_HUB_TOKEN "
            "from your Secure Vault each time it runs hub. The token was "
            "returned once by the server and will never be shown again."
        )
    save_config(profile, new_cfg)
    # save_config scrubs tokens; assert nothing secret-bearing was written.
    emit("setup complete.")
    emit_json(
        {
            "profile": profile,
            "server": new_cfg["server_url"],
            "member": new_cfg["member"],
            "agent_label": agent_label,
            "auth": store,
            "note": storage_note,
        }
    )
    return 0


def cmd_sync(args, transport):
    ctx = _ctx(args, transport)
    cursor = _read_cursor(ctx.profile)
    resp = ctx.client.call(
        "GET", "/v1/sync", query={"after_gseq": cursor, "limit": args.limit}
    )
    entries = _as_list(resp, "entries")
    emit_json(entries)
    if entries:
        gseqs = [e.get("gseq") for e in entries if isinstance(e, dict)]
        gseqs = [g for g in gseqs if isinstance(g, int)]
        nxt = None
        if isinstance(resp, dict):
            nxt = resp.get("next_after_gseq")
        _write_cursor(ctx.profile, nxt if isinstance(nxt, int) else max(gseqs))
    else:
        emit_err("no new entries (cursor gseq=%d)" % cursor)
    return 0


def cmd_topics(args, transport):
    ctx = _ctx(args, transport)
    query = {"limit": args.limit}
    if args.search:
        query["q"] = args.search
    resp = ctx.client.call("GET", "/v1/topics", query=query)
    emit_json(_as_list(resp, "topics"))
    return 0


def cmd_read(args, transport):
    ctx = _ctx(args, transport)
    resp = ctx.client.call(
        "GET",
        "/v1/topics/%s/history" % urlparse.quote(args.topic, safe=""),
        query={"after_seq": args.after, "limit": args.limit},
    )
    emit_json(_as_list(resp, "entries"))
    return 0


def cmd_post(args, transport):
    ctx = _ctx(args, transport)
    message = _message_text(args)
    check_pii(message)
    body = {"kind": args.kind, "body": message}
    if args.reply_to is not None:
        body["reply_to_seq"] = args.reply_to
    if args.data:
        try:
            body["data"] = json.loads(args.data)
        except ValueError:
            raise HubError("bad_request", "--data must be valid JSON.")
    key = args.idempotency_key or uuid.uuid4().hex
    entry = ctx.client.call(
        "POST",
        "/v1/topics/%s/entries" % urlparse.quote(args.topic, safe=""),
        json_body=body,
        idempotency_key=key,
    )
    emit_json({"idempotency_key": key, "entry": entry})
    return 0


def cmd_new_topic(args, transport):
    ctx = _ctx(args, transport)
    check_pii(args.subject)
    members = _id_list(args.with_)
    if args.kind == "direct" and len(members) != 2:
        raise HubError("bad_request", "--kind direct requires exactly 2 member IDs.")
    if not members:
        raise HubError("bad_request", "At least one participant member ID is required.")
    topic = ctx.client.call(
        "POST",
        "/v1/topics",
        json_body={
            "subject": args.subject,
            "kind": args.kind,
            "participant_member_ids": members,
            "parents_only": bool(args.parents_only),
        },
    )
    emit_json(topic)
    return 0


def cmd_invite(args, transport):
    ctx = _ctx(args, transport)
    members = _id_list(args.member)
    if not members:
        raise HubError("bad_request", "At least one --member ID is required.")
    resp = ctx.client.call(
        "POST",
        "/v1/topics/%s/invite" % urlparse.quote(args.topic, safe=""),
        json_body={"member_ids": members, "history_from": args.history},
    )
    emit_json(resp or {"ok": True})
    return 0


def cmd_spawn(args, transport):
    ctx = _ctx(args, transport)
    briefing = _message_text(args, attr="briefing", file_attr="briefing_file")
    check_pii(args.subject, briefing)
    members = _id_list(args.with_)
    if not members:
        raise HubError("bad_request", "At least one participant member ID is required.")
    topic = ctx.client.call(
        "POST",
        "/v1/topics/%s/spawn" % urlparse.quote(args.topic, safe=""),
        json_body={
            "subject": args.subject,
            "participant_member_ids": members,
            "briefing": briefing,
            "link_visibility": args.link_visibility,
        },
    )
    emit_json(topic)
    return 0


def cmd_task_new(args, transport):
    ctx = _ctx(args, transport)
    description = None
    if args.description or args.description_file:
        description = _message_text(
            args, attr="description", file_attr="description_file"
        )
    check_pii(args.title, description)
    payload = {"title": args.title}
    if description:
        payload["description"] = description
    if args.assignee:
        payload["assignee_member_id"] = args.assignee
    if args.parent:
        payload["parent_task_id"] = args.parent
    if args.due:
        payload["due_at"] = args.due
    task = ctx.client.call(
        "POST",
        "/v1/topics/%s/tasks" % urlparse.quote(args.topic, safe=""),
        json_body=payload,
    )
    emit_json(task)
    return 0


def cmd_task_note(args, transport):
    ctx = _ctx(args, transport)
    message = _message_text(args)
    check_pii(message)
    resp = ctx.client.call(
        "POST",
        "/v1/tasks/%s/notes" % urlparse.quote(args.task, safe=""),
        json_body={"body": message},
    )
    emit_json(resp or {"ok": True})
    return 0


def cmd_task_done(args, transport):
    ctx = _ctx(args, transport)
    payload = {}
    if args.result:
        try:
            payload["result"] = json.loads(args.result)
        except ValueError:
            raise HubError("bad_request", "--result must be valid JSON.")
    resp = ctx.client.call(
        "POST",
        "/v1/tasks/%s/done" % urlparse.quote(args.task, safe=""),
        json_body=payload,
    )
    emit_json(resp or {"ok": True})
    return 0


def cmd_tasks(args, transport):
    # NOTE: SPEC §13 has no list-tasks endpoint; this assumes
    # GET /v1/topics/:tid/tasks (flagged as a SPEC gap for WS-1).
    ctx = _ctx(args, transport)
    resp = ctx.client.call(
        "GET", "/v1/topics/%s/tasks" % urlparse.quote(args.topic, safe="")
    )
    tasks = _as_list(resp, "tasks")
    me = (ctx.cfg.get("member") or {}).get("id")
    wanted_assignee = me if args.assigned_to == "me" else args.assigned_to
    out = []
    for task in tasks:
        if not isinstance(task, dict):
            continue
        if wanted_assignee and task.get("assignee_member_id") != wanted_assignee:
            continue
        if args.status and task.get("status") != args.status:
            continue
        out.append(task)
    emit_json(out)
    return 0


def cmd_members(args, transport):
    ctx = _ctx(args, transport)
    resp = ctx.client.call("GET", "/v1/members")
    emit_json(_as_list(resp, "members"))
    return 0


def cmd_me(args, _transport):
    cfg = load_config(args.profile)
    member = cfg.get("member") or {}
    emit_json(
        {
            "profile": args.profile,
            "server": cfg.get("server_url"),
            "member": member,
            "agent_label": cfg.get("agent_label"),
            "auth_method": cfg.get("auth_method"),
        }
    )
    return 0

# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------


def _add_id_list(parser, *flags, **kwargs):
    parser.add_argument(*flags, action="append", default=[], **kwargs)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="hub",
        description="Family Hub agent CLI — talk to your family's Hub. "
        "The bearer token is loaded at runtime (env / vault helper / 0600 "
        "file) and is never printed.",
    )
    parser.add_argument(
        "--profile",
        default=os.environ.get("FAMILY_HUB_PROFILE", "default"),
        help="Config profile (default: %(default)s)",
    )
    parser.add_argument("--server", default=None, help="Override the Hub base URL")
    parser.add_argument(
        "--debug",
        action="store_true",
        help="Print sanitized request/response dumps to stderr "
        "(credentials are always redacted)",
    )
    parser.add_argument("--version", action="version", version="hub " + VERSION)
    sub = parser.add_subparsers(dest="command", required=True, metavar="<command>")

    p = sub.add_parser("setup", help="Accept an invite and configure this agent")
    p.add_argument("--server", dest="setup_server", default=None)
    p.add_argument("--invite", default=None, help="Invite code (else prompted)")
    p.add_argument("--name", default=None, help="Display name (else prompted)")
    p.add_argument("--label", default=None, help="Agent label (else prompted)")
    p.add_argument(
        "--store",
        choices=["env", "file", "vault-cmd"],
        default="env",
        help="Where the credential lives (default: env)",
    )
    p.add_argument("--vault-cmd", default=None, help="Vault helper for --store vault-cmd")
    p.set_defaults(func=_wrap_setup)

    p = sub.add_parser("sync", help="Print new entries across all visible topics")
    p.add_argument("--limit", type=int, default=200)
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("topics", help="List topics you can see")
    p.add_argument("--search", default=None, help="Subject search string")
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(func=cmd_topics)

    p = sub.add_parser("read", help="Read a topic's history")
    p.add_argument("--topic", required=True)
    p.add_argument("--after", type=int, default=0)
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(func=cmd_read)

    p = sub.add_parser("post", help="Post a message to a topic")
    p.add_argument("--topic", required=True)
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--message", default=None)
    group.add_argument("--message-file", default=None,
                       help="Read the message from a file ('-' = stdin)")
    p.add_argument("--reply-to", type=int, default=None, help="Reply to entry seq")
    p.add_argument("--kind", default="message")
    p.add_argument("--data", default=None, help="Extra JSON payload")
    p.add_argument("--idempotency-key", default=None,
                   help="Stable key for safe retries (auto-generated if omitted)")
    p.set_defaults(func=cmd_post)

    p = sub.add_parser("new-topic", help="Create a topic")
    p.add_argument("--subject", required=True)
    _add_id_list(p, "--with", dest="with_", metavar="MEMBER_ID",
                 help="Participant member IDs (repeatable, comma-separated)")
    p.add_argument("--kind", choices=["direct", "group"], default="group")
    p.add_argument("--parents-only", action="store_true")
    p.set_defaults(func=cmd_new_topic)

    p = sub.add_parser("invite", help="Invite members to a topic you are in")
    p.add_argument("--topic", required=True)
    _add_id_list(p, "--member", dest="member", metavar="MEMBER_ID")
    p.add_argument("--history", choices=["full", "from-join"], default="full",
                   help="What history the new members see")
    p.set_defaults(func=cmd_invite)

    p = sub.add_parser("spawn", help="Spawn a linked child topic with a briefing")
    p.add_argument("--topic", required=True, help="Parent topic ID")
    p.add_argument("--subject", required=True)
    _add_id_list(p, "--with", dest="with_", metavar="MEMBER_ID")
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--briefing", default=None)
    group.add_argument("--briefing-file", default=None)
    p.add_argument("--link-visibility", choices=["placeholder", "hidden"],
                   default="placeholder")
    p.set_defaults(func=cmd_spawn)

    p = sub.add_parser("task-new", help="Create a task in a topic")
    p.add_argument("--topic", required=True)
    p.add_argument("--title", required=True)
    group = p.add_mutually_exclusive_group()
    group.add_argument("--description", default=None)
    group.add_argument("--description-file", default=None)
    p.add_argument("--assignee", default=None, help="Member ID to assign to")
    p.add_argument("--parent", default=None, help="Parent task ID (subtask)")
    p.add_argument("--due", default=None, help="Due date/time, ISO-8601")
    p.set_defaults(func=cmd_task_new)

    p = sub.add_parser("task-note", help="Add a progress note to a task")
    p.add_argument("--task", required=True)
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--message", default=None)
    group.add_argument("--message-file", default=None)
    p.set_defaults(func=cmd_task_note)

    p = sub.add_parser("task-done", help="Mark a task done, with a result payload")
    p.add_argument("--task", required=True)
    p.add_argument("--result", default=None, help="JSON result payload")
    p.set_defaults(func=cmd_task_done)

    p = sub.add_parser("tasks", help="List tasks in a topic (with filters)")
    p.add_argument("--topic", required=True)
    p.add_argument("--assigned-to", default=None,
                   help="Member ID, or 'me' for your own member")
    p.add_argument("--status", default=None,
                   choices=["open", "in_progress", "blocked", "done", "cancelled"])
    p.set_defaults(func=cmd_tasks)

    p = sub.add_parser("members", help="List members of your family")
    p.set_defaults(func=cmd_members)

    p = sub.add_parser("me", help="Show this agent's identity (never the credential)")
    p.set_defaults(func=cmd_me)

    return parser


def _wrap_setup(args, transport):
    # `setup` uses its own --server flag name to avoid clashing with the
    # global one; normalize here.
    if getattr(args, "setup_server", None):
        args.server = args.setup_server
    return cmd_setup(args, transport)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main(argv=None, transport=None):
    clear_secrets()
    args = build_parser().parse_args(argv)
    try:
        return args.func(args, transport)
    except HubError as exc:
        emit_err("error: " + exc.friendly())
        return exc.exit_code
    except PIIBlocked as exc:
        emit_err(
            "error: message blocked locally — %s. "
            "Rephrase without card numbers, SSNs, or other sensitive "
            "identifiers and retry. Nothing was sent." % "; ".join(exc.findings)
        )
        return 4
    except KeyboardInterrupt:
        emit_err("interrupted.")
        return 130
    except BrokenPipeError:
        return 0
    except Exception as exc:  # noqa: BLE001 - last resort, still redacted
        emit_err("error: unexpected failure: %s" % redact(exc))
        return 1


if __name__ == "__main__":
    sys.exit(main())

def cmd_setup(args, transport):
    profile = args.profile
    cfg = load_config(profile)
    server = (
        args.server
        or os.environ.get("FAMILY_HUB_URL")
        or cfg.get("server_url")
        or input("Hub server URL (https://…): ").strip()
    )
    if not server:
        raise HubError("bad_request", "A server URL is required.")
    _validate_server_url(server)
    if cfg.get("server_url") and cfg["server_url"].rstrip("/") != server.rstrip("/"):
        raise HubError("config", "This profile belongs to another server; use a separate --profile.")

    store = "file"
    # Validate private persistence before consuming a one-use enrollment code.
    _probe_profile_writable(profile)

    code = args.invite or getpass.getpass("Invite or provisioning code: ").strip()
    if not code:
        raise HubError("bad_request", "An invite or provisioning code is required.")
    note_secret(code)  # bearer code: keep it out of --debug URL dumps etc.
    _key_priv, _key_pub_b64, _key_is_new = _ensure_identity_keypair(profile)
    if getattr(args, "recover_email", None):
        display_name = ""
        agent_label = args.label or "muse-agent"
        accept_path = "/v2/identity/agents"
        accept_body = {"email": args.recover_email.strip().lower(), "agent_label": agent_label, "agent_public_key": _key_pub_b64}
    elif code.startswith("fhp_"):
        # Owner bootstrap flow: the member already exists; the provisioning
        # code mints this agent's token directly (label set at bootstrap).
        accept_path = "/v2/provisioning-codes/%s/redeem" % urlparse.quote(code, safe="")
        accept_body = {}
        display_name = ""
        agent_label = "owner-agent"
        # E2EE (Phase 1): every agent gets an identity keypair at
        # enrollment. Generate + persist BEFORE the single-use code is
        # redeemed — a storage failure here must not burn the code (F11).
        # The public key rides along in the redeem body; the server binds it
        # to the same (member_id, agent_label) atomically with the token.
        accept_body["agent_public_key"] = _key_pub_b64
    else:
        display_name = args.name or input("Your display name: ").strip()
        if not display_name:
            raise HubError("bad_request", "A display name is required.")
        default_label = "%s-agent" % socket.gethostname().split(".")[0]
        agent_label = args.label or input(
            "Agent label [%s]: " % default_label
        ).strip() or default_label
        accept_path = "/v2/invites/%s/accept" % urlparse.quote(code, safe="")
        accept_body = {"display_name": display_name, "agent_label": agent_label,
                       "agent_public_key": _key_pub_b64}

    resp = _enrollment_call(server, transport, args.debug, profile, accept_path, accept_body, getattr(args, "verification_code_file", None))
    token = resp["token"]
    member = resp["member"]
    note_secret(token)  # from here on, the token can never appear in output

    agent_label = resp.get("agent_label") or agent_label
    new_cfg = dict(cfg)
    new_cfg.update({
        "server_url": server.rstrip("/"),
        "member": {
            "id": member.get("id"),
            "name": member.get("name", display_name),
            "role": member.get("role"),
            "email": member.get("email"),
        },
        "family_id": member.get("family_id"),
        "agent_label": agent_label,
        "token_id": resp.get("token_id"),
        "auth_method": store,
        "user": resp.get("user"),
        "agent": resp.get("agent"),
    })
    cid = member.get("family_id")
    if cid:
        new_cfg.setdefault("circle_members", {})[cid] = new_cfg["member"]
        new_cfg["active_circle_id"] = cid
    token_file = default_token_path(profile)
    diagnostic("credential_save_started", flow="setup")
    _write_secret_file_0600(token_file, (token + "\n").encode("utf-8"), "credential")
    diagnostic("credential_file_saved", flow="setup")
    new_cfg["token_file"] = token_file
    storage_note = "Stored in a private 0600 file at %s. Protect this machine user account." % token_file
    save_config(profile, new_cfg)
    diagnostic("credential_config_saved", flow="setup")
    # F11: the new credential is only real if the server accepts it —
    # verify before declaring success.
    diagnostic("credential_verification_started", flow="setup")
    _verify_new_token(server, transport, args.debug, token, "setup", cid)
    diagnostic("credential_verified", flow="setup")
    _complete_enrollment(profile)
    # save_config scrubs tokens; assert nothing secret-bearing was written.
    emit("setup complete.")
    emit_json(
        {
            "profile": profile,
            "server": new_cfg["server_url"],
            "member": new_cfg["member"],
            "agent_label": agent_label,
            "auth": store,
            "note": storage_note,
        }
    )
    if _key_is_new:
        _print_recovery_phrase(_key_priv, profile)
    return 0


def _key_init_register(ctx):
    """Ensure an identity keypair exists locally and is registered server-side.

    Returns (priv_bytes, public_b64, is_new). Works as the initial
    registration when the agent has no key yet, and as a no-op when the
    local key is already registered. The Bearer <redacted> is the bootstrap:
    it authenticates WHO the agent is while the keypair becomes WHAT the
    agent can decrypt. Shared by `hub key-init` and the recovery ladder
    (rung 2).
    """
    _require_nacl()
    priv, pub_b64, is_new = _ensure_identity_keypair(ctx.profile)
    if is_new:
        _print_recovery_phrase(priv, ctx.profile)
    me = ctx.client.call("GET", "/v2/me")
    if not isinstance(me, dict) or not me.get("id"):
        raise HubError("error", "Unexpected /v2/me response from the server.")
    member_id = me["id"]
    agent_label = me.get("agent_label") or ""
    directory = ctx.client.call("GET", "/v2/agent-keys", query={"member_id": member_id})
    for entry in _as_list(directory, "keys"):
        if (
            isinstance(entry, dict)
            and entry.get("agent_label") == agent_label
            and entry.get("public_key") == pub_b64
        ):
            emit("E2EE identity key is already registered for this agent — nothing to do.")
            return priv, pub_b64, is_new
    resp = ctx.client.call(
        "POST", "/v2/agent-keys/rotate", json_body={"agent_public_key": pub_b64}
    )
    if not isinstance(resp, dict) or "public_key" not in resp:
        raise HubError("error", "Unexpected response from the server.")
    emit("E2EE identity key registered.")
    emit_json(
        {
            "member_id": resp.get("member_id"),
            "agent_label": resp.get("agent_label"),
            "created_at": resp.get("created_at"),
        }
    )
    return priv, pub_b64, is_new


def cmd_key_init(args, transport):
    """Generate (if needed) and register this agent's E2EE identity key.

    Works as the initial registration when the agent has no key yet, and
    as a no-op when the local key is already registered. The Bearer <redacted>
    is the bootstrap: it authenticates WHO the agent is while the keypair
    becomes WHAT the agent can decrypt.
    """
    ctx = _ctx(args, transport)
    _key_init_register(ctx)
    return 0



def cmd_key_backup(args, transport):
    """Write an Argon2id-encrypted backup of the identity private key.

    The password never leaves the machine; the backup file is 0600. Keep
    the file somewhere other than this machine (or the recovery phrase
    somewhere safe) — either one restores the key via `hub key-restore`.
    """
    _require_nacl()
    profile = args.profile
    priv = _load_identity_key(agent_key_path(profile))
    out = (args.out or "").strip() or input("Backup file path: ").strip()
    if not out:
        raise HubError("bad_request", "A backup file path is required.")
    if os.path.exists(out) and not args.force:
        raise HubError(
            "bad_request",
            "Refusing to overwrite existing file %s (use --force to overwrite)." % out,
        )
    pw1 = getpass.getpass("Backup password: ")
    pw2 = getpass.getpass("Confirm backup password: ")
    note_secret(pw1)
    note_secret(pw2)
    if pw1 != pw2:
        raise HubError("bad_request", "Passwords do not match — backup not written.")
    if len(pw1) < 8:
        raise HubError("bad_request", "Password must be at least 8 characters.")
    blob = _encrypt_key_backup(priv, pw1)
    _write_secret_file_0600(out, json.dumps(blob, indent=2).encode("utf-8"), "backup")
    emit("Backup written to %s (mode 0600). Keep it somewhere safe." % out)
    return 0


def cmd_key_restore(args, transport):
    """Restore the identity private key from a recovery phrase or backup file.

    The phrase is never taken on the command line (it would land in shell
    history): paste it at the prompt or pass --phrase-file. Restoring does
    not register anything — run `hub key-init` afterwards; it is idempotent
    and registers the key only if needed.
    """
    _require_nacl()
    profile = args.profile
    key_path = agent_key_path(profile)
    if os.path.exists(key_path) and not args.force:
        raise HubError(
            "bad_request",
            "An identity key already exists at %s (use --force to overwrite "
            "it — the current key will be unrecoverable without its own "
            "backup)." % key_path,
        )
    if args.backup_file:
        try:
            with open(args.backup_file, "r", encoding="utf-8") as fh:
                blob = json.load(fh)
        except (OSError, ValueError) as exc:
            raise HubError("bad_request", "Cannot read backup file: %s" % exc)
        password = getpass.getpass("Backup password: ")
        note_secret(password)
        priv = _decrypt_key_backup(blob, password)
    else:
        if args.phrase_file:
            try:
                with open(args.phrase_file, "r", encoding="utf-8") as fh:
                    phrase = fh.read()
            except OSError as exc:
                raise HubError("bad_request", "Cannot read phrase file: %s" % exc)
        else:
            phrase = getpass.getpass("Recovery phrase (24 words): ")
        note_secret(phrase)
        priv = _privkey_from_phrase(phrase)
    _note_key_secrets(priv)
    _write_secret_file_0600(key_path, priv, "identity private key")
    emit("Identity key restored to %s (mode 0600)." % key_path)
    emit("Run `hub key-init` to register its public key with the hub.")
    return 0


_SYNC_TOPICS_MAX_PAGES = 10  # safety cap while following server paging



def _sync_topics_pages(client, limit):
    """GET /v2/sync/topics, following page_token.

    Returns (topics, versions): the topic list, plus the server's
    update-advertisement stanza from the first page (`versions` with
    server/cli/skill, or {} when the server predates it).

    Each topic carries topic_id, circle_id, circle_name, subject, kind,
    e2ee, acked_seq, latest_seq, new_count, last_activity_ts, last_actor,
    key_status (ok|pending) and assigned_to_me (spec §1.4).
    """
    topics = []
    versions = {}
    page_token = None
    for _ in range(_SYNC_TOPICS_MAX_PAGES):
        query = {"limit": limit}
        if page_token:
            query["page_token"] = page_token
        resp = client.call("GET", "/v2/sync/topics", query=query)
        if not versions and isinstance(resp, dict):
            v = resp.get("versions")
            if isinstance(v, dict):
                versions = v
        topics.extend(
            t for t in _as_list(resp, "topics") if isinstance(t, dict)
        )
        # Paging: accept the documented `page_token` or a
        # `next_page_token` alias; stop when the server sends neither or
        # reports no more pages.
        nxt = None
        if isinstance(resp, dict):
            nxt = resp.get("page_token") or resp.get("next_page_token")
            if not resp.get("has_more", True):
                nxt = None
        if not nxt:
            break
        page_token = nxt
    return topics, versions


def _emit_sync_topics(client, limit, circle_id, circle_name, profile="default"):
    """Emit one target's changed topics; HubErrors propagate to main()."""
    labeled = []
    topics, versions = _sync_topics_pages(client, limit)
    _decrypt_topic_subjects(profile, topics, client)
    for t in topics:
        t = dict(t)
        t["circle_id"] = circle_id
        t["circle_name"] = circle_name or circle_id
        labeled.append(t)
    emit_json(labeled)
    if not labeled:
        emit_err("no changed topics")
    _maybe_nudge_updates(versions)
    return 0


def _safe_is_newer(candidate, current):
    """_is_newer that returns False (never raises) on unparseable input."""
    try:
        return _is_newer(candidate, current)
    except HubError:
        return False


def _maybe_nudge_updates(versions):
    """stderr nudge when the server advertises newer CLI/skill releases.

    Best-effort only: never raises, never changes the sync result or exit
    code. Servers predating the advertisement omit `versions`; garbage
    values are ignored. The agent running the watcher sees stderr, so the
    nudge reaches whoever needs to run `hub upgrade`.
    """
    try:
        if not isinstance(versions, dict):
            return
        adv_cli = versions.get("cli")
        if isinstance(adv_cli, str) and adv_cli and _safe_is_newer(adv_cli, VERSION):
            emit_err(
                "Update available: CLI %s (installed %s). Run `hub upgrade`."
                % (adv_cli, VERSION)
            )
        adv_skill = versions.get("skill")
        if (
            isinstance(adv_skill, str)
            and adv_skill
            and _safe_is_newer(adv_skill, SKILL_VERSION)
        ):
            emit_err(
                "Update available: skill %s (installed %s). "
                "Run `hub upgrade` to refresh the skill docs."
                % (adv_skill, SKILL_VERSION)
            )
    except Exception:
        # Best-effort nudge: never break the sync for it. (return, not
        # pass: bandit B110 flags try/except/pass.)
        return


def cmd_sync(args, transport):
    """Changed-topic discovery: one scoped GET /v2/sync/topics per active membership.

    Stateless — read state lives server-side per agent (topic_read_state),
    so there are no client cursors to maintain. The first run after the
    first read reports all visible unread topics; the skill dedupes. Each emitted topic carries its circle (circle_id /
    circle_name); the skill then drives per-topic `hub read` / `hub ack`.
    One circle failing never loses the others' topics (a retry re-delivers;
    nothing local moved), but the exit code is non-zero and names the
    failed circle.
    """
    ctx = _ctx(args, transport)
    circles = _profile_circles(ctx)
    targets = [(circle["id"], ctx.client.token) for circle in circles]
    names = {circle["id"]: circle.get("name") for circle in circles}
    all_topics = []
    errors = []  # (circle_name, message): per-circle partial results
    adv_versions = {}  # update advertisement: first non-empty wins
    for cid, tok in targets:
        client = HubClient(ctx.server, tok, debug=ctx.client.debug,
                           transport=transport, circle_id=cid)
        try:
            topics, versions = _sync_topics_pages(client, args.limit)
            _decrypt_topic_subjects(ctx.profile, topics, client)
        except HubError as exc:
            errors.append((names.get(cid, cid), exc.friendly()))
            continue
        if not adv_versions and versions:
            adv_versions = versions
        for t in topics:
            t = dict(t)
            t["circle_id"] = cid
            t["circle_name"] = names.get(cid, cid)
            all_topics.append(t)
    emit_json(all_topics)
    if not all_topics:
        emit_err("no changed topics")
    for circle_name, msg in errors:
        emit_err("sync failed for circle %r: %s" % (circle_name, msg))
    _maybe_nudge_updates(adv_versions)
    return 1 if errors else 0


def cmd_topics(args, transport):
    ctx = _ctx(args, transport)
    query = {"limit": args.limit}
    resp = ctx.client.call("GET", "/v2/topics", query=query)
    topics = _as_list(resp, "topics")
    _decrypt_topic_subjects(ctx.profile, topics, ctx.client)
    if args.search:
        topics = [t for t in topics if args.search.casefold() in t.get("subject", "").casefold()]
    emit_json(topics)
    return 0


def _resolve_circle_soft(args, ctx):
    """Circle for read/ack: --circle wins (retargets the client to that
    circle context); otherwise the profile's active circle id, or None when
    the profile names none (bare single-token setups keep working with the
    already-resolved client — the initial registration circle).
    """
    if getattr(args, "circle", None):
        return _resolve_circle(args, ctx)
    return _active_circle_id(ctx.cfg)


def cmd_read(args, transport):
    """Read a topic's history, surfacing the server's read position.

    --after omitted: the server defaults to this agent's acked position, so
    the response covers exactly the unread range (spec §1.5). The output
    always carries read_through_seq and read_receipt (bound to
    member/agent/topic/from_seq/through_seq) — pass both to `hub ack`
    together, after the entries are handled. Never ack before the read is
    fully processed: acks are contiguous and receipt-bound.
    """
    ctx = _ctx(args, transport)
    circle_id = _resolve_circle_soft(args, ctx)
    query = {"limit": args.limit}
    if args.after is not None:
        query["after_seq"] = args.after
    if args.context is not None:
        query["context"] = args.context
    resp = ctx.client.call(
        "GET",
        "/v2/topics/%s/history" % urlparse.quote(str(args.topic), safe=""),
        query=query,
    )
    resp = resp if isinstance(resp, dict) else {}
    entries = _as_list(resp, "entries")
    _decrypt_entries_for_display(ctx.client, ctx.profile, entries)
    emit_json(
        {
            "topic_id": str(args.topic),
            "circle_id": circle_id,
            "entries": entries,
            "read_through_seq": resp.get("read_through_seq"),
            "read_receipt": resp.get("read_receipt"),
        }
    )
    return 0


def cmd_ack(args, transport):
    """Acknowledge read-through-seq on a topic (receipt-bound, contiguous).

    Both --seq and --receipt are REQUIRED — taken together from a single
    `hub read` response. There is no "ack everything" mode and no default:
    ack exactly what was read, in order (the server 409s noncontiguous
    acks). Never ack before the entries are fully handled (posted /
    reported) — an ack is the delivery confirmation.
    """
    ctx = _ctx(args, transport)
    circle_id = _resolve_circle_soft(args, ctx)
    seq = args.seq
    receipt = (args.receipt or "").strip()
    # argparse required=True already rejects missing flags; guard empties
    # and nonsense here with a message that teaches the pairing rule.
    if seq is None or not receipt:
        raise HubError(
            "bad_request",
            "`hub ack` requires BOTH --seq and --receipt, taken together "
            "from one `hub read` response (read_through_seq + read_receipt). "
            "There is no 'ack everything' mode: ack exactly what you read, "
            "in order. Nothing was acknowledged.",
        )
    if seq < 0:
        raise HubError("bad_request", "--seq must be >= 0 (got %d)." % seq)
    resp = ctx.client.call(
        "POST",
        "/v2/topics/%s/ack" % urlparse.quote(str(args.topic), safe=""),
        json_body={"seq": seq, "read_receipt": receipt},
    )
    emit_json(resp if isinstance(resp, dict) else {"ok": True})
    return 0


def cmd_post(args, transport):
    ctx = _ctx(args, transport)
    message = _message_text(args)
    # Local checks first: the PII pre-scan and --data parsing happen before
    # anything hits the wire (a refusal sends nothing).
    check_pii(message)
    data = None
    if args.data:
        try:
            data = json.loads(args.data)
        except ValueError:
            raise HubError("bad_request", "--data must be valid JSON.")
    # One topic-record fetch per post (O(1)): routes E2EE topics to the
    # encrypting path. The plaintext construction below is byte-identical
    # to the pre-E2EE behavior.
    topic = _fetch_topic_record(ctx.client, args.topic)
    return _cmd_post_e2ee(args, ctx, topic, message, data)


def _new_topic_id():
    return uuid.uuid4().hex


def _create_encrypted_topic(args, ctx, members, parent=None, briefing=None):
    _require_nacl()
    _load_identity_key(agent_key_path(ctx.profile))
    if len(args.subject) > _E2EE_SUBJECT_PLAINTEXT_MAX:
        raise HubError("bad_request", "Topic subjects are limited to 200 characters.")
    identity = json.dumps([ctx.server, _active_circle_id(ctx.cfg), args.subject,
                           sorted(members), getattr(args, "kind", "group"),
                           bool(getattr(args, "parents_only", False)), parent, briefing], sort_keys=True)
    # The pending intent is stable across process restarts, and contains no
    # readable subject/briefing. Successful creates remove the intent.
    intent_id = hashlib.sha256(identity.encode("utf-8")).hexdigest()
    path = os.path.join(profile_dir(ctx.profile), "pending-topics", intent_id + ".json")
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as fh:
                pending = json.load(fh)
        except (OSError, ValueError) as exc:
            raise HubError("config", "Cannot resume pending topic: %s" % exc)
    else:
        tid = _new_topic_id()
        kid = os.urandom(_E2EE_KEY_ID_BYTES).hex()
        key = os.urandom(_E2EE_TOPIC_KEY_BYTES)
        _store_topic_key(ctx.profile, tid, kid, key)
        subject = _e2ee_encrypt_field(args.subject.encode("utf-8"), tid, kid, key)
        pending = {"topic_id": tid, "subject": subject,
                   "kind": getattr(args, "kind", "group"),
                   "participant_member_ids": members,
                   "parents_only": bool(getattr(args, "parents_only", False))}
        if parent:
            pending["link_visibility"] = args.link_visibility
        _write_secret_file_0600(path, json.dumps(pending).encode("utf-8"), "pending topic")
    tid = pending["topic_id"]
    route = "/v2/topics" if not parent else "/v2/topics/%s/spawn" % urlparse.quote(parent, safe="")
    response = ctx.client.call("POST", route, json_body=pending, idempotency_key=tid)
    topic = response.get("topic") if isinstance(response, dict) else None
    if not isinstance(topic, dict) or topic.get("id") != tid:
        raise HubError("error", "Server returned a different topic operation; nothing was posted.")
    if not topic.get("current_epoch"):
        keys = _load_topic_keys(ctx.profile, tid)
        header = _e2ee_parse_wire(pending["subject"], "topic subject")
        kid = header[0]
        key = keys.get(kid)
        if key is None:
            raise HubError("config", "Pending topic key missing; recover it before resuming.")
        try:
            result = _run_staged_key_commit(ctx, tid, 1, kid, key, "genesis")
        except HubError:
            emit_err("Topic setup paused. Retry the same create command, or run hub topic-rekey --topic %s. The pending key is saved locally." % tid)
            raise
        _store_topic_key(ctx.profile, tid, result[1], result[2])
        topic = _fetch_topic_record(ctx.client, tid)
    if briefing is not None:
        kid, key = _e2ee_current_key(ctx.profile, tid, ctx, topic)
        # Persist the exact ciphertext so a retry cannot duplicate a briefing.
        brief_path = path + ".briefing"
        sealed = None
        if os.path.exists(brief_path):
            with open(brief_path, encoding="utf-8") as fh:
                sealed = fh.read()
            if _e2ee_parse_wire(sealed, "pending briefing")[0] != kid:
                sealed = None
        if sealed is None:
            sealed = _e2ee_encrypt_field(briefing.encode("utf-8"), tid, kid, key)
            _write_secret_file_0600(brief_path, sealed.encode("utf-8"), "pending briefing")
        ctx.client.call("POST", "/v2/topics/%s/entries" % tid,
                        json_body={"kind": "briefing", "body": sealed},
                        idempotency_key=tid + "-briefing")
        os.unlink(brief_path)
    os.unlink(path)
    emit_json({"topic": topic, "encrypted": True, "parent_topic_id": parent})
    return 0


def cmd_new_topic(args, transport):
    ctx = _ctx(args, transport)
    check_pii(args.subject)
    members = _id_list(args.with_)

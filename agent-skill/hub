def _wrap_setup(args, transport):
    # `setup` uses its own --server flag name to avoid clashing with the
    # global one; normalize here.
    if getattr(args, "setup_server", None):
        args.server = args.setup_server
    return cmd_setup(args, transport)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

# Commands that never touch the server: exempt from the per-invocation
# server-version check. They must work with no server configured (offline
# key management, install verification, rollback) — and because they make
# no requests, skipping the check cannot mask a version mismatch.
# --version/--help exit inside argparse, before main() runs.
_LOCAL_COMMANDS = frozenset(
    {
        cmd_key_wrap,
        cmd_key_backup,
        cmd_key_restore,
        cmd_verify_install,
        cmd_rollback,
    }
)


def main(argv=None, transport=None):
    clear_secrets()
    args = build_parser().parse_args(argv)
    # Startup self-integrity check (WS-E). verify-install is exempt from
    # the hard refusal so it can diagnose a mismatch itself (it re-runs
    # the full check and reports exactly which step failed).
    if getattr(args, "func", None) is not cmd_verify_install:
        if not _startup_integrity_check():
            return EXIT_TAMPERED
    try:
        # Server version contract (§4.2): fail before any command when the
        # server is too old. Local-only commands are exempt.
        if getattr(args, "func", None) not in _LOCAL_COMMANDS:
            _require_server_version(args, transport)
        return args.func(args, transport)
    except HubError as exc:
        emit_err("error: " + exc.friendly())
        return exc.exit_code
    except PIIBlocked as exc:
        emit_err(
            "error: message blocked locally — %s. "
            "Rephrase without card numbers, SSNs, or other sensitive "
            "identifiers and retry. Nothing was sent." % "; ".join(exc.findings)
        )
        return 4
    except KeyboardInterrupt:
        emit_err("interrupted.")
        return 130
    except BrokenPipeError:
        return 0
    except Exception as exc:  # noqa: BLE001 - last resort, still redacted
        emit_err("error: unexpected failure: %s" % redact(exc))
        return 1


if __name__ == "__main__":
    sys.exit(main())

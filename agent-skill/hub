def _script_dir():
    """Directory containing the `hub` script itself."""
    return os.path.dirname(os.path.abspath(__file__))


def _read_toml_version():
    """Version from the `pyproject.toml` next to the script, or None."""
    try:
        with open(
            os.path.join(_script_dir(), "pyproject.toml"), "r", encoding="utf-8"
        ) as f:
            toml_text = f.read()
    except OSError:
        return None
    match = re.search(r'^version\s*=\s*"([^"]+)"', toml_text, re.M)
    return match.group(1) if match else None


def _installed_version():
    """Installed `family-hub-cli` package version, or None when the CLI was
    not installed via pip (single-file / dev checkout)."""
    try:
        from importlib import metadata

        return metadata.version("family-hub-cli")
    except Exception:  # noqa: BLE001 -- expected outside pip installs
        return None


# Set at release-build time by .github/workflows/release.yml. A released
# single-file artifact has no adjacent pyproject.toml and no pip metadata,
# so the build stamps the version here. pyproject.toml remains the single
# source of truth; the stamp is derived from it at build time.
_BUILD_VERSION = None


def _cli_version():
    """CLI version, read from the single source of truth (contract C6).

    `agent-skill/pyproject.toml` owns the version. A release-stamped build
    reports its stamp; when installed as the `family-hub-cli` package,
    installed metadata wins; otherwise the TOML next to the script is read
    (dev checkout / single-file install).
    "0.0.0-dev" only when none is available.
    """
    if _BUILD_VERSION:
        return _BUILD_VERSION
    return _installed_version() or _read_toml_version() or "0.0.0-dev"


def _skill_version():
    """Skill version from the `<!-- SKILL VERSION: x.y.z -->` header of
    SKILL.md next to the script. Versioned INDEPENDENTLY of the CLI (see
    docs/VERSIONING.md): skill-only doc changes cut skill-v* releases
    without a CLI bump. "unknown" only when the header or the file is
    missing (dev checkout)."""
    try:
        with open(
            os.path.join(_script_dir(), "SKILL.md"), "r", encoding="utf-8"
        ) as f:
            head = f.read(2048)
    except OSError:
        return "unknown"
    match = re.search(r"<!--\s*SKILL VERSION:\s*([0-9A-Za-z.\-+]+)\s*-->", head)
    return match.group(1) if match else "unknown"



def _resolve_circle_soft(args, ctx):
    """Circle for read/ack: --circle wins (retargets the client to that
    circle's token); otherwise the profile's active circle id, or None when
    the profile names none (bare single-token setups keep working with the
    already-resolved client — the old read behavior).
    """
    if getattr(args, "circle", None):
        return _resolve_circle(args, ctx)
    return _active_circle_id(ctx.cfg)


def cmd_read(args, transport):
    """Read a topic's history, surfacing the server's read position.

    --after omitted: the server defaults to this agent's acked position, so
    the response covers exactly the unread range (spec §1.5). The output
    always carries read_through_seq and read_receipt (bound to
    member/agent/topic/from_seq/through_seq) — pass both to `hub ack`
    together, after the entries are handled. Never ack before the read is
    fully processed: acks are contiguous and receipt-bound.
    """
    ctx = _ctx(args, transport)
    circle_id = _resolve_circle_soft(args, ctx)
    query = {"limit": args.limit}
    if args.after is not None:
        query["after_seq"] = args.after
    if args.context is not None:
        query["context"] = args.context
    resp = ctx.client.call(
        "GET",
        "/v1/topics/%s/history" % urlparse.quote(str(args.topic), safe=""),
        query=query,
    )
    resp = resp if isinstance(resp, dict) else {}
    entries = _as_list(resp, "entries")
    _decrypt_entries_for_display(ctx.client, ctx.profile, entries)
    emit_json(
        {
            "topic_id": str(args.topic),
            "circle_id": circle_id,
            "entries": entries,
            "read_through_seq": resp.get("read_through_seq"),
            "read_receipt": resp.get("read_receipt"),
        }
    )
    return 0


def cmd_ack(args, transport):
    """Acknowledge read-through-seq on a topic (receipt-bound, contiguous).

    Both --seq and --receipt are REQUIRED — taken together from a single
    `hub read` response. There is no "ack everything" mode and no default:
    ack exactly what was read, in order (the server 409s noncontiguous
    acks). Never ack before the entries are fully handled (posted /
    reported) — an ack is the delivery confirmation.
    """
    ctx = _ctx(args, transport)
    circle_id = _resolve_circle_soft(args, ctx)
    seq = args.seq
    receipt = (args.receipt or "").strip()
    # argparse required=True already rejects missing flags; guard empties
    # and nonsense here with a message that teaches the pairing rule.
    if seq is None or not receipt:
        raise HubError(
            "bad_request",
            "`hub ack` requires BOTH --seq and --receipt, taken together "
            "from one `hub read` response (read_through_seq + read_receipt). "
            "There is no 'ack everything' mode: ack exactly what you read, "
            "in order. Nothing was acknowledged.",
        )
    if seq < 0:
        raise HubError("bad_request", "--seq must be >= 0 (got %d)." % seq)
    resp = ctx.client.call(
        "POST",
        "/v1/topics/%s/ack" % urlparse.quote(str(args.topic), safe=""),
        json_body={"seq": seq, "read_receipt": receipt},
    )
    emit_json(resp if isinstance(resp, dict) else {"ok": True})
    return 0


def cmd_post(args, transport):
    ctx = _ctx(args, transport)
    message = _message_text(args)
    # Local checks first: the PII pre-scan and --data parsing happen before
    # anything hits the wire (a refusal sends nothing).
    check_pii(message)
    data = None
    if args.data:
        try:
            data = json.loads(args.data)
        except ValueError:
            raise HubError("bad_request", "--data must be valid JSON.")
    # One topic-record fetch per post (O(1)): routes E2EE topics to the
    # encrypting path. The plaintext construction below is byte-identical
    # to the pre-E2EE behavior.
    topic = _fetch_topic_record(ctx.client, args.topic)
    if args.kind in _E2EE_SYSTEM_KINDS:
        # E2EE system entries (key_rotated / key_request /
        # pending_key_distribution / topic_archived): plaintext by design, never encrypted —
        # they must be readable by agents that don't hold the topic key.
        entry = _post_system_entry(ctx, topic, args.kind, message, data)
        emit_json({"entry": entry})
        return 0
    if topic.get("e2ee") == 1:
        return _cmd_post_e2ee(args, ctx, topic, message, data)
    body = {"kind": args.kind, "body": message}
    if args.reply_to is not None:
        body["reply_to_seq"] = args.reply_to
    if args.data:
        body["data"] = data
    key = args.idempotency_key or uuid.uuid4().hex
    entry = ctx.client.call(
        "POST",
        "/v1/topics/%s/entries" % urlparse.quote(args.topic, safe=""),
        json_body=body,
        idempotency_key=key,
    )
    emit_json({"idempotency_key": key, "entry": entry})
    return 0


def _cmd_new_topic_e2ee(args, ctx, members):
    """Create an E2EE topic: staged genesis (spec §1.4 / §2).

    1. The identity keypair must already exist — _load_identity_key fails
       with `hub key-init` guidance when it doesn't. Never auto-generated
       here.
    2. Generate the 32-byte topic key + random 128-bit key_id locally.
    3. Encrypt the subject (XChaCha20-Poly1305, nonce prepended, base64) and
       POST the topic with e2ee=1. The v2 server leaves the topic at
       epoch 0 with writes blocked (409 key_not_active): there is no
       initial_key_id anymore — activation happens only via keys/commit
       (the N04 flip-on-POST is gone).
    4. Re-encrypt the subject with the topic-bound AAD (now that the
       server-generated topic id is known) and PATCH it immediately. The
       subject PATCH is topic metadata, not a content write, so it is not
       gated by the epoch-0 write block; it runs before any envelope is
       distributed or any key stored locally.
    5. Persist the key locally (0600) BEFORE the commit attempt
       (crash-recovery anchor): if this process dies mid-ceremony, `hub
       topic-rekey --topic <id>` completes the genesis from the stored key
       (spec §4). Overwritten with the final committed material on success.
    6. Seal one envelope per participant agent (staged — stored, never
       flipped) and POST keys/commit with expected_epoch=1, via the shared
       _run_staged_key_commit (spec §1.4 409 handling).
    7. Post nothing else: the topic creation itself is the notice.

    Staged envelopes are invisible via GET until commit, so there is no
    round-trip envelope check (the committer holds the key locally); the
    commit response {topic_id, epoch, key_id} is the confirmation.

    The topic key never leaves the machine except inside sealed envelopes
    and is registered with note_secret() so it can never reach
    stdout/stderr.
    """
    _require_nacl()
    profile = ctx.profile
    # Proves the identity key exists (with `hub key-init` guidance when it
    # does not); the private key itself is not needed below — envelopes are
    # sealed to the RECIPIENTS' public keys.
    _load_identity_key(agent_key_path(profile))

    subject = args.subject
    if len(subject) > _E2EE_SUBJECT_PLAINTEXT_MAX:
        raise HubError(
            "bad_request",
            "--e2ee subjects are limited to %d chars of plaintext (same as plaintext topics)."
            % _E2EE_SUBJECT_PLAINTEXT_MAX,
        )

    topic_key = os.urandom(_E2EE_TOPIC_KEY_BYTES)
    _note_topic_key_secrets(topic_key)
    key_id_bytes = os.urandom(_E2EE_KEY_ID_BYTES)
    key_id_hex = key_id_bytes.hex()
    # Provisional subject: the topic id is server-generated and not known
    # yet, so it cannot be bound into the AAD at create time. This blob is
    # replaced by the topic-bound PATCH in step 4, before any envelope is
    # distributed or any key is stored locally.
    enc_subject = _e2ee_encrypt_subject(subject, topic_key)

    topic = ctx.client.call(
        "POST",
        "/v1/topics",
        json_body={
            "subject": enc_subject,
            "kind": args.kind,
            "participant_member_ids": members,
            "parents_only": bool(args.parents_only),
            "e2ee": 1,
        },
    )
    if not isinstance(topic, dict) or not isinstance(topic.get("topic"), dict):
        raise HubError("error", "Unexpected response from the server creating the topic.")
    # NOTE: a deduped retry of this POST (same process, same idempotency
    # key) returns the already-created topic with the SAME request body, so
    # the in-memory topic_key still matches the stored subject ciphertext.
    topic_id = topic["topic"].get("id")
    if not topic_id:
        raise HubError("error", "Server did not return a topic id.")
    topic_id = str(topic_id)
    quoted_tid = urlparse.quote(topic_id, safe="")

    # Bind topic_id into the subject AAD now that it is known. A failed
    # PATCH aborts loudly BEFORE any envelope is distributed or any key
    # stored locally — the topic is left at epoch 0 for the user to
    # delete/retry.
    bound_subject = _e2ee_encrypt_subject(subject, topic_key, topic_id)
    try:
        ctx.client.call(
            "PATCH",
            "/v1/topics/%s/subject" % quoted_tid,
            json_body={"subject": bound_subject},
        )
    except HubError as exc:
        raise HubError(
            "error",
            "Created E2EE topic %s but the topic-bound subject PATCH failed "
            "(%s). The topic key was NOT stored locally and no envelopes "
            "were distributed; the topic sits at epoch 0 (writes blocked) — "
            "delete it and retry once the cause is fixed." % (topic_id, exc),
        )

    # Crash-recovery anchor (spec §4): persist BEFORE the commit attempt so
    # a genesis crash is completable via `hub topic-rekey --topic <id>`.
    _store_topic_key(profile, topic_id, key_id_hex, topic_key)

    try:
        (resp, final_kid, final_key, _participants, posted, keyless,
         force_used) = _run_staged_key_commit(
            ctx, topic_id, 1, key_id_hex, topic_key,
            force_requested=bool(getattr(args, "force", False)),
            yes=bool(getattr(args, "yes", False)),
            what="genesis",
        )
    except HubError:
        emit_err(
            "note: topic %s exists at epoch 0 (writes blocked); the genesis "
            "key is stored locally — complete the ceremony with "
            "`hub topic-rekey --topic %s` once the cause is fixed."
            % (topic_id, topic_id)
        )
        raise

    # Overwrite the pre-commit anchor with the final committed material
    # (identical unless a burn forced regeneration inside the commit loop).
    key_path = _store_topic_key(profile, topic_id, final_kid, final_key)

    if keyless:
        emit_err(
            "warning: %d participant(s) have no registered agent keys and "
            "will see only ciphertext until they run `hub key-init` (their "
            "key_status is pending; use the key-request flow or re-run "
            "distribution once they have keys): %s"
            % (len(keyless), ", ".join(keyless))
        )
    epoch = resp.get("epoch") if isinstance(resp, dict) else None
    result = dict(topic)
    result["e2ee"] = {
        "key_id": final_kid,
        "epoch": epoch if isinstance(epoch, int) else 1,
        "commitment": hashlib.sha256(final_key).hexdigest(),
        "envelopes_posted": posted,
        "keyless_participants": keyless,
        "forced_commit": force_used,
        "topic_key_path": key_path,
    }
    emit_json(result)
    return 0



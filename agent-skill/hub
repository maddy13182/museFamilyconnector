import types


def _as_list(resp, key):
    """Tolerate {"key": [...]} or a bare [...] response."""
    if isinstance(resp, dict):
        val = resp.get(key, resp.get("items", []))
        return val if isinstance(val, list) else []
    return resp if isinstance(resp, list) else []


def _id_list(values):
    """Flatten ['a,b', 'c'] -> ['a', 'b', 'c']."""
    out = []
    for value in values or []:
        for part in str(value).split(","):
            part = part.strip()
            if part:
                out.append(part)
    return out


def _message_text(args, attr="message", file_attr="message_file"):
    if getattr(args, file_attr, None):
        path = getattr(args, file_attr)
        if path == "-":
            text = sys.stdin.read()
        else:
            with open(path, "r", encoding="utf-8") as fh:
                text = fh.read()
    else:
        text = getattr(args, attr, None)
    if not text or not text.strip():
        raise HubError("bad_request", "Message text is empty.")
    return text


# ---------------------------------------------------------------------------
# Per-circle tokens (v0.2.0): the server binds each bearer token to ONE
# circle, so the profile keeps circle_tokens {circle_id: token} in the 0600
# config. Every API call uses the active circle's token, falling back to
# the legacy single-token chain when a circle has no stored token.
# ---------------------------------------------------------------------------


def _token_for_circle(cfg, profile, circle_id):
    """Return (token, source) for a specific circle.

    circle_tokens[circle_id] wins. The legacy single-token chain is only a
    fallback for the bootstrap family it was minted for (cfg.family_id):
    the server binds every token to exactly one family and 404s cross-
    family calls, so sending the legacy token for any other circle would
    only produce a confusing failure. Anything else needs its own token
    via `hub circle join`.
    """
    circle_tokens = cfg.get("circle_tokens") or {}
    tok = circle_tokens.get(circle_id)
    if tok and str(tok).strip():
        tok = str(tok).strip()
        note_secret(tok)
        return tok, "circle-token"
    if circle_id and circle_id != cfg.get("family_id"):
        raise HubError(
            "auth",
            "No token stored for this circle. Run "
            "`hub circle join --code <invite code>` to join it.",
        )
    try:
        return load_token(cfg, profile)
    except HubError:
        if circle_id:
            raise HubError(
                "auth",
                "No token stored for this circle. Run "
                "`hub circle join --code <invite code>` to join it "
                "(or `hub setup` if this profile was never configured).",
            )
        raise


def _has_usable_token(cfg, profile, circle_id):
    """True when a call scoped to circle_id could authenticate.

    Side-effect free: checks existence, never reads or warns.
    """
    if (cfg.get("circle_tokens") or {}).get(circle_id):
        return True
    # Legacy single-token chain is only valid for the bootstrap family.
    if circle_id and circle_id == cfg.get("family_id"):
        if os.environ.get("FAMILY_HUB_TOKEN", "").strip():
            return True
        if cfg.get("vault_cmd") or os.environ.get("FAMILY_HUB_VAULT_CMD"):
            return True
        token_file = cfg.get("token_file") or default_token_path(profile)
        if os.path.exists(token_file):
            return True
    return False


def _member_for_circle(cfg, circle_id):
    """This agent's member record for a circle (per-circle id/role)."""
    cm = (cfg.get("circle_members") or {}).get(circle_id) or {}
    if cm.get("id"):
        return cm
    return cfg.get("member") or {}


def _ctx(args, transport, need_auth=True):
    profile = args.profile
    cfg = load_config(profile)
    pinned = cfg.get("server_url")
    server = args.server or os.environ.get("FAMILY_HUB_URL") or pinned
    if not server:
        raise HubError(
            "bad_request", "No server configured. Use --server or run `hub setup`."
        )
    # F03: the enrollment origin is pinned; a differing --server must be
    # explicit, and plain http is only for loopback.
    _check_server_override(args, pinned, server)
    _validate_server_url(server)
    token = None
    if need_auth:
        token, _source = _token_for_circle(cfg, profile, _active_circle_id(cfg))
    client = HubClient(server, token, debug=args.debug, transport=transport)
    return types.SimpleNamespace(
        profile=profile, cfg=cfg, server=server, client=client
    )


def _ctx_loose(args, transport):
    """Context for discovery commands (circles, use, dashboard-token).

    Tolerates a tokenless *active* circle: discovery works with any usable
    token, since GET /v1/families lists by human (email), not by token.
    Raises only when the profile has no credential at all.
    """
    ctx = _ctx(args, transport, need_auth=False)
    circle_tokens = ctx.cfg.get("circle_tokens") or {}
    for tok in circle_tokens.values():
        if tok and str(tok).strip():
            tok = str(tok).strip()
            note_secret(tok)
            ctx.client = HubClient(
                ctx.server, tok, debug=args.debug, transport=transport
            )
            return ctx
    token, _source = load_token(ctx.cfg, ctx.profile)
    ctx.client = HubClient(
        ctx.server, token, debug=args.debug, transport=transport
    )
    return ctx


def _retarget_client(ctx, args, circle_id):
    """Point ctx.client at another circle's token (for --circle overrides)."""
    try:
        token, _source = _token_for_circle(ctx.cfg, ctx.profile, circle_id)
    except HubError:
        raise HubError(
            "auth",
            "No token stored for circle %s. Run "
            "`hub circle join --code <invite code>` first." % circle_id,
        )
    ctx.client = HubClient(
        ctx.server, token, debug=ctx.client.debug,
        transport=ctx.client.transport,
    )
    return ctx


def _read_cursor(profile, circle_id=None):
    try:
        with open(cursor_path(profile, circle_id), "r", encoding="utf-8") as fh:
            return int(fh.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def _write_cursor(profile, value, circle_id=None):
    d = profile_dir(profile)
    os.makedirs(d, mode=0o700, exist_ok=True)
    with open(cursor_path(profile, circle_id), "w", encoding="utf-8") as fh:
        fh.write(str(int(value)))


# ---------------------------------------------------------------------------
# Circles (v0.2.0: a profile can belong to many circles; one is active)
# ---------------------------------------------------------------------------


def _active_circle_id(cfg):
    """Effective circle id: explicit active_circle_id, else legacy family_id."""
    return cfg.get("active_circle_id") or cfg.get("family_id")


def _list_circles(client):
    """GET /v1/families -> the circles this agent belongs to."""
    return _as_list(client.call("GET", "/v1/families"), "families")


def _match_circle(circles, spec):
    """Resolve a circle name or id/prefix to a circle id. Never guesses.

    Exact name match wins; otherwise an id prefix must match exactly one
    circle. Ambiguity or no match raises HubError listing the candidates.
    """
    by_name = [
        c for c in circles if isinstance(c, dict) and c.get("name") == spec
    ]
    if len(by_name) == 1:
        return by_name[0].get("id")
    if len(by_name) > 1:
        raise HubError(
            "bad_request",
            "Multiple circles named %r; use an id instead: %s"
            % (spec, ", ".join(str(c.get("id")) for c in by_name)),
        )
    by_id = [
        c
        for c in circles
        if isinstance(c, dict) and str(c.get("id") or "").startswith(spec)
    ]
    if len(by_id) == 1:
        return by_id[0].get("id")
    if len(by_id) > 1:
        raise HubError(
            "bad_request",
            "Ambiguous circle %r; matches: %s"
            % (
                spec,
                ", ".join(
                    "%s (%s)" % (c.get("id"), c.get("name")) for c in by_id
                ),
            ),
        )
    available = ", ".join(
        repr(c.get("name")) for c in circles if isinstance(c, dict)
    )
    raise HubError(
        "not_found",
        "No circle matches %r. Available: %s" % (spec, available or "(none)"),
    )


def _resolve_circle(args, ctx):
    """Central circle resolution for every command.

    `--circle <name-or-id>` wins; otherwise the profile's active circle
    (active_circle_id, falling back to legacy family_id). Raises HubError
    when nothing resolves — callers never see a bare None.

    An explicit --circle override also retargets the client to that
    circle's token: the flag switches BOTH the target and the credential.
    """
    override = getattr(args, "circle", None)
    if override:
        cid = _match_circle(_list_circles(ctx.client), override)
        _retarget_client(ctx, args, cid)
        return cid
    cid = _active_circle_id(ctx.cfg)
    if not cid:
        raise HubError(
            "config",
            "No active circle in this profile — run `hub circle use <name>` "
            "or re-run `hub setup` to refresh it.",
        )
    return cid



def _e2ee_encrypt_content_field(ctx, topic, topic_id, plaintext):
    """fh1-encrypt one content field under the topic's CURRENT key.

    Shared by the N05 write paths (task title/description, task notes,
    spawn briefings). `topic` is the pre-fetched topic record (avoids a
    second GET); the caller has already run check_pii on the plaintext —
    the server cannot scan ciphertext, so the CLI is the enforcement point.
    """
    _require_nacl()
    topic_id = str(topic_id)
    key_id_hex, topic_key = _e2ee_current_key(ctx.profile, topic_id, ctx, topic)
    return _e2ee_encrypt_field(
        plaintext.encode("utf-8"), topic_id, key_id_hex, topic_key
    )



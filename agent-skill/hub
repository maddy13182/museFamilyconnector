def cmd_setup(args, transport):
    profile = args.profile
    cfg = load_config(profile)
    server = (
        args.server
        or os.environ.get("FAMILY_HUB_URL")
        or cfg.get("server_url")
        or input("Hub server URL (https://…): ").strip()
    )
    if not server:
        raise HubError("bad_request", "A server URL is required.")
    _validate_server_url(server)

    store = args.store or "env"
    # F11: validate the credential sink BEFORE redeeming. The invite /
    # provisioning code is single-use: redeeming it and THEN failing to
    # persist the token would burn the code and leave the agent tokenless.
    vault_cmd = None
    if store == "file":
        _probe_profile_writable(profile)
    elif store == "vault-cmd":
        vault_cmd = (args.vault_cmd or "").strip() or input(
            "Vault helper command (stdout must be the token): "
        ).strip()
        if not vault_cmd:
            raise HubError("bad_request", "A vault helper command is required.")
        _validate_vault_cmd(vault_cmd)
    else:  # env
        _validate_env_sink()

    code = args.invite or getpass.getpass("Invite or provisioning code: ").strip()
    if not code:
        raise HubError("bad_request", "An invite or provisioning code is required.")
    note_secret(code)  # bearer code: keep it out of --debug URL dumps etc.
    _key_priv, _key_pub_b64, _key_is_new = None, None, False
    if code.startswith("fhp_"):
        # Owner bootstrap flow: the member already exists; the provisioning
        # code mints this agent's token directly (label set at bootstrap).
        accept_path = "/v1/provisioning-codes/%s/redeem" % urlparse.quote(code, safe="")
        accept_body = {}
        display_name = ""
        agent_label = "owner-agent"
        # E2EE (Phase 1): every agent gets an identity keypair at
        # enrollment. Generate + persist BEFORE the single-use code is
        # redeemed — a storage failure here must not burn the code (F11).
        # The public key rides along in the redeem body; the server binds it
        # to the same (member_id, agent_label) atomically with the token.
        _key_priv, _key_pub_b64, _key_is_new = _ensure_identity_keypair(profile)
        accept_body["agent_public_key"] = _key_pub_b64
    else:
        display_name = args.name or input("Your display name: ").strip()
        if not display_name:
            raise HubError("bad_request", "A display name is required.")
        default_label = "%s-agent" % socket.gethostname().split(".")[0]
        agent_label = args.label or input(
            "Agent label [%s]: " % default_label
        ).strip() or default_label
        accept_path = "/v1/invites/%s/accept" % urlparse.quote(code, safe="")
        accept_body = {"display_name": display_name, "agent_label": agent_label}

    client = HubClient(server, token=None, debug=args.debug, transport=transport)
    resp = client.call(
        "POST",
        accept_path,
        json_body=accept_body,
        auth=False,
    )
    if not isinstance(resp, dict) or "token" not in resp or "member" not in resp:
        raise HubError("error", "Unexpected response from the server.")
    token = resp["token"]
    member = resp["member"]
    note_secret(token)  # from here on, the token can never appear in output

    new_cfg = {
        "server_url": server.rstrip("/"),
        "member": {
            "id": member.get("id"),
            "name": member.get("name", display_name),
            "role": member.get("role"),
            "email": member.get("email"),
        },
        "family_id": member.get("family_id"),
        "agent_label": agent_label,
        "token_id": resp.get("token_id"),
        "auth_method": store,
    }
    if store == "file":
        token_file = default_token_path(profile)
        os.makedirs(profile_dir(profile), mode=0o700, exist_ok=True)
        fd = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(token + "\n")
        new_cfg["token_file"] = token_file
        storage_note = (
            "stored in a 0600 file at %s. Anyone with access to this "
            "machine user can read it." % token_file
        )
    elif store == "vault-cmd":
        new_cfg["vault_cmd"] = vault_cmd
        storage_note = (
            "resolved at runtime via your vault helper. The raw token is "
            "not stored anywhere by hub — make sure the token is actually "
            "saved in your vault under the path your helper reads, and "
            "test the helper before relying on it."
        )
    else:  # env
        storage_note = (
            "NOT stored by hub. Your agent harness must inject "
            "FAMILY_HUB_TOKEN from your Secure Vault each time it runs "
            "hub. The token was returned once by the server and will "
            "never be shown again."
        )
    save_config(profile, new_cfg)
    # F11: the new credential is only real if the server accepts it —
    # verify before declaring success.
    _verify_new_token(server, transport, args.debug, token, "setup")
    # save_config scrubs tokens; assert nothing secret-bearing was written.
    emit("setup complete.")
    emit_json(
        {
            "profile": profile,
            "server": new_cfg["server_url"],
            "member": new_cfg["member"],
            "agent_label": agent_label,
            "auth": store,
            "note": storage_note,
        }
    )
    if code.startswith("fhp_") and _key_is_new:
        # The identity keypair was just created: show the recovery phrase
        # once, now that enrollment fully succeeded.
        _print_recovery_phrase(_key_priv)
    elif not code.startswith("fhp_"):
        emit(
            "note: this agent has no E2EE identity key yet — run `hub "
            "key-init` to generate one and register it with the hub."
        )
    return 0


def _key_init_register(ctx):
    """Ensure an identity keypair exists locally and is registered server-side.

    Returns (priv_bytes, public_b64, is_new). Works as the initial
    registration when the agent has no key yet, and as a no-op when the
    local key is already registered. The Bearer <redacted> is the bootstrap:
    it authenticates WHO the agent is while the keypair becomes WHAT the
    agent can decrypt. Shared by `hub key-init` and the recovery ladder
    (rung 2).
    """
    _require_nacl()
    priv, pub_b64, is_new = _ensure_identity_keypair(ctx.profile)
    if is_new:
        _print_recovery_phrase(priv)
    me = ctx.client.call("GET", "/v1/me")
    if not isinstance(me, dict) or not me.get("id"):
        raise HubError("error", "Unexpected /v1/me response from the server.")
    member_id = me["id"]
    agent_label = me.get("agent_label") or ""
    directory = ctx.client.call("GET", "/v1/agent-keys", query={"member_id": member_id})
    for entry in _as_list(directory, "keys"):
        if (
            isinstance(entry, dict)
            and entry.get("agent_label") == agent_label
            and entry.get("public_key") == pub_b64
        ):
            emit("E2EE identity key is already registered for this agent — nothing to do.")
            return priv, pub_b64, is_new
    resp = ctx.client.call(
        "POST", "/v1/agent-keys/rotate", json_body={"agent_public_key": pub_b64}
    )
    if not isinstance(resp, dict) or "public_key" not in resp:
        raise HubError("error", "Unexpected response from the server.")
    emit("E2EE identity key registered.")
    emit_json(
        {
            "member_id": resp.get("member_id"),
            "agent_label": resp.get("agent_label"),
            "created_at": resp.get("created_at"),
        }
    )
    return priv, pub_b64, is_new


def cmd_key_init(args, transport):
    """Generate (if needed) and register this agent's E2EE identity key.

    Works as the initial registration when the agent has no key yet, and
    as a no-op when the local key is already registered. The Bearer <redacted>
    is the bootstrap: it authenticates WHO the agent is while the keypair
    becomes WHAT the agent can decrypt.
    """
    ctx = _ctx(args, transport)
    _key_init_register(ctx)
    return 0



def cmd_key_backup(args, transport):
    """Write an Argon2id-encrypted backup of the identity private key.

    The password never leaves the machine; the backup file is 0600. Keep
    the file somewhere other than this machine (or the recovery phrase
    somewhere safe) — either one restores the key via `hub key-restore`.
    """
    _require_nacl()
    profile = args.profile
    priv = _load_identity_key(agent_key_path(profile))
    out = (args.out or "").strip() or input("Backup file path: ").strip()
    if not out:
        raise HubError("bad_request", "A backup file path is required.")
    if os.path.exists(out) and not args.force:
        raise HubError(
            "bad_request",
            "Refusing to overwrite existing file %s (use --force to overwrite)." % out,
        )
    pw1 = getpass.getpass("Backup password: ")
    pw2 = getpass.getpass("Confirm backup password: ")
    note_secret(pw1)
    note_secret(pw2)
    if pw1 != pw2:
        raise HubError("bad_request", "Passwords do not match — backup not written.")
    if len(pw1) < 8:
        raise HubError("bad_request", "Password must be at least 8 characters.")
    blob = _encrypt_key_backup(priv, pw1)
    _write_secret_file_0600(out, json.dumps(blob, indent=2).encode("utf-8"), "backup")
    emit("Backup written to %s (mode 0600). Keep it somewhere safe." % out)
    return 0


def cmd_key_restore(args, transport):
    """Restore the identity private key from a recovery phrase or backup file.

    The phrase is never taken on the command line (it would land in shell
    history): paste it at the prompt or pass --phrase-file. Restoring does
    not register anything — run `hub key-init` afterwards; it is idempotent
    and registers the key only if needed.
    """
    _require_nacl()
    profile = args.profile
    key_path = agent_key_path(profile)
    if os.path.exists(key_path) and not args.force:
        raise HubError(
            "bad_request",
            "An identity key already exists at %s (use --force to overwrite "
            "it — the current key will be unrecoverable without its own "
            "backup)." % key_path,
        )
    if args.backup_file:
        try:
            with open(args.backup_file, "r", encoding="utf-8") as fh:
                blob = json.load(fh)
        except (OSError, ValueError) as exc:
            raise HubError("bad_request", "Cannot read backup file: %s" % exc)
        password = getpass.getpass("Backup password: ")
        note_secret(password)
        priv = _decrypt_key_backup(blob, password)
    else:
        if args.phrase_file:
            try:
                with open(args.phrase_file, "r", encoding="utf-8") as fh:
                    phrase = fh.read()
            except OSError as exc:
                raise HubError("bad_request", "Cannot read phrase file: %s" % exc)
        else:
            phrase = getpass.getpass("Recovery phrase (24 words): ")
        note_secret(phrase)
        priv = _privkey_from_phrase(phrase)
    _note_key_secrets(priv)
    _write_secret_file_0600(key_path, priv, "identity private key")
    emit("Identity key restored to %s (mode 0600)." % key_path)
    emit("Run `hub key-init` to register its public key with the hub.")
    return 0


def _sync_one_circle(ctx, transport, circle_id, circle_name, token, limit):
    """Fetch a single circle's new entries WITHOUT advancing its cursor.

    Returns (labeled_entries, new_cursor): the entries labeled with their
    circle, plus the cursor value the caller must persist AFTER the entries
    have been emitted (None when there is nothing new to acknowledge).
    The cursor is returned, never written, so a failure downstream (a later
    circle failing, or output never being emitted) cannot strand entries
    behind an advanced cursor.
    """
    client = HubClient(ctx.server, token, debug=ctx.client.debug,
                       transport=transport)
    cursor = _read_cursor(ctx.profile, circle_id)
    resp = client.call(
        "GET", "/v1/sync", query={"after_gseq": cursor, "limit": limit}
    )
    entries = _as_list(resp, "entries")
    labeled = []
    for e in entries:
        if isinstance(e, dict):
            e = dict(e)
            e["circle_id"] = circle_id
            e["circle_name"] = circle_name
        labeled.append(e)
    # Decrypt E2EE entries with THIS circle's client (per-circle token);
    # topic records are fetched once per topic, not per entry.
    e2ee_flags = _e2ee_flags_for_entries(client, labeled)
    # Phase 4: pick up rotated/granted key envelopes BEFORE decrypting, so a
    # re-keyed topic's new key is usable on first sight.
    _e2ee_refresh_after_sync(client, ctx.profile, e2ee_flags)
    _decrypt_entries_for_display(client, ctx.profile, labeled, e2ee_flags)
    new_cursor = None
    if entries:
        gseqs = [e.get("gseq") for e in entries if isinstance(e, dict)]
        gseqs = [g for g in gseqs if isinstance(g, int)]
        nxt = None
        if isinstance(resp, dict):
            nxt = resp.get("next_after_gseq")
        if gseqs or isinstance(nxt, int):
            new_cursor = nxt if isinstance(nxt, int) else max(gseqs)
    return labeled, new_cursor


def cmd_sync(args, transport):
    ctx = _ctx(args, transport)
    circle_tokens = ctx.cfg.get("circle_tokens") or {}
    if not circle_tokens:
        # Legacy single-token profile: behavior unchanged.
        cursor = _read_cursor(ctx.profile)
        resp = ctx.client.call(
            "GET", "/v1/sync", query={"after_gseq": cursor, "limit": args.limit}
        )
        entries = _as_list(resp, "entries")
        e2ee_flags = _e2ee_flags_for_entries(ctx.client, entries)
        # Phase 4: pick up rotated/granted key envelopes BEFORE decrypting, so a
        # re-keyed topic's new key is usable on first sight.
        _e2ee_refresh_after_sync(ctx.client, ctx.profile, e2ee_flags)
        _decrypt_entries_for_display(ctx.client, ctx.profile, entries, e2ee_flags)
        emit_json(entries)
        if entries:
            gseqs = [e.get("gseq") for e in entries if isinstance(e, dict)]
            gseqs = [g for g in gseqs if isinstance(g, int)]
            nxt = None
            if isinstance(resp, dict):
                nxt = resp.get("next_after_gseq")
            _write_cursor(ctx.profile, nxt if isinstance(nxt, int) else max(gseqs))
        else:
            emit_err("no new entries (cursor gseq=%d)" % cursor)
        return 0
    # Multi-circle: one token per circle, one cursor per circle. The legacy
    # bootstrap circle still syncs via its fallback token when present.
    names = {
        c.get("id"): c.get("name")
        for c in _list_circles(ctx.client)
        if isinstance(c, dict)
    }
    targets = [
        (cid, tok) for cid, tok in circle_tokens.items() if tok
    ]
    legacy_cid = ctx.cfg.get("family_id")
    if legacy_cid and legacy_cid not in dict(targets):
        try:
            tok, _src = load_token(ctx.cfg, ctx.profile)
            targets.append((legacy_cid, tok))
        except HubError:
            pass
    all_entries = []
    pending_cursors = []  # (circle_id, value): written ONLY after emit
    errors = []  # (circle_name, message): per-circle partial results
    for cid, tok in targets:
        try:
            entries, new_cursor = _sync_one_circle(
                ctx, transport, cid, names.get(cid, cid), tok, args.limit
            )
        except HubError as exc:
            # One circle failing must not lose the others' entries, and must
            # never advance any cursor: a retry re-delivers what we emit.
            errors.append((names.get(cid, cid), exc.friendly()))
            continue
        all_entries.extend(entries)
        if new_cursor is not None:
            pending_cursors.append((cid, new_cursor))
    # Emit first; only afterwards persist cursors — and only when every
    # circle succeeded. Output for the healthy circles still goes out,
    # then the failures are reported and we exit non-zero.
    emit_json(all_entries)
    if not all_entries:
        emit_err("no new entries")
    if not errors:
        for cid, value in pending_cursors:
            _write_cursor(ctx.profile, value, cid)
    for circle_name, msg in errors:
        emit_err("sync failed for circle %r: %s" % (circle_name, msg))
    return 1 if errors else 0



def cmd_setup(args, transport):
    profile = args.profile
    cfg = load_config(profile)
    server = (
        args.server
        or os.environ.get("FAMILY_HUB_URL")
        or cfg.get("server_url")
        or input("Hub server URL (https://…): ").strip()
    )
    if not server:
        raise HubError("bad_request", "A server URL is required.")
    code = args.invite or getpass.getpass("Invite or provisioning code: ").strip()
    if not code:
        raise HubError("bad_request", "An invite or provisioning code is required.")
    note_secret(code)  # bearer code: keep it out of --debug URL dumps etc.
    if code.startswith("fhp_"):
        # Owner bootstrap flow: the member already exists; the provisioning
        # code mints this agent's token directly (label set at bootstrap).
        accept_path = "/v1/provisioning-codes/%s/redeem" % urlparse.quote(code, safe="")
        accept_body = {}
        display_name = ""
        agent_label = "owner-agent"
    else:
        display_name = args.name or input("Your display name: ").strip()
        if not display_name:
            raise HubError("bad_request", "A display name is required.")
        default_label = "%s-agent" % socket.gethostname().split(".")[0]
        agent_label = args.label or input(
            "Agent label [%s]: " % default_label
        ).strip() or default_label
        accept_path = "/v1/invites/%s/accept" % urlparse.quote(code, safe="")
        accept_body = {"display_name": display_name, "agent_label": agent_label}

    client = HubClient(server, token=None, debug=args.debug, transport=transport)
    resp = client.call(
        "POST",
        accept_path,
        json_body=accept_body,
        auth=False,
    )
    if not isinstance(resp, dict) or "token" not in resp or "member" not in resp:
        raise HubError("error", "Unexpected response from the server.")
    token = resp["token"]
    member = resp["member"]
    note_secret(token)  # from here on, the token can never appear in output

    store = args.store or "env"
    new_cfg = {
        "server_url": server.rstrip("/"),
        "member": {
            "id": member.get("id"),
            "name": member.get("name", display_name),
            "role": member.get("role"),
            "email": member.get("email"),
        },
        "family_id": member.get("family_id"),
        "agent_label": agent_label,
        "token_id": resp.get("token_id"),
        "auth_method": store,
    }
    if store == "file":
        token_file = default_token_path(profile)
        os.makedirs(profile_dir(profile), mode=0o700, exist_ok=True)
        fd = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(token + "\n")
        new_cfg["token_file"] = token_file
        storage_note = (
            "stored in a 0600 file at %s. Anyone with access to this "
            "machine user can read it." % token_file
        )
    elif store == "vault-cmd":
        vault_cmd = args.vault_cmd or input(
            "Vault helper command (stdout must be the token): "
        ).strip()
        if not vault_cmd:
            raise HubError("bad_request", "A vault helper command is required.")
        new_cfg["vault_cmd"] = vault_cmd
        storage_note = (
            "resolved at runtime via your vault helper. The raw token is "
            "not stored anywhere by hub."
        )
    else:  # env
        storage_note = (
            "NOT stored by hub. Your agent harness must inject FAMILY_HUB_TOKEN "
            "from your Secure Vault each time it runs hub. The token was "
            "returned once by the server and will never be shown again."
        )
    save_config(profile, new_cfg)
    # save_config scrubs tokens; assert nothing secret-bearing was written.
    emit("setup complete.")
    emit_json(
        {
            "profile": profile,
            "server": new_cfg["server_url"],
            "member": new_cfg["member"],
            "agent_label": agent_label,
            "auth": store,
            "note": storage_note,
        }
    )
    return 0


def _sync_one_circle(ctx, transport, circle_id, circle_name, token, limit):
    """Sync a single circle; returns its new entries (labeled)."""
    client = HubClient(ctx.server, token, debug=ctx.client.debug,
                       transport=transport)
    cursor = _read_cursor(ctx.profile, circle_id)
    resp = client.call(
        "GET", "/v1/sync", query={"after_gseq": cursor, "limit": limit}
    )
    entries = _as_list(resp, "entries")
    labeled = []
    for e in entries:
        if isinstance(e, dict):
            e = dict(e)
            e["circle_id"] = circle_id
            e["circle_name"] = circle_name
        labeled.append(e)
    if entries:
        gseqs = [e.get("gseq") for e in entries if isinstance(e, dict)]
        gseqs = [g for g in gseqs if isinstance(g, int)]
        nxt = None
        if isinstance(resp, dict):
            nxt = resp.get("next_after_gseq")
        if gseqs or isinstance(nxt, int):
            _write_cursor(
                ctx.profile,
                nxt if isinstance(nxt, int) else max(gseqs),
                circle_id,
            )
    return labeled


def cmd_sync(args, transport):
    ctx = _ctx(args, transport)
    circle_tokens = ctx.cfg.get("circle_tokens") or {}
    if not circle_tokens:
        # Legacy single-token profile: behavior unchanged.
        cursor = _read_cursor(ctx.profile)
        resp = ctx.client.call(
            "GET", "/v1/sync", query={"after_gseq": cursor, "limit": args.limit}
        )
        entries = _as_list(resp, "entries")
        emit_json(entries)
        if entries:
            gseqs = [e.get("gseq") for e in entries if isinstance(e, dict)]
            gseqs = [g for g in gseqs if isinstance(g, int)]
            nxt = None
            if isinstance(resp, dict):
                nxt = resp.get("next_after_gseq")
            _write_cursor(ctx.profile, nxt if isinstance(nxt, int) else max(gseqs))
        else:
            emit_err("no new entries (cursor gseq=%d)" % cursor)
        return 0
    # Multi-circle: one token per circle, one cursor per circle. The legacy
    # bootstrap circle still syncs via its fallback token when present.
    names = {
        c.get("id"): c.get("name")
        for c in _list_circles(ctx.client)
        if isinstance(c, dict)
    }
    targets = [
        (cid, tok) for cid, tok in circle_tokens.items() if tok
    ]
    legacy_cid = ctx.cfg.get("family_id")
    if legacy_cid and legacy_cid not in dict(targets):
        try:
            tok, _src = load_token(ctx.cfg, ctx.profile)
            targets.append((legacy_cid, tok))
        except HubError:
            pass
    all_entries = []
    for cid, tok in targets:
        all_entries.extend(
            _sync_one_circle(ctx, transport, cid, names.get(cid, cid), tok,
                             args.limit)
        )
    emit_json(all_entries)
    if not all_entries:
        emit_err("no new entries")
    return 0



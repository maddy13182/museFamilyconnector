#!/usr/bin/env python3
"""
hub — Family Hub agent CLI.

The tool an agent calls to talk to its family's Hub. The agent's bearer token
is loaded at runtime from (in precedence order):

  1. ``FAMILY_HUB_TOKEN`` environment variable.
     This is how the Secure Vault delivers it: the agent harness injects the
     variable into the tool process at call time. The model never sees it.
  2. A vault helper command (config ``vault_cmd`` or ``FAMILY_HUB_VAULT_CMD``),
     e.g. ``op read op://vault/item/token``. The command's stdout is the token.
     For setups that keep the token in an external secret manager.
  3. A ``0600`` file (config ``token_file``, default ``<profile>/token``).
     For scripts / non-Muse agents. The CLI warns if the file is readable
     by anyone else.

The token is NEVER accepted on the command line (it would show up in ``ps``)
and NEVER printed — not in normal output, not in ``--debug``, not in
tracebacks. Every byte written to stdout/stderr passes through ``redact()``.
The sole exception is ``hub dashboard-token``, which prints one stored
token preceded by a warning (it bypasses redaction deliberately).

Multi-circle (v0.2.0): the server binds each bearer token to ONE circle, so
a profile keeps ``circle_tokens: {circle_id: token}`` in the 0600
config.json. Every API call authenticates with the active circle's token,
falling back to the single-token chain above when a circle has no stored
token (bootstrap-family backwards compatibility).

Python 3, standard library only.
"""

import argparse
import getpass
import json
import os
import re
import shlex
import socket
import stat
import subprocess  # nosec B404 -- used only for the operator-configured vault helper (shell=False)
import sys
import uuid
from urllib import error as urlerror
from urllib import parse as urlparse
from urllib import request as urlrequest

VERSION = "0.2.0"

# ---------------------------------------------------------------------------
# Secret handling / redaction
# ---------------------------------------------------------------------------

_REDACT_VALUES = []


def note_secret(value):
    """Register a secret value so redact() can scrub it from all output."""
    if value and value not in _REDACT_VALUES:
        _REDACT_VALUES.append(value)


def clear_secrets():
    del _REDACT_VALUES[:]


def redact(text):
    """Scrub every registered secret from text. Never fails."""
    if text is None:
        return ""
    out = str(text)
    for secret in _REDACT_VALUES:
        if secret and len(secret) >= 8 and secret in out:
            out = out.replace(secret, "[redacted]")
    return out


def emit(msg=""):
    sys.stdout.write(redact(msg) + "\n")


def emit_err(msg=""):
    sys.stderr.write(redact(msg) + "\n")


def emit_json(obj):
    sys.stdout.write(redact(json.dumps(obj, indent=2, ensure_ascii=False)) + "\n")


# ---------------------------------------------------------------------------
# Debug-output scrubbing. _debug_dump runs *inside* client.call, i.e. before
# a freshly minted token (redeem response) can be registered with
# note_secret(), so redact() alone cannot protect it. These scrubs are
# structural and need no registration.
# ---------------------------------------------------------------------------

_SENSITIVE_JSON_KEYS = frozenset({"token", "provisioning_code", "provisioningCode"})


def _scrub_sensitive_value(obj):
    """Recursively replace sensitive JSON values with [redacted]."""
    if isinstance(obj, dict):
        return {
            k: ("[redacted]" if k in _SENSITIVE_JSON_KEYS
                else _scrub_sensitive_value(v))
            for k, v in obj.items()
        }
    if isinstance(obj, list):
        return [_scrub_sensitive_value(v) for v in obj]
    return obj


def _scrub_sensitive_text(text):
    """Scrub secrets from a debug-dump payload.

    JSON bodies get sensitive fields redacted structurally. Non-JSON text
    passes through unchanged (redact() still applies to registered values).
    Never raises.
    """
    if not text:
        return ""
    try:
        parsed = json.loads(text)
    except ValueError:
        return text
    if isinstance(parsed, (dict, list)):
        try:
            return json.dumps(_scrub_sensitive_value(parsed))
        except (TypeError, ValueError):
            return "[unprintable]"
    return text


_CODE_IN_URL = re.compile(r"(fhp_|fhi_)[^/?#\s]*")


def _scrub_url(url):
    """Redact bearer codes embedded in URL paths.

    note_secret() covers the literal code, but URL-quoting can alter its
    bytes; the regex covers that edge.
    """
    return _CODE_IN_URL.sub(r"\1[redacted]", url or "")


# ---------------------------------------------------------------------------
# Config / profiles
# ---------------------------------------------------------------------------

APP_DIR = "family-hub"


def config_home():
    return os.environ.get(
        "FAMILY_HUB_CONFIG_HOME",
        os.path.join(os.path.expanduser("~"), ".config"),
    )


def profile_dir(profile):
    return os.path.join(config_home(), APP_DIR, "profiles", profile)


def config_path(profile):
    return os.path.join(profile_dir(profile), "config.json")


def cursor_path(profile, circle_id=None):
    base = os.path.join(profile_dir(profile), "cursor")
    if circle_id:
        safe = re.sub(r"[^A-Za-z0-9_-]", "_", str(circle_id))[:64] or "x"
        return base + "-" + safe
    return base


def default_token_path(profile):
    return os.path.join(profile_dir(profile), "token")


def load_config(profile):
    path = config_path(profile)
    if not os.path.exists(path):
        return {}
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def save_config(profile, cfg):
    d = profile_dir(profile)
    os.makedirs(d, mode=0o700, exist_ok=True)
    # Belt and suspenders: the legacy single-token keys must never live in
    # the config file (they belong in env / vault / the 0600 token file).
    # circle_tokens is the sanctioned exception: one token per circle, and
    # this file is already 0600. Tokens are never printed (see redact()).
    scrubbed = {k: v for k, v in cfg.items() if k not in ("token", "bearer_token")}
    tmp = config_path(profile) + ".tmp"
    # Create 0600 from the first byte: circle_tokens live in this file, and a
    # post-write chmod would leave a world-readable window on strict umasks.
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(scrubbed, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, config_path(profile))
    os.chmod(config_path(profile), 0o600)


def load_token(cfg, profile):
    """Return (token, source). Raises HubError if none is available."""
    # 1. Environment (Secure Vault injection at tool time).
    token = os.environ.get("FAMILY_HUB_TOKEN")
    if token and token.strip():
        return token.strip(), "env"
    # 2. Vault helper command.
    vault_cmd = os.environ.get("FAMILY_HUB_VAULT_CMD") or cfg.get("vault_cmd")
    if vault_cmd:
        try:
            # NOTE: vault_cmd is the operator's own configured helper command
            # (env var or local config file) -- never remote input -- and runs
            # with shell=False via shlex.split (no shell injection).
            proc = subprocess.run(  # nosec B603
                shlex.split(vault_cmd),
                capture_output=True,
                text=True,
                timeout=15,
            )
        except Exception as exc:  # noqa: BLE001 - surfaced as a clean error
            raise HubError(
                "vault_error",
                "Vault helper command failed to run: %s" % exc,
            )
        if proc.returncode != 0:
            raise HubError(
                "vault_error",
                "Vault helper command exited %d." % proc.returncode,
            )
        value = proc.stdout.strip().splitlines()[0] if proc.stdout.strip() else ""
        if not value:
            raise HubError("vault_error", "Vault helper returned an empty token.")
        return value, "vault-cmd"
    # 3. 0600 file.
    token_file = cfg.get("token_file") or default_token_path(profile)
    if os.path.exists(token_file):
        mode = stat.S_IMODE(os.stat(token_file).st_mode)
        if mode & 0o077:
            emit_err(
                "warning: token file %s is readable by others (mode %o); "
                "run: chmod 600 %s" % (token_file, mode, token_file)
            )
        with open(token_file, "r", encoding="utf-8") as fh:
            content = fh.read().strip()
        value = content.splitlines()[0] if content else ""
        if not value:
            raise HubError("auth", "Token file %s is empty." % token_file)
        return value, "token-file"
    raise HubError(
        "auth",
        "No credential found. Set FAMILY_HUB_TOKEN, configure a vault_cmd, "
        "or run `hub setup --store file`.",
    )


# ---------------------------------------------------------------------------
# Local PII pre-scan (mirrors the server's §11 scan)
# ---------------------------------------------------------------------------

# 13-19 digits, single separators allowed (spaces, dashes, dots).
_CARD_RE = re.compile(r"(?<!\d)(?:\d[ \-.]?){13,19}(?!\d)")
_SSN_RE = re.compile(r"(?<!\d)\d{3}-\d{2}-\d{4}(?!\d)")


def _luhn_ok(digits):
    total = 0
    for i, ch in enumerate(reversed(digits)):
        d = ord(ch) - 48
        if i % 2 == 1:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return total % 10 == 0


def scan_pii(text):
    """Return a list of findings like ['possible card number'].

    Same patterns as the server (§11): card-like digit runs verified with the
    Luhn check, and SSN-shaped sequences. Best-effort client side — the
    server always re-scans and is authoritative.
    """
    findings = []
    if not text:
        return findings
    for match in _CARD_RE.finditer(text):
        digits = re.sub(r"\D", "", match.group(0))
        if 13 <= len(digits) <= 19 and _luhn_ok(digits):
            findings.append("possible card number")
            break
    if _SSN_RE.search(text):
        findings.append("possible SSN")
    return findings


class PIIBlocked(Exception):
    def __init__(self, findings):
        super().__init__("; ".join(findings))
        self.findings = findings


def check_pii(*texts):
    findings = []
    for text in texts:
        for finding in scan_pii(text):
            if finding not in findings:
                findings.append(finding)
    if findings:
        raise PIIBlocked(findings)

# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------


class HubError(Exception):
    """A failure talking to the Hub. exit_code maps to process exit status."""

    def __init__(self, code, message, http_status=None):
        super().__init__(message)
        self.code = code
        self.http_status = http_status
        self.exit_code = 1

    def friendly(self):
        hints = {
            "auth": "Authentication failed (token invalid or revoked). "
            "Run `hub setup` again or ask the family owner for a new invite.",
            "forbidden": "Access denied. You can only see topics you participate in. "
            "A 403 is final — never try to work around it; ask an owner/parent "
            "for access instead.",
            "not_found": "Not found. Check the topic/task/member ID.",
            "conflict": "State conflict — e.g. a task cannot be marked done while "
            "it still has open subtasks.",
            "pii": "Blocked: the message looks like it contains sensitive data "
            "(card number, SSN, …). Rephrase without the sensitive value and retry.",
            "rate_limited": "Rate limited. Wait a minute and retry.",
            "connection": "Cannot reach the Hub server. Check --server / config "
            "and your network.",
            "vault_error": "Could not load the credential from the vault helper.",
        }
        hint = hints.get(self.code, "")
        text = str(self)
        return "%s %s" % (text, hint) if hint else text


def _friendly_from_http(status, payload):
    # Cloudflare bot protection (Error 1010) can reject the request before it
    # ever reaches the hub. Detect its unmistakable shape and say so plainly
    # instead of misreporting it as a hub permission error.
    if isinstance(payload, dict) and (
        payload.get("cloudflare_error") is True
        or payload.get("error_code") == 1010
        or "Error 1010" in str(payload.get("title", ""))
    ):
        return HubError(
            "connection",
            "Blocked by Cloudflare bot protection before reaching the hub "
            "(Error 1010, browser_signature_banned). The hub never saw this "
            "request. If you are the family owner, check the zone's Bot Fight "
            "Mode / WAF settings; agents should identify with a proper "
            "User-Agent (this tool does).",
            http_status=status,
        )
    code = "error"
    message = "request failed"
    if isinstance(payload, dict):
        err = payload.get("error") or {}
        code = err.get("code") or code
        message = err.get("message") or message
    mapping = {
        400: ("bad_request", 1),
        401: ("auth", 3),
        403: ("forbidden", 1),
        404: ("not_found", 1),
        409: ("conflict", 1),
        422: ("pii", 4),
        429: ("rate_limited", 1),
    }
    short, exit_code = mapping.get(status, ("error", 1))
    # Trust the server's own code when it matches a known one, else the mapping.
    known = {
        "bad_request",
        "auth",
        "forbidden",
        "not_found",
        "conflict",
        "pii",
        "rate_limited",
    }
    if code not in known:
        code = short
    exc = HubError(code, "%s (http %d)" % (message, status), http_status=status)
    exc.exit_code = exit_code
    return exc


# ---------------------------------------------------------------------------
# HTTP client (urllib; a fake transport can be injected for tests)
# ---------------------------------------------------------------------------


class _NoRedirect(urlrequest.HTTPRedirectHandler):
    """Refuse all HTTP redirects: fail closed instead of following them.

    urllib follows redirects automatically and honors non-HTTP schemes
    (e.g. file://) found in a Location header. The hub API never
    legitimately redirects, so any redirect is treated as hostile.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise HubError(
            "connection",
            "Refusing to follow redirect from hub server (code %d)" % code,
        )


# Module-level opener shared by all requests: no redirects, ever.
_opener = urlrequest.build_opener(_NoRedirect)


class HubClient:
    def __init__(self, base_url, token=None, timeout=20, debug=False, transport=None):
        self.base_url = base_url.rstrip("/")
        self.token = token
        if token:
            note_secret(token)
        self.timeout = timeout
        self.debug = debug
        self.transport = transport or self._urllib_transport

    # -- low level ------------------------------------------------------
    def _urllib_transport(self, method, url, headers, body_bytes):
        # SECURITY: only http(s) is ever requested. The base URL comes from
        # the operator's own config, but defense in depth costs one line.
        if urlparse.urlsplit(url).scheme.lower() not in ("http", "https"):
            raise HubError(
                "config",
                "Refusing non-HTTP(S) request URL — check your hub server URL",
            )
        req = urlrequest.Request(url, data=body_bytes, headers=headers, method=method)
        try:
            with _opener.open(req, timeout=self.timeout) as resp:
                return resp.status, resp.read().decode("utf-8", "replace")
        except urlerror.HTTPError as exc:
            return exc.code, exc.read().decode("utf-8", "replace")
        except urlerror.URLError as exc:
            raise HubError("connection", "Cannot reach %s: %s" % (self.base_url, exc))

    def _debug_dump(self, method, url, headers, body_bytes, status, resp_text):
        safe_headers = {
            k: ("[redacted]" if k.lower() == "authorization" else v)
            for k, v in headers.items()
        }
        emit_err("--- hub debug ---")
        emit_err("%s %s" % (method, _scrub_url(url)))
        emit_err("request headers: %s" % json.dumps(safe_headers))
        if body_bytes:
            emit_err("request body: %s"
                     % _scrub_sensitive_text(
                         body_bytes.decode("utf-8", "replace"))[:2000])
        emit_err("response status: %s" % status)
        emit_err("response body: %s"
                 % _scrub_sensitive_text(resp_text or "")[:2000])
        emit_err("--- end debug ---")

    # -- public ---------------------------------------------------------
    def call(self, method, path, query=None, json_body=None,
             idempotency_key=None, auth=True):
        url = self.base_url + path
        if query:
            url += "?" + urlparse.urlencode(query)
        headers = {
            "Accept": "application/json",
            # Cloudflare bot protection (Error 1010) blocks Python-urllib's
            # default UA. Identify honestly as the family-hub agent client.
            "User-Agent": "family-hub-agent/1.0",
        }
        if auth:
            if not self.token:
                raise HubError("auth", "No credential available for this request.")
            headers["Authorization"] = "Bearer " + self.token
        body_bytes = None
        if json_body is not None:
            body_bytes = json.dumps(json_body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        if idempotency_key:
            headers["Idempotency-Key"] = idempotency_key
        status, resp_text = self.transport(method, url, headers, body_bytes)
        if self.debug:
            self._debug_dump(method, url, headers, body_bytes, status, resp_text)
        if 200 <= status < 300:
            if not resp_text:
                return None
            try:
                return json.loads(resp_text)
            except ValueError:
                raise HubError("error", "Server returned non-JSON response.")
        try:
            payload = json.loads(resp_text) if resp_text else {}
        except ValueError:
            payload = {}
        raise _friendly_from_http(status, payload)


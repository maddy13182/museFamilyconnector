class HubError(Exception):
    """A failure talking to the Hub. exit_code maps to process exit status."""

    def __init__(self, code, message, http_status=None, server_code=None):
        super().__init__(message)
        self.code = code
        self.http_status = http_status
        # The server's own error.code (e.g. "code_used", "circle_name_taken"),
        # preserved verbatim for programmatic handling. `code` stays the
        # friendly mapped value.
        self.server_code = server_code
        # The raw response payload (if any), for recovery flows that need
        # fields beyond the error (e.g. the member on already_redeemed).
        self.details = {}
        self.exit_code = 1

    def friendly(self):
        hints = {
            "auth": "Authentication failed (token invalid or revoked). "
            "Run `hub setup` again or ask the family owner for a new invite.",
            "forbidden": "Access denied. You can only see topics you participate in. "
            "A 403 is final — never try to work around it; ask an owner/parent "
            "for access instead.",
            "not_found": "Not found. Check the topic/task/member ID.",
            "conflict": "State conflict — e.g. a task cannot be marked done while "
            "it still has open subtasks.",
            "pii": "Blocked: the message looks like it contains sensitive data "
            "(card number, SSN, …). Rephrase without the sensitive value and retry.",
            "rate_limited": "Rate limited. Wait a minute and retry.",
            "connection": "Cannot reach the Hub server. Check --server / config "
            "and your network.",
            "vault_error": "Could not load the credential from the vault helper.",
        }
        hint = hints.get(self.code, "")
        text = str(self)
        return "%s %s" % (text, hint) if hint else text


def _friendly_from_http(status, payload):
    # Cloudflare bot protection (Error 1010) can reject the request before it
    # ever reaches the hub. Detect its unmistakable shape and say so plainly
    # instead of misreporting it as a hub permission error.
    if isinstance(payload, dict) and (
        payload.get("cloudflare_error") is True
        or payload.get("error_code") == 1010
        or "Error 1010" in str(payload.get("title", ""))
    ):
        return HubError(
            "connection",
            "Blocked by Cloudflare bot protection before reaching the hub "
            "(Error 1010, browser_signature_banned). The hub never saw this "
            "request. If you are the family owner, check the zone's Bot Fight "
            "Mode / WAF settings; agents should identify with a proper "
            "User-Agent (this tool does).",
            http_status=status,
        )
    code = "error"
    message = "request failed"
    if isinstance(payload, dict):
        err = payload.get("error") or {}
        code = err.get("code") or code
        message = err.get("message") or message
    mapping = {
        400: ("bad_request", 1),
        401: ("auth", 3),
        403: ("forbidden", 1),
        404: ("not_found", 1),
        409: ("conflict", 1),
        422: ("pii", 4),
        429: ("rate_limited", 1),
    }
    short, exit_code = mapping.get(status, ("error", 1))
    # Trust the server's own code when it matches a known one, else the mapping.
    known = {
        "bad_request",
        "auth",
        "forbidden",
        "not_found",
        "conflict",
        "pii",
        "rate_limited",
    }
    if code not in known:
        code = short
    exc = HubError(code, "%s (http %d)" % (message, status), http_status=status)
    exc.exit_code = exit_code
    # Preserve the server's verbatim error code for programmatic handling
    # (retry/recovery decisions). Not part of the friendly message.
    if isinstance(payload, dict):
        server_code = (payload.get("error") or {}).get("code")
        if isinstance(server_code, str) and server_code:
            exc.server_code = server_code
    if isinstance(payload, dict):
        exc.details = payload
    return exc


# ---------------------------------------------------------------------------
# Server origin pinning (F03): https-only, loopback exception
# ---------------------------------------------------------------------------

# The env var the Secure Vault injects at tool time (sink for --store env).
ENV_VAR_NAME = "FAMILY_HUB_TOKEN"

_LOOPBACK_HOSTS = frozenset({"localhost", "127.0.0.1", "::1"})


def _validate_server_url(url):
    """Reject server URLs we must never send a credential to.

    Only http/https are allowed, and plain http is accepted solely for
    loopback hosts (local development). Credentials embedded in the URL
    (user:pass@host) are always rejected — the bearer token is the only
    credential and it travels in the Authorization header.
    Raises HubError on violation; returns the url unchanged otherwise.
    """
    try:
        parts = urlparse.urlsplit(url or "")
        scheme = parts.scheme.lower()
        host = (parts.hostname or "").lower().rstrip(".")
        has_userinfo = bool(parts.username or parts.password)
    except ValueError as exc:
        raise HubError("config", "Bad hub server URL %r: %s" % (url, exc))
    if scheme not in ("http", "https"):
        raise HubError(
            "config",
            "Refusing non-HTTP(S) hub server URL %r — check your hub "
            "server URL." % (url or ""),
        )
    if not host:
        raise HubError("config", "Hub server URL has no host: %r" % url)
    if has_userinfo:
        raise HubError(
            "config",
            "Refusing hub server URL with embedded credentials — the "
            "bearer token is the only credential and it travels in the "
            "Authorization header.",
        )
    if scheme == "http" and host not in _LOOPBACK_HOSTS:
        raise HubError(
            "config",
            "Refusing plain-HTTP hub server URL for non-loopback host %r — "
            "use https:// (plain http is only allowed for "
            "localhost/127.0.0.1/[::1] development)." % host,
        )
    return url


def _check_server_override(args, pinned, server):
    """Gate --server overrides of the pinned enrollment origin (F03).

    The profile's server_url is the origin the credential was enrolled
    against. A *differing* server — via --server OR the FAMILY_HUB_URL env
    var — would silently send the stored bearer token to another server, so
    it requires the explicit --allow-server-override flag and always prints
    a loud stderr warning. Same-origin (or no pinned origin yet) passes
    quietly.
    """
    flag_override = getattr(args, "server", None)
    env_override = os.environ.get("FAMILY_HUB_URL")
    override = flag_override or env_override
    if not override or not pinned:
        return
    norm = lambda u: (u or "").rstrip("/")
    if norm(override) == norm(pinned):
        return
    via = "--server" if flag_override else "FAMILY_HUB_URL"
    if not getattr(args, "allow_server_override", False):
        raise HubError(
            "config",
            "Refusing to override the hub server this profile enrolled "
            "with (enrolled: %s, %s: %s). If you really mean to send "
            "your credential to a different server, re-run with "
            "--allow-server-override." % (pinned, via, override),
        )
    emit_err("=" * 70)
    emit_err(
        "WARNING: %s overrides the hub server this profile enrolled with." % via
    )
    emit_err("  Enrolled (pinned): %s" % pinned)
    emit_err("  Override (%s): %s" % (via, override))
    emit_err(
        "You are sending your credential to a DIFFERENT server than the "
        "one you enrolled with."
    )
    emit_err("Only proceed if you configured this override yourself.")
    emit_err("=" * 70)


# ---------------------------------------------------------------------------
# Credential-sink validation + post-enrollment verification (F11)
#
# Invite/provisioning codes are single-use: redeeming one and THEN failing
# to persist the token burns the code and leaves the agent tokenless. So
# the sink is validated BEFORE the redeem call, and the fresh token is
# verified (GET /v1/me) before success is reported.
# ---------------------------------------------------------------------------


def _probe_profile_writable(profile):
    """Fail before redeeming if the profile dir can't take the credential."""
    d = profile_dir(profile)
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        probe = os.path.join(d, ".sink-probe")
        fd = os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("probe")
        os.unlink(probe)
    except OSError as exc:
        raise HubError(
            "config",
            "Credential sink check failed: cannot write to the profile "
            "directory %s (%s). Fix permissions before retrying — the "
            "invite code has NOT been used yet." % (d, exc),
        )


def _validate_env_sink():
    """Pre-redeem check that the --store env sink is usable.

    --store env means hub never persists the token: the agent harness must
    inject FAMILY_HUB_TOKEN at runtime. All we can verify up front is that
    the variable name is defined and the process environment is writable.
    """
    if not ENV_VAR_NAME:
        raise HubError(
            "config",
            "No environment variable name is configured for --store env — "
            "the invite code has NOT been used yet.",
        )
    sentinel = object()
    prev = os.environ.get(ENV_VAR_NAME, sentinel)
    try:
        os.environ[ENV_VAR_NAME] = "hub-sink-probe"
    except Exception as exc:  # noqa: BLE001 - surfaced as a clean error
        raise HubError(
            "config",
            "Credential sink check failed: cannot set %s in this process "
            "(%s) — the invite code has NOT been used yet."
            % (ENV_VAR_NAME, exc),
        )
    finally:
        if prev is sentinel:
            os.environ.pop(ENV_VAR_NAME, None)
        else:
            os.environ[ENV_VAR_NAME] = prev


def _validate_vault_cmd(vault_cmd):
    """Pre-redeem sanity check of the operator's vault helper.

    Static only: the command must parse and its binary must exist on PATH.
    hub cannot test the actual write path without the token, which only
    exists after redeeming — the operator must verify the helper really
    returns the stored token (see --vault-cmd help).
    """
    try:
        argv = shlex.split(vault_cmd)
    except ValueError as exc:
        raise HubError(
            "config",
            "Vault helper command does not parse (%s) — the invite code "
            "has NOT been used yet." % exc,
        )
    if not argv:
        raise HubError(
            "config",
            "Vault helper command is empty — the invite code has NOT been "
            "used yet.",
        )
    if shutil.which(argv[0]) is None:
        raise HubError(
            "config",
            "Credential sink check failed: vault helper %r not found on "
            "PATH. Install it or fix the command before retrying — the "
            "invite code has NOT been used yet." % argv[0],
        )


def _verify_new_token(server, transport, debug, token, flow_name):
    """GET /v1/me with the fresh token; gate success on it.

    Raises HubError spelling out whether the code is likely consumed, so
    the operator knows whether to ask an owner for a fresh code or just
    retry the network.
    """
    probe = HubClient(server, token, debug=debug, transport=transport)
    try:
        me = probe.call("GET", "/v1/me", auth=True, retries=0)
    except HubError as exc:
        if exc.code in ("auth", "forbidden"):
            err = HubError(
                "auth",
                "Enrollment failed verification: the server rejected the "
                "new credential (GET /v1/me: %s). The invite code is "
                "consumed — ask the family owner for a fresh invite code "
                "and run `hub %s` again." % (exc, flow_name),
            )
            err.exit_code = 3
            raise err
        raise HubError(
            exc.code,
            "Could not verify the new credential (GET /v1/me: %s). The "
            "credential WAS stored, so do NOT request a new code yet — "
            "check your network and retry a command such as "
            "`hub circles`; if the server keeps rejecting it, ask the "
            "owner for a fresh code." % exc,
        )
    if not isinstance(me, dict) or not me.get("id"):
        err = HubError(
            "auth",
            "Enrollment failed verification: GET /v1/me returned an "
            "unexpected response. The invite code may be consumed — ask "
            "the family owner for a fresh invite code and run `hub %s` "
            "again." % flow_name,
        )
        err.exit_code = 3
        raise err


# ---------------------------------------------------------------------------
# E2EE identity keys (Phase 1)
#
# One X25519 keypair per profile. The private key lives in the profile dir
# (agent.key, mode 0600) and NEVER leaves the machine: it is never sent to
# the server, never printed (the 24-word recovery phrase is the deliberate,
# user-facing exception — it encodes the same key for disaster recovery),
# and never appears in logs or --debug output. Every textual encoding of
# the raw key is registered with note_secret() so redact() scrubs it from
# all output paths.
#
# Requires PyNaCl (+ the `mnemonic` package for BIP-39 phrases), pinned in
# agent-skill/requirements.txt. This ended the stdlib-only property — see
# agent-skill/INSTALL.md. All imports are lazy: every non-key command keeps
# working when PyNaCl is missing, and key commands fail with a clear
# install instruction instead of an ImportError traceback.
# ---------------------------------------------------------------------------

_MISSING_CRYPTO_MSG = (
    "PyNaCl is required for E2EE key commands but is not installed. "
    "Install it with: pip install -r <skill-dir>/requirements.txt "
    "(or: pip install 'PyNaCl==1.6.2' 'mnemonic==0.21'). "
    "All non-key hub commands keep working without it."
)


def _require_nacl():
    """Import PyNaCl lazily; raise a helpful HubError when it is missing."""
    try:
        import nacl.bindings
        import nacl.pwhash
        import nacl.public
        import nacl.utils
    except ImportError:
        raise HubError("config", _MISSING_CRYPTO_MSG)
    import nacl  # noqa: F401  (re-exported for callers)

    return nacl


def _require_mnemonic():
    """Import the BIP-39 helper lazily; helpful error when missing."""
    try:
        from mnemonic import Mnemonic
    except ImportError:
        raise HubError("config", _MISSING_CRYPTO_MSG)
    return Mnemonic


def agent_key_path(profile):
    return os.path.join(profile_dir(profile), "agent.key")


def _note_key_secrets(priv_bytes):
    """Register every textual encoding of the raw key for redaction."""
    note_secret(base64.b64encode(priv_bytes).decode("ascii"))
    note_secret(priv_bytes.hex())


def _write_secret_file_0600(path, data, what):
    """Write bytes to path with mode 0600; fail loudly if perms can't hold.

    os.open's mode is masked by the umask (and O_TRUNC keeps an existing
    file's mode), so the mode is verified after the write and repaired with
    chmod when needed. If 0600 still can't be enforced, the write is
    refused — a private key must never rest in a group/world-readable file.
    """
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
    except BaseException:
        # Don't leave a half-written secret behind.
        try:
            os.unlink(path)
        except OSError:
            pass
        raise
    mode = stat.S_IMODE(os.stat(path).st_mode)
    if mode != 0o600:
        try:
            os.chmod(path, 0o600)
            mode = stat.S_IMODE(os.stat(path).st_mode)
        except OSError:
            pass
    if mode != 0o600:
        try:
            os.unlink(path)
        except OSError:
            pass
        raise HubError(
            "config",
            "Refusing to store the %s: could not enforce 0600 permissions "
            "on %s (mode is %o). Fix the filesystem/umask and retry." % (what, path, mode),
        )


def _generate_identity_keypair():
    """Generate a fresh X25519 keypair. Returns the 32-byte private key."""
    nacl = _require_nacl()
    # PrivateKey.generate() draws 32 bytes from the OS CSPRNG via libsodium.
    return bytes(nacl.public.PrivateKey.generate())


def _public_key_b64(priv_bytes):
    """Derive the X25519 public key (standard base64) from private bytes."""
    nacl = _require_nacl()
    pub = bytes(nacl.public.PrivateKey(priv_bytes).public_key)
    return base64.b64encode(pub).decode("ascii")


# ---------------------------------------------------------------------------
# E2EE topics (Phase 2) — topic-key generation, subject encryption, envelopes.
#
# Ciphertext formats (see docs/E2EE_BUILD_SPEC.md):
#
# - Subject: XChaCha20-Poly1305 (IETF) under the 32-byte topic key, random
#   192-bit (24-byte) nonce PREPENDED to the ciphertext+tag, whole blob
#   standard-base64. AAD is b"fh-topic-subject-v1" + b"\x00" + topic_id
#   (secfix F4): binding the topic id stops a malicious server swapping
#   subject blobs between topics. Topic ids are server-generated, so at
#   CREATE time the id is not known yet — the create-step subject uses the
#   legacy fixed AAD b"fh-topic-subject-v1", and `hub new-topic --e2ee`
#   immediately PATCHes /v1/topics/:id/subject with the subject re-encrypted
#   under the topic-bound AAD (before any envelope is distributed).
# - Envelope plaintext: topic_id_bytes || b"\x00" || key_id_bytes (16) ||
#   topic_key (32), sealed with libsodium crypto_box_seal to the recipient
#   agent's X25519 public key. Binding key_id inside the sealed plaintext
#   stops an envelope being replayed into a different key rotation of the
#   same topic (design §2 L3); binding topic_id (secfix F2) stops a
#   cross-topic transplant — an envelope sealed for topic A is rejected,
#   never stored, when opened for topic B. The sealed blob travels as
#   standard base64.
#
# The topic key NEVER leaves the machine except inside sealed envelopes,
# and is never printed or logged: _note_topic_key_secrets() registers every
# textual encoding with note_secret() for redaction.
# ---------------------------------------------------------------------------

_E2EE_SUBJECT_AAD = b"fh-topic-subject-v1"
_E2EE_SUBJECT_NONCE_BYTES = 24  # XChaCha20 nonce
_E2EE_TOPIC_KEY_BYTES = 32
_E2EE_KEY_ID_BYTES = 16  # 128-bit, hex-encoded on the wire / in storage
_E2EE_SUBJECT_PLAINTEXT_MAX = 200  # same user-visible limit as plaintext topics


def _note_topic_key_secrets(topic_key):
    """Register every textual encoding of the topic key for redaction."""
    note_secret(base64.b64encode(topic_key).decode("ascii"))
    note_secret(topic_key.hex())


def _e2ee_subject_aad(topic_id):
    """Build the topic-bound subject AAD.

    b"fh-topic-subject-v1" + b"\\x00" + topic_id.encode("utf-8"). Binding
    topic_id stops a malicious server from swapping subject blobs between
    topics (secfix F4). Topic ids are server-generated, so at CREATE time
    the id is not known yet: the create-step subject uses the legacy fixed
    AAD and `hub new-topic --e2ee` immediately PATCHes the subject
    re-encrypted under this AAD (see _cmd_new_topic_e2ee).
    """
    topic_id = str(topic_id)
    if "\x00" in topic_id:
        raise HubError("error", "E2EE: topic_id contains NUL; cannot build subject AAD.")
    return _E2EE_SUBJECT_AAD + b"\x00" + topic_id.encode("utf-8")


def _e2ee_encrypt_subject(subject, topic_key, topic_id=None):
    """Encrypt a topic subject; returns the base64 (nonce || ciphertext) blob.

    topic_id=None encrypts under the legacy fixed AAD — used ONLY for the
    provisional create-step subject, which is immediately replaced by the
    topic-bound PATCH. Pass the topic id everywhere else.
    """
    nacl = _require_nacl()
    nonce = os.urandom(_E2EE_SUBJECT_NONCE_BYTES)
    aad = _e2ee_subject_aad(topic_id) if topic_id is not None else _E2EE_SUBJECT_AAD
    ct = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_encrypt(
        subject.encode("utf-8"), aad, nonce, topic_key
    )
    return base64.b64encode(nonce + ct).decode("ascii")


def _e2ee_topic_id_bytes(topic_id):
    """topic_id as UTF-8 bytes for crypto bindings; HubError on NUL.

    Topic ids are server-generated and never contain NUL; the check keeps
    the b"\\x00" separator in the sealed envelope plaintext unambiguous.
    """
    tid = str(topic_id)
    if "\x00" in tid:
        raise HubError("error", "E2EE: topic_id contains NUL; cannot bind it.")
    return tid.encode("utf-8")


def _e2ee_seal_envelope(topic_id, key_id_bytes, topic_key, recipient_pubkey_b64):
    """Seal (topic_id || 0x00 || key_id || topic_key) to a recipient's key.

    Binding topic_id inside the sealed plaintext stops a cross-topic
    transplant: an envelope sealed for topic A can never be merged into
    topic B's keystore (see _e2ee_open_envelope). base64 out.
    """
    nacl = _require_nacl()
    try:
        pub = base64.b64decode(recipient_pubkey_b64, validate=True)
    except ValueError as exc:
        raise HubError(
            "error",
            "Server returned a malformed public key for an envelope recipient (%s)." % exc,
        )
    if len(pub) != 32:
        raise HubError(
            "error",
            "Server returned a %d-byte public key for an envelope recipient; expected 32."
            % len(pub),
        )
    plaintext = _e2ee_topic_id_bytes(topic_id) + b"\x00" + key_id_bytes + topic_key
    sealed = nacl.bindings.crypto_box_seal(plaintext, pub)
    return base64.b64encode(sealed).decode("ascii")


def _e2ee_open_envelope(envelope_b64, priv_bytes, expected_topic_id):
    """Open a sealed envelope with our identity private key.

    Returns (key_id_bytes, topic_key). The topic_id bound inside the sealed
    plaintext must match expected_topic_id — a mismatch is a cross-topic
    transplant: rejected loudly and must NEVER be stored. Malformed
    plaintext is rejected the same way.
    """
    nacl = _require_nacl()
    pub = bytes(nacl.public.PrivateKey(priv_bytes).public_key)
    try:
        sealed = base64.b64decode(envelope_b64, validate=True)
    except ValueError as exc:
        raise HubError("error", "Own envelope is not valid base64 (%s)." % exc)
    try:
        opened = nacl.bindings.crypto_box_seal_open(sealed, pub, priv_bytes)
    except Exception as exc:
        raise HubError("error", "Failed to open own key envelope (%s)." % exc)
    # Sealed plaintext: topic_id_bytes + b"\x00" + key_id_bytes(16) +
    # topic_key(32). topic_ids never contain NUL, so the first NUL is the
    # separator.
    head, sep, rest = opened.partition(b"\x00")
    if not sep or len(rest) != _E2EE_KEY_ID_BYTES + _E2EE_TOPIC_KEY_BYTES:
        raise HubError(
            "error",
            "Own envelope has malformed sealed plaintext; refusing to store it.",
        )
    if head != _e2ee_topic_id_bytes(expected_topic_id):
        raise HubError(
            "error",
            "Envelope rejected: it was sealed for a DIFFERENT topic "
            "(cross-topic transplant); refusing to store it.",
        )
    return rest[:_E2EE_KEY_ID_BYTES], rest[_E2EE_KEY_ID_BYTES:]


def topic_keys_dir(profile):
    return os.path.join(profile_dir(profile), "topic_keys")


def _store_topic_key(profile, topic_id, key_id_hex, topic_key):
    """Persist key_id -> base64 topic key at 0600; fail loudly on perm failure.

    Uses _write_secret_file_0600, which refuses to leave a private key in a
    group/world-readable file.
    """
    path = os.path.join(topic_keys_dir(profile), topic_id + ".json")
    payload = json.dumps({key_id_hex: base64.b64encode(topic_key).decode("ascii")},
                         indent=2, sort_keys=True).encode("utf-8")
    _write_secret_file_0600(path, payload, "topic key")
    return path


# ---------------------------------------------------------------------------
# E2EE message encryption — Phase 3
#
# Wire format for one encrypted field (entry body, entry data):
#
#     fh1.<key_id_hex>.<msg_id_hex>.<base64(nonce || ciphertext)>
#
#   * tag "fh1": version tag; self-describing on the wire.
#   * key_id_hex: 32 lowercase hex chars (128-bit key id), PLAINTEXT. Lets a
#     reader pick the right key from the local keystore without trial
#     decryption. The entries table has no key_id column and the schema is
#     frozen, so the key id rides inside the body/data blob.
#   * msg_id_hex: 32 lowercase hex chars (128-bit client-chosen random id),
#     PLAINTEXT. Bound into the AAD (see _e2ee_msg_aad); gives every message
#     a unique AAD identity so one message's ciphertext cannot be replayed
#     as a different entry.
#   * nonce: 24 fresh random bytes per encrypted field (XChaCha20).
#   * ciphertext: XChaCha20-Poly1305-IETF(plaintext, aad, nonce, topic_key),
#     nonce prepended, whole blob base64'd. Ciphertext goes in the existing
#     entries.body / entries.data columns (base64 TEXT) — no server schema
#     change; the server stores and returns it opaquely.
#
# AAD (additional authenticated data) — canonical byte string:
#
#     b"fh-msg-v1" + b"\x00" + topic_id.encode("utf-8")
#                   + b"\x00" + key_id_hex.encode("ascii")
#                   + b"\x00" + msg_id_hex.encode("ascii")
#
# The domain separator prevents cross-protocol confusion; NUL separators are
# unambiguous because no field may contain NUL (hex fields are [0-9a-f]{32}
# by construction; topic ids are server-issued ids, checked on build).
#
# WHY msg_id AND NOT seq: the design asks for AAD binding (topic_id, seq,
# key_id), but seq is assigned server-side at INSERT — the CLI cannot know
# it before POST, and the ciphertext must be final before POST (single-POST
# flow; no second round trip). Options considered:
#   (a) two-step POST (post, learn seq, re-encrypt) — rejected: breaks the
#       atomic single-POST + idempotency-key dedup semantics, doubles round
#       trips.
#   (b) bind (topic_id, key_id, msg_id) with a client-chosen random msg_id
#       carried in plaintext in the wire envelope — CHOSEN. No server change
#       needed: the msg_id travels inside the opaque body/data blob the
#       server stores and returns. Prevents cut-and-paste of ciphertext
#       across topics (topic_id), across key rotations (key_id), and replay
#       of one message's ciphertext as another entry (msg_id).
#   (c) bind (topic_id, key_id) only — weaker than (b): a SQL-writing
#       adversary could copy one entry's ciphertext into another entry row
#       of the same topic undetectably. With (b) that fails AAD loudly
#       unless the attacker also copies the msg_id, which yields a duplicate
#       msg_id (detectable) rather than a forged message.
# Accepted tradeoff: server-assigned seq is NOT in the AAD, so silent
# reordering of entries by a malicious server is not cryptographically
# detectable. Reordering is not a confidentiality violation (the threat
# model in design §1 targets content confidentiality; availability-style
# games are out of scope), and readers still see the server's seq.
#
# Entry `data` (when present) is encrypted with the SAME scheme and the same
# key_id, but its OWN fresh msg_id — each _e2ee_encrypt_field call mints a
# fresh msg_id, so body and data do NOT share one. Its plaintext is the
# canonical JSON serialization (json.dumps with sort_keys=True,
# separators=(",", ":"))). Each encrypted field gets its own fresh nonce.
# data=None stays null.
#
# READ POLICY for E2EE topics (hub read / hub sync):
#   * body starts with "fh1." -> parse; select key by the plaintext key_id.
#       - key missing from the local keystore -> placeholder body, data=None
#         (never crash the command, never show ciphertext as text).
#       - AAD/tag verification fails -> LOUD HubError naming topic+seq
#         (tamper evidence); the command aborts, nothing silently dropped.
#       - wire malformed (tag present but unparseable) -> LOUD HubError.
#   * body does NOT start with "fh1." -> pass through untouched. The server
#     legitimately writes plaintext entries into E2EE topics (redaction
#     announcements, redacted bodies); those were never confidential and
#     must keep working.
# Plaintext topics: never touched, byte-identical to today.
#
# PII: the server cannot scan ciphertext, so the CLI's local pre-scan
# (check_pii) is the enforcement point for E2EE topics — it runs on the
# PLAINTEXT (body and the canonical data JSON) before encrypting.
# ---------------------------------------------------------------------------

_E2EE_MSG_TAG = "fh1"
_E2EE_MSG_AAD_DOMAIN = b"fh-msg-v1"
_E2EE_MSG_NONCE_BYTES = 24  # XChaCha20 nonce
_E2EE_MSG_ID_BYTES = 16  # 128-bit client message id, hex on the wire
_E2EE_HEX32_RE = None  # compiled lazily (re is imported at module top)

_E2EE_MISSING_KEY_BODY = (
    "[cannot decrypt \u2014 key not available (see `hub key-request`)]"
)
_E2EE_ENCRYPTED_SUBJECT = "[encrypted]"


def _e2ee_hex32_re():
    global _E2EE_HEX32_RE
    if _E2EE_HEX32_RE is None:
        _E2EE_HEX32_RE = re.compile(r"[0-9a-f]{32}\Z")
    return _E2EE_HEX32_RE


def _e2ee_msg_aad(topic_id, key_id_hex, msg_id_hex):
    """Build the canonical AAD byte string for one E2EE message field.

    Exact construction: b"fh-msg-v1" + b"\\x00" + topic_id.encode("utf-8")
    + b"\\x00" + key_id_hex.encode("ascii") + b"\\x00" +
    msg_id_hex.encode("ascii"). Raises HubError if any field contains NUL
    (would break the unambiguous separator scheme) or is not valid hex
    where hex is required.
    """
    hex_re = _e2ee_hex32_re()
    if not hex_re.match(key_id_hex or ""):
        raise HubError("error", "E2EE: key_id is not 32 lowercase hex chars.")
    if not hex_re.match(msg_id_hex or ""):
        raise HubError("error", "E2EE: msg_id is not 32 lowercase hex chars.")
    topic_id = str(topic_id)
    for name, val in (("topic_id", topic_id), ("key_id", key_id_hex),
                      ("msg_id", msg_id_hex)):
        if "\x00" in val:
            raise HubError("error", "E2EE: %s contains NUL; cannot build AAD." % name)
    return (_E2EE_MSG_AAD_DOMAIN + b"\x00" + topic_id.encode("utf-8") + b"\x00"
            + key_id_hex.encode("ascii") + b"\x00" + msg_id_hex.encode("ascii"))


def _e2ee_encrypt_field(plaintext_bytes, topic_id, key_id_hex, topic_key):
    """Encrypt one field (body or data); return the fh1 wire string.

    Fresh random 24-byte nonce AND fresh random 128-bit msg_id per call.
    """
    nacl = _require_nacl()
    msg_id_hex = os.urandom(_E2EE_MSG_ID_BYTES).hex()
    nonce = os.urandom(_E2EE_MSG_NONCE_BYTES)
    aad = _e2ee_msg_aad(topic_id, key_id_hex, msg_id_hex)
    ct = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_encrypt(
        plaintext_bytes, aad, nonce, topic_key)
    blob = base64.b64encode(nonce + ct).decode("ascii")
    return "%s.%s.%s.%s" % (_E2EE_MSG_TAG, key_id_hex, msg_id_hex, blob)


def _e2ee_parse_wire(wire, entry_ref="entry"):
    """Parse an fh1 wire string -> (key_id_hex, msg_id_hex, nonce, ct).

    Returns None when `wire` is not an E2EE wire string at all (no "fh1."
    tag) — the caller passes such bodies through untouched. Raises a loud
    HubError naming the entry when the tag is present but the wire is
    malformed: on an E2EE topic that is tamper/corruption evidence, never
    something to guess at.
    """
    if not isinstance(wire, str) or not wire.startswith(_E2EE_MSG_TAG + "."):
        return None
    parts = wire.split(".", 3)
    hex_re = _e2ee_hex32_re()

    def malformed(why):
        return HubError(
            "error",
            "E2EE integrity failure on %s: entry body is not a valid fh1 "
            "wire string (%s). Possible tampering or corruption; refusing "
            "to guess. Raw body withheld." % (entry_ref, why),
        )

    if len(parts) != 4:
        raise malformed("expected 4 dot-separated parts")
    _, key_id_hex, msg_id_hex, blob = parts
    if not hex_re.match(key_id_hex):
        raise malformed("key_id is not 32 lowercase hex chars")
    if not hex_re.match(msg_id_hex):
        raise malformed("msg_id is not 32 lowercase hex chars")
    try:
        raw = base64.b64decode(blob, validate=True)
    except ValueError as exc:
        raise malformed("payload is not valid base64 (%s)" % exc)
    if len(raw) < _E2EE_MSG_NONCE_BYTES + 16:  # nonce + Poly1305 tag
        raise malformed("payload too short for nonce + auth tag")
    return key_id_hex, msg_id_hex, raw[:_E2EE_MSG_NONCE_BYTES], raw[_E2EE_MSG_NONCE_BYTES:]


def _e2ee_decrypt_subject(subject_b64, topic_key, topic_id):
    """Decrypt a subject blob: base64(nonce[24] || ct).

    AAD is the topic-bound b"fh-topic-subject-v1\\x00" + topic_id (secfix
    F4). Raises HubError on failure — including when the blob was encrypted
    for a different topic (cross-topic subject swap).
    """
    nacl = _require_nacl()
    try:
        raw = base64.b64decode(subject_b64, validate=True)
    except ValueError as exc:
        raise HubError("error", "E2EE subject is not valid base64 (%s)." % exc)
    if len(raw) < _E2EE_SUBJECT_NONCE_BYTES + 16:
        raise HubError("error", "E2EE subject blob too short.")
    nonce, ct = raw[:_E2EE_SUBJECT_NONCE_BYTES], raw[_E2EE_SUBJECT_NONCE_BYTES:]
    try:
        pt = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_decrypt(
            ct, _e2ee_subject_aad(topic_id), nonce, topic_key)
    except Exception as exc:
        raise HubError("error", "E2EE subject failed authentication (%s)." % exc)
    return pt.decode("utf-8")


def _load_topic_keys(profile, topic_id):
    """Load the local keystore: {key_id_hex: key_bytes}; {} when absent.

    Every loaded key is registered with note_secret() (base64 + hex) so it
    can never reach stdout/stderr through the redaction layer.
    """
    path = os.path.join(topic_keys_dir(profile), str(topic_id) + ".json")
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (ValueError, OSError) as exc:
        raise HubError(
            "error",
            "Cannot read the E2EE keystore for topic %s (%s): %s."
            % (topic_id, path, exc),
        )
    if not isinstance(data, dict):
        raise HubError(
            "error",
            "E2EE keystore for topic %s is corrupt (expected a JSON object)."
            % topic_id,
        )
    keys = {}
    for kid, b64 in data.items():
        try:
            key = base64.b64decode(b64, validate=True)
        except (ValueError, TypeError) as exc:
            raise HubError(
                "error",
                "E2EE keystore for topic %s has a bad key for key_id %s: %s."
                % (topic_id, kid, exc),
            )
        if len(key) != _E2EE_TOPIC_KEY_BYTES:
            raise HubError(
                "error",
                "E2EE keystore for topic %s has a %d-byte key for key_id %s; "
                "expected %d." % (topic_id, len(key), kid, _E2EE_TOPIC_KEY_BYTES),
            )
        keys[str(kid)] = key
        _note_topic_key_secrets(key)
    return keys


def _e2ee_current_key(profile, topic_id, ctx):
    """Select the key to encrypt new messages under: (key_id_hex, key_bytes).

    Single-key keystore (the Phase 3 norm): returned directly, no extra
    round trip. Multi-key keystore (post-rotation): the server-advertised
    topics.current_key_id is the source of truth for "current", read from
    the topic record — NEVER envelope recency (secfix F1: created_at is
    forgeable via re-POST, so electing by it lets an attacker downgrade a
    victim to a removed member's key or hijack encryption to an attacker
    key).
    """
    topic_id = str(topic_id)
    keys = _load_topic_keys(profile, topic_id)
    keystore_path = os.path.join(topic_keys_dir(profile), topic_id + ".json")
    if not keys:
        raise HubError(
            "error",
            "Cannot post to E2EE topic %s: no topic key in the local "
            "keystore (%s). Nothing was posted and nothing was sent. Fetch "
            "your key envelope first (see `hub key-request`) or ask a topic "
            "participant to share one, then retry." % (topic_id, keystore_path),
        )
    if len(keys) == 1:
        key_id_hex = next(iter(keys))
        return key_id_hex, keys[key_id_hex]
    topic = _fetch_topic_record(ctx.client, topic_id)
    current = topic.get("current_key_id")
    if isinstance(current, str) and current in keys:
        return current, keys[current]
    raise HubError(
        "error",
        "Cannot post to E2EE topic %s: the server-advertised current key "
        "(…%s) is not in the local keystore (%s). Fetch your key envelope "
        "first (`hub key-fetch --topic %s`, or `hub sync`), then retry; "
        "nothing was posted."
        % (topic_id, str(current)[-8:], keystore_path, topic_id),
    )


def _fetch_topic_record(client, topic_id):
    """GET /v1/topics/:id -> the topic dict; HubError when missing/malformed."""
    resp = client.call(
        "GET", "/v1/topics/%s" % urlparse.quote(str(topic_id), safe=""))
    topic = resp.get("topic") if isinstance(resp, dict) else None
    if not isinstance(topic, dict):
        raise HubError(
            "error",
            "Unexpected response fetching topic %s." % topic_id,
        )
    return topic


def _decrypt_entry_in_place(entry, keys):
    """Decrypt one E2EE-topic entry's body/data in place (dict mutated).

    `keys` is the local keystore {key_id_hex: key_bytes} for the entry's
    topic (may be empty). Implements the Phase 3 read policy: wire bodies
    are decrypted (missing key -> placeholder; tamper -> loud HubError);
    non-wire bodies pass through untouched.
    """
    topic_id = str(entry.get("topic_id"))
    entry_ref = "topic %s entry seq=%s" % (topic_id, entry.get("seq"))

    def decrypt_field(wire):
        """(plaintext_str_or_None, key_was_missing)."""
        parsed = _e2ee_parse_wire(wire, entry_ref)
        if parsed is None:
            return None, False  # not E2EE wire: pass through
        key_id_hex, msg_id_hex, nonce, ct = parsed
        key = keys.get(key_id_hex)
        if key is None:
            return None, True
        nacl = _require_nacl()
        aad = _e2ee_msg_aad(topic_id, key_id_hex, msg_id_hex)
        try:
            pt = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_decrypt(
                ct, aad, nonce, key)
        except Exception as exc:
            raise HubError(
                "error",
                "E2EE integrity failure on %s: message authentication "
                "failed (%s). The stored ciphertext does not match its "
                "topic/key/message binding \u2014 possible tampering, "
                "corruption, or key mismatch. Entry NOT shown; nothing was "
                "silently dropped." % (entry_ref, exc),
            )
        return pt.decode("utf-8"), False

    body = entry.get("body")
    if isinstance(body, str) and body.startswith(_E2EE_MSG_TAG + "."):
        plaintext, missing = decrypt_field(body)
        if missing:
            # Key not available: placeholder, never the raw ciphertext.
            entry["body"] = _E2EE_MISSING_KEY_BODY
            entry["data"] = None
            return
        entry["body"] = plaintext
    data = entry.get("data")
    if isinstance(data, str) and data.startswith(_E2EE_MSG_TAG + "."):
        plaintext, missing = decrypt_field(data)
        if missing:
            entry["data"] = None
        else:
            try:
                entry["data"] = json.loads(plaintext)
            except ValueError as exc:
                raise HubError(
                    "error",
                    "E2EE integrity failure on %s: decrypted data is not "
                    "valid JSON (%s)." % (entry_ref, exc),
                )


def _decrypt_topic_subjects(profile, topics):
    """Decrypt E2EE topic subjects in place for display (hub topics).

    Plaintext topics are untouched. For E2EE topics the subject is the
    blob base64(nonce || XChaCha20(subject, aad=b"fh-topic-subject-v1\\x00"
    + topic_id)) — the AAD binds the topic id (secfix F4). Any locally
    held key is tried (subjects stay under their original key across
    rotations); when no key decrypts it, the subject shows as
    "[encrypted]" — a failed decrypt is indistinguishable from a missing
    key, so both map to the placeholder rather than a loud error.
    """
    keystores = {}  # topic_id -> {key_id_hex: key_bytes}
    for topic in topics:
        if not isinstance(topic, dict):
            continue
        if topic.get("e2ee") != 1:
            continue
        topic_id = str(topic.get("id") or "")
        if topic_id not in keystores:
            keystores[topic_id] = _load_topic_keys(profile, topic_id)
        subject = topic.get("subject")
        plaintext = None
        if isinstance(subject, str):
            for key in keystores[topic_id].values():
                try:
                    plaintext = _e2ee_decrypt_subject(subject, key, topic_id)
                except HubError:
                    continue
                break
        topic["subject"] = plaintext if plaintext is not None else _E2EE_ENCRYPTED_SUBJECT


def _cmd_post_e2ee(args, ctx, topic, message, data):
    """Post to an E2EE topic: local PII pre-scan, then encrypt (body, data).

    Precondition: cmd_post already ran check_pii(message) and parsed --data.
    The server cannot scan ciphertext, so the CLI's local check_pii is the
    enforcement point here — it runs on the PLAINTEXT (message and the
    canonical data JSON) before encrypting. Never posts plaintext to an
    E2EE topic; fails loudly (nothing sent) when the local keystore has no
    key for the topic.
    """
    topic_id = str(topic.get("id") or args.topic)
    data_json = None
    if data is not None:
        data_json = json.dumps(data, sort_keys=True, separators=(",", ":"))
        check_pii(data_json)
    key_id_hex, topic_key = _e2ee_current_key(ctx.profile, topic_id, ctx)
    enc_body = _e2ee_encrypt_field(
        message.encode("utf-8"), topic_id, key_id_hex, topic_key)
    payload = {"kind": args.kind, "body": enc_body}
    if args.reply_to is not None:
        payload["reply_to_seq"] = args.reply_to
    if data is not None:
        payload["data"] = _e2ee_encrypt_field(
            data_json.encode("utf-8"), topic_id, key_id_hex, topic_key)
    key = args.idempotency_key or uuid.uuid4().hex
    entry = ctx.client.call(
        "POST",
        "/v1/topics/%s/entries" % urlparse.quote(args.topic, safe=""),
        json_body=payload,
        idempotency_key=key,
    )
    emit_json({"idempotency_key": key, "entry": entry})
    return 0


# ---------------------------------------------------------------------------
# E2EE membership changes + re-keying — Phase 4
#
# Commands:
#   hub topic-add-member --topic <id> --member <id>[,<id>...]
#       Envelope step of adding a member (the server step is `hub invite`).
#       Seals the CURRENT topic key — never old keys — for each of the new
#       member's registered agents. A member with no registered keys gets a
#       visible `pending_key_distribution` notice, never silence.
#   hub topic-remove-member --topic <id> --member <id>
#       Owner/parent-only participant removal. Does NOT re-key: run
#       `hub topic-rekey` immediately after on E2EE topics.
#   hub topic-rekey --topic <id>
#       Generate a new topic key, seal fresh envelopes for all REMAINING
#       participant agents, merge the new key into the local keystore (old
#       keys are retained for history), and post a PLAINTEXT `key_rotated`
#       announcement readable by everyone.
#   hub key-request --topic <id> [--note ...]
#       Post a visible request for the current topic key. There is NO
#       automatic fulfillment.
#   hub key-grant --topic <id> --member <id> [--yes]
#       Seal the current key for a member's agents. Requires explicit human
#       approval (interactive prompt unless --yes).
#   hub key-fetch --topic <id>
#       Fetch our own envelopes and merge unknown keys into the keystore.
#       Also runs opportunistically inside `hub sync` for E2EE topics.
#   hub topic-key-status --topic <id>
#       Show per-participant key-distribution state (pending / ready / ok).
#
# Security posture, repeated because it matters:
# - The topic key never leaves the machine except inside sealed envelopes,
#   and is never printed or logged.
# - Envelopes are created only (a) by the agent performing the add/re-key,
#   or (b) via an explicit, human-approved `hub key-grant`. No daemon, no
#   auto-fulfillment, ever.
# - After a removal, the removed member's old envelopes stay on the server
#   (they already held the old key; old history stays readable to them by
#   design) but the server refuses NEW envelopes for non-participants —
#   so the re-key is what actually locks them out of new content.
# ---------------------------------------------------------------------------

_E2EE_SYSTEM_KINDS = ("key_rotated", "key_request", "pending_key_distribution",
                      "topic_archived")


def _merge_topic_key(profile, topic_id, key_id_hex, topic_key):
    """Merge one key_id -> key into the keystore, keeping old keys.

    Unlike _store_topic_key (single-key overwrite, used at topic creation),
    this preserves every previously stored key so history encrypted under
    older keys stays decryptable after a rotation. The file stays 0600; a
    corrupt existing keystore fails loudly instead of being clobbered.
    """
    existing = _load_topic_keys(profile, topic_id)  # {} when absent; raises when corrupt
    data = {kid: base64.b64encode(key).decode("ascii") for kid, key in existing.items()}
    data[str(key_id_hex)] = base64.b64encode(topic_key).decode("ascii")
    _note_topic_key_secrets(topic_key)
    path = os.path.join(topic_keys_dir(profile), str(topic_id) + ".json")
    _write_secret_file_0600(
        path, json.dumps(data, indent=2, sort_keys=True).encode("utf-8"), "topic key"
    )
    return path


def _post_system_entry(ctx, topic, kind, body, data=None):
    """Post a PLAINTEXT system entry (never encrypted, even on E2EE topics).

    key_rotated / key_request / pending_key_distribution must be readable by
    every participant — including agents that do not (yet) hold the topic
    key — so they bypass the E2EE encrypting path. The server only accepts
    these kinds from current participants. A loud stderr note marks the
    plaintext posting; silence here would be a security bug.
    """
    topic_id = str(topic.get("id"))
    if topic.get("e2ee") == 1:
        emit_err(
            "note: posting PLAINTEXT system entry (kind=%s) to E2EE topic %s — "
            "readable by every participant, never encrypted." % (kind, topic_id)
        )
    payload = {"kind": kind, "body": body}
    if data is not None:
        payload["data"] = data
    key = uuid.uuid4().hex
    return ctx.client.call(
        "POST",
        "/v1/topics/%s/entries" % urlparse.quote(topic_id, safe=""),
        json_body=payload,
        idempotency_key=key,
    )


def _e2ee_require_topic(ctx, topic_id):
    """Fetch the topic record and require e2ee=1; HubError otherwise."""
    topic = _fetch_topic_record(ctx.client, topic_id)
    if topic.get("e2ee") != 1:
        raise HubError(
            "bad_request",
            "Topic %s is not end-to-end encrypted; this command is only "
            "meaningful for E2EE topics." % topic_id,
        )
    return topic


def _topic_participants(ctx, topic_id):
    """Authoritative participant map {member_id: participant record}."""
    detail = ctx.client.call(
        "GET", "/v1/topics/%s" % urlparse.quote(str(topic_id), safe="")
    )
    parts = {}
    for p in _as_list(detail, "participants"):
        if isinstance(p, dict) and p.get("member_id"):
            parts[p["member_id"]] = p
    return parts


def _e2ee_distribute_key(ctx, topic_id, key_id_hex, key_id_bytes, topic_key, member_ids):
    """Seal (topic_id || 0x00 || key_id || topic_key) for each member's agents.

    Returns (posted, keyless_members, failures): posted counts envelopes;
    keyless_members had no registered agent keys (caller decides policy);
    failures are per-agent POST errors — the caller must fail loudly on
    these and must NOT treat the distribution as complete.
    """
    posted = 0
    keyless = []
    failures = []
    quoted_tid = urlparse.quote(str(topic_id), safe="")
    for mid in sorted(set(member_ids)):
        directory = ctx.client.call("GET", "/v1/agent-keys", query={"member_id": mid})
        agents = [
            e for e in _as_list(directory, "keys")
            if isinstance(e, dict) and e.get("agent_label") and e.get("public_key")
        ]
        if not agents:
            keyless.append(mid)
            continue
        for entry in agents:
            label = entry["agent_label"]
            envelope = _e2ee_seal_envelope(topic_id, key_id_bytes, topic_key, entry["public_key"])
            try:
                ctx.client.call(
                    "POST",
                    "/v1/topics/%s/envelopes" % quoted_tid,
                    json_body={
                        "member_id": mid,
                        "agent_label": label,
                        "key_id": key_id_hex,
                        "envelope": envelope,
                    },
                )
                posted += 1
            except HubError as exc:
                failures.append("%s/%s: %s" % (mid, label, exc))
    return posted, keyless, failures


def _e2ee_refresh_own_keys(client, profile, topic_id, quiet=True):
    """Fetch our own envelopes; open + merge any key_ids missing locally.

    Returns the newly stored key_id_hex values. With quiet=True (sync-time
    opportunistic refresh) a missing identity key, a failed fetch, or an
    unopenable envelope is skipped silently — `hub key-fetch` is the loud,
    explicit path (quiet=False re-raises). An envelope whose sealed key_id
    does not match its advertised key_id, or whose bound topic_id does not
    match this topic (cross-topic transplant), is NEVER stored.
    """
    _require_nacl()
    topic_id = str(topic_id)
    try:
        priv = _load_identity_key(agent_key_path(profile))
    except HubError:
        if not quiet:
            raise
        return []
    try:
        resp = client.call(
            "GET", "/v1/topics/%s/envelopes" % urlparse.quote(topic_id, safe="")
        )
    except HubError:
        if not quiet:
            raise
        return []
    known = set(_load_topic_keys(profile, topic_id))
    fresh = []
    for env in _as_list(resp, "envelopes"):
        if not isinstance(env, dict):
            continue
        kid = env.get("key_id")
        if not kid or not isinstance(kid, str) or kid in known:
            continue
        try:
            kid_bytes, key = _e2ee_open_envelope(env.get("envelope") or "", priv, topic_id)
        except HubError:
            if not quiet:
                raise
            # Sealed to a different (e.g. superseded) identity key,
            # transplanted from another topic, or malformed: never store.
            continue
        if kid_bytes.hex() != kid or len(key) != _E2EE_TOPIC_KEY_BYTES:
            continue  # key_id binding mismatch: never store a mislabeled key
        _merge_topic_key(profile, topic_id, kid, key)
        known.add(kid)
        fresh.append(kid)
    return fresh


def _e2ee_refresh_after_sync(client, profile, e2ee_flags):
    """Opportunistic envelope refresh for E2EE topics seen in a sync batch.

    e2ee_flags is {topic_id: is_e2ee} as returned by
    _decrypt_entries_for_display. Failures are warnings, never fatal: sync
    must not die because a refresh hiccupped.
    """
    for topic_id, is_e2ee in (e2ee_flags or {}).items():
        if not is_e2ee:
            continue
        try:
            fresh = _e2ee_refresh_own_keys(client, profile, topic_id)
        except HubError as exc:
            emit_err(
                "warning: key-envelope refresh for topic %s failed: %s"
                % (topic_id, exc.friendly())
            )
            continue
        for kid in fresh:
            emit_err(
                "topic %s: fetched a new key envelope (key …%s); `hub post` "
                "will now use the new key." % (topic_id, kid[-8:])
            )


def _pending_distribution_notice(ctx, topic, key_id_hex, member_id, name, rotated):
    """Post the visible pending-key-distribution notice; never silent."""
    if rotated:
        body = (
            "[pending key distribution] %s (%s) has no registered agent keys, "
            "so no envelope for the ROTATED topic key (…%s) could be sealed. They "
            "cannot read messages posted after the rotation. Ask them to run "
            "`hub key-init`, then ask a member to run `hub topic-add-member "
            "--topic %s --member %s`."
            % (name, member_id, key_id_hex[-8:], topic.get("id"), member_id)
        )
    else:
        body = (
            "[pending key distribution] %s (%s) joined this E2EE topic but has no "
            "registered agent keys yet, so no key envelope could be sealed. They see "
            "the topic exists but cannot read content. Ask them to run "
            "`hub key-init`, then re-run `hub topic-add-member --topic %s --member %s`."
            % (name, member_id, topic.get("id"), member_id)
        )
    _post_system_entry(
        ctx, topic, "pending_key_distribution", body,
        {"member_id": member_id, "key_id": key_id_hex},
    )
    emit_err(
        "warning: %s (%s) has no registered agent keys — posted a visible "
        "pending-key-distribution notice; no envelope sealed." % (name, member_id)
    )


def cmd_topic_add_member(args, transport):
    """Envelope step of adding a member to an E2EE topic.

    The server step (`hub invite`) must already have made them a
    participant — the two steps are deliberately separate, and this command
    refuses to auto-invite. Seals the CURRENT topic key (never old keys) for
    each of the new member's registered agents.
    """
    ctx = _ctx(args, transport)
    _require_nacl()
    topic = _e2ee_require_topic(ctx, args.topic)
    key_id_hex, topic_key = _e2ee_current_key(ctx.profile, args.topic, ctx)
    key_id_bytes = bytes.fromhex(key_id_hex)
    participants = _topic_participants(ctx, args.topic)
    member_ids = _id_list(args.member)
    if not member_ids:
        raise HubError("bad_request", "At least one --member ID is required.")
    missing = [m for m in member_ids if m not in participants]
    if missing:
        raise HubError(
            "bad_request",
            "Not topic participants — run `hub invite --topic %s --member %s` first. "
            "Adding (server step) and key distribution (this step) are deliberately "
            "separate; this command never auto-invites." % (args.topic, ",".join(missing)),
        )
    posted, keyless, failures = _e2ee_distribute_key(
        ctx, args.topic, key_id_hex, key_id_bytes, topic_key, member_ids
    )
    if failures:
        raise HubError(
            "error",
            "Key distribution failed for %d agent(s): %s. No key was stored and "
            "the distribution is incomplete; fix the cause and re-run."
            % (len(failures), "; ".join(failures)),
        )
    pending = []
    for mid in keyless:
        name = participants[mid].get("name") or mid
        _pending_distribution_notice(ctx, topic, key_id_hex, mid, name, rotated=False)
        pending.append(mid)
    emit_json(
        {
            "topic_id": str(args.topic),
            "key_id": key_id_hex,
            "members": member_ids,
            "envelopes_posted": posted,
            "pending_key_distribution": pending,
        }
    )
    return 0


def cmd_topic_remove_member(args, transport):
    """Remove a participant (owner/parent only). For E2EE topics this does
    NOT re-key — run `hub topic-rekey` immediately after, or the removed
    member's devices can still read new messages with the old key."""
    ctx = _ctx(args, transport)
    topic = _fetch_topic_record(ctx.client, args.topic)
    resp = ctx.client.call(
        "DELETE",
        "/v1/topics/%s/participants/%s"
        % (
            urlparse.quote(str(args.topic), safe=""),
            urlparse.quote(args.member, safe=""),
        ),
    )
    emit_json(resp or {"ok": True})
    if topic.get("e2ee") == 1:
        emit_err(
            "E2EE topic: the removed member's devices still hold the OLD topic key. "
            "Run `hub topic-rekey --topic %s` NOW to rotate it — until you do, they "
            "can read newly posted messages." % args.topic
        )
    return 0


def cmd_topic_rekey(args, transport):
    """Rotate an E2EE topic's key after a membership change.

    1. Requires the CURRENT key locally (you cannot rotate what you can't read).
    2. Generates a new 32-byte key + 128-bit key_id locally.
    3. Seals fresh envelopes for every REMAINING participant agent (the
       server rejects envelopes for non-participants, so a removed member
       cannot receive the new key through this path).
    4. Round-trip verifies our own envelope, then MERGES the new key into the
       local keystore — old keys are retained for history decryption.
    5. Posts a PLAINTEXT `key_rotated` announcement readable by everyone,
       including agents that haven't fetched the new key yet.
    Members with no registered keys get a visible pending notice instead of
    an envelope — never silent.

    Rotation is an owner/parent privilege (secfix F1): the server rejects a
    new key_id from anyone else with 403, and this command fails loudly
    BEFORE generating anything when the caller's role is not owner/parent.
    """
    ctx = _ctx(args, transport)
    _require_nacl()
    topic = _e2ee_require_topic(ctx, args.topic)
    me = ctx.client.call("GET", "/v1/me")
    me = me if isinstance(me, dict) else {}
    if me.get("role") not in ("owner", "parent"):
        raise HubError(
            "forbidden",
            "Only an owner or parent may rotate an E2EE topic's key "
            "(your role: %s). Ask an owner/parent to run `hub topic-rekey`. "
            "Nothing was generated and nothing was posted."
            % (me.get("role") or "unknown"),
        )
    old_key_id_hex, _old_key = _e2ee_current_key(ctx.profile, args.topic, ctx)
    priv = _load_identity_key(agent_key_path(ctx.profile))

    new_key = os.urandom(_E2EE_TOPIC_KEY_BYTES)
    _note_topic_key_secrets(new_key)
    new_key_id_bytes = os.urandom(_E2EE_KEY_ID_BYTES)
    new_key_id_hex = new_key_id_bytes.hex()

    participants = _topic_participants(ctx, args.topic)
    member_ids = sorted(participants)
    if not member_ids:
        raise HubError("error", "Server returned no participants for topic %s." % args.topic)
    posted, keyless, failures = _e2ee_distribute_key(
        ctx, args.topic, new_key_id_hex, new_key_id_bytes, new_key, member_ids
    )
    if failures:
        raise HubError(
            "error",
            "Rotation ABORTED: %d envelope(s) failed to post (%s). The new key was "
            "NOT stored locally and no rotation was announced; the old key is still "
            "current. Fix the cause and re-run." % (len(failures), "; ".join(failures)),
        )

    # Round-trip check BEFORE storing locally (same posture as topic creation):
    # our own envelope must open to exactly the new key.
    own = ctx.client.call(
        "GET", "/v1/topics/%s/envelopes" % urlparse.quote(str(args.topic), safe="")
    )
    mine = [
        e
        for e in _as_list(own, "envelopes")
        if isinstance(e, dict) and e.get("key_id") == new_key_id_hex
    ]
    if not mine:
        raise HubError(
            "error",
            "Round-trip check failed: our own envelope for the new key is missing "
            "server-side. The new key was NOT stored.",
        )
    opened_kid, opened_key = _e2ee_open_envelope(
        mine[0].get("envelope") or "", priv, str(args.topic))
    if opened_kid != new_key_id_bytes or opened_key != new_key:
        raise HubError(
            "error",
            "Round-trip check failed: our own envelope does not open to the new "
            "topic key. The new key was NOT stored.",
        )

    key_path = _merge_topic_key(ctx.profile, args.topic, new_key_id_hex, new_key)

    actor_name = me.get("name") or me.get("id") or "a member"
    actor_id = me.get("id") or ""
    body = (
        "[key rotation] %s rotated this topic's encryption key (now …%s). New messages "
        "are encrypted under the new key; older messages remain readable with the "
        "retained key. If you see ciphertext, run `hub sync` to fetch your new key envelope."
        % (actor_name, new_key_id_hex[-8:])
    )
    _post_system_entry(
        ctx,
        topic,
        "key_rotated",
        body,
        {
            "key_id": new_key_id_hex,
            "previous_key_id": old_key_id_hex,
            "rotated_by": actor_id,
        },
    )
    pending = []
    for mid in keyless:
        name = participants[mid].get("name") or mid
        _pending_distribution_notice(ctx, topic, new_key_id_hex, mid, name, rotated=True)
        pending.append(mid)
    emit_json(
        {
            "topic_id": str(args.topic),
            "previous_key_id": old_key_id_hex,
            "key_id": new_key_id_hex,
            "envelopes_posted": posted,
            "pending_key_distribution": pending,
            "topic_key_path": key_path,
        }
    )
    return 0


def _post_key_request(ctx, topic, note=None):
    """Build and post the visible key_request system entry; returns the entry.

    Shared by `hub key-request` and the recovery ladder (rung 2). There is
    NO automatic fulfillment: a member-agent holding the key may answer with
    `hub key-grant` — ONLY after its human explicitly approves.
    """
    me = ctx.client.call("GET", "/v1/me")
    me = me if isinstance(me, dict) else {}
    name = me.get("name") or me.get("id") or "unknown member"
    label = me.get("agent_label") or ""
    mid = me.get("id") or ""
    body = (
        "[key request] %s (agent %s) is asking for the current topic key for this "
        "E2EE topic. There is NO automatic fulfillment: a member-agent holding the "
        "key may run `hub key-grant --topic %s --member %s` — ONLY after its human "
        "explicitly approves." % (name, label, topic.get("id"), mid)
    )
    if note:
        check_pii(note)
        body += "\nNote from requester: %s" % note.strip()
    return _post_system_entry(
        ctx, topic, "key_request", body, {"member_id": mid, "agent_label": label}
    )


def cmd_key_request(args, transport):
    """Post a visible request for the current E2EE topic key.

    There is NO automatic fulfillment: a member-agent holding the key may
    answer with `hub key-grant` — ONLY after its human explicitly approves.
    """
    ctx = _ctx(args, transport)
    topic = _e2ee_require_topic(ctx, args.topic)
    entry = _post_key_request(ctx, topic, args.note)
    emit_json({"entry": entry})
    emit_err(
        "key request posted and visible to all participants. Nothing was granted "
        "automatically — a key holder must run `hub key-grant` after human approval."
    )
    return 0


def cmd_key_grant(args, transport):
    """Seal the CURRENT topic key for a member's agents — ONLY with explicit
    human approval. This command is the ONLY fulfillment path for a
    key-request: there is no daemon and no auto-grant, ever."""
    ctx = _ctx(args, transport)
    _require_nacl()
    topic = _e2ee_require_topic(ctx, args.topic)
    key_id_hex, topic_key = _e2ee_current_key(ctx.profile, args.topic, ctx)
    key_id_bytes = bytes.fromhex(key_id_hex)
    participants = _topic_participants(ctx, args.topic)
    if args.member not in participants:
        raise HubError(
            "bad_request",
            "%s is not a participant of topic %s; key envelopes can only go to "
            "current participants." % (args.member, args.topic),
        )
    directory = ctx.client.call("GET", "/v1/agent-keys", query={"member_id": args.member})
    agents = [
        e
        for e in _as_list(directory, "keys")
        if isinstance(e, dict) and e.get("agent_label") and e.get("public_key")
    ]
    if not agents:
        raise HubError(
            "bad_request",
            "%s has no registered agent keys — they must run `hub key-init` first. "
            "Nothing was granted." % args.member,
        )
    name = participants[args.member].get("name") or args.member
    if not args.yes:
        emit_err(
            "HUMAN APPROVAL REQUIRED: you are about to give %s (%s) the CURRENT topic "
            "key for E2EE topic %s (key …%s), sealed for %d agent(s): %s.\n"
            "They will be able to read messages encrypted under this key. Confirm "
            "with your human FIRST — only proceed on their explicit approval.\n"
            "Type 'yes' to grant, anything else aborts."
            % (
                name,
                args.member,
                args.topic,
                key_id_hex[-8:],
                len(agents),
                ", ".join(e["agent_label"] for e in agents),
            )
        )
        try:
            answer = input()
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("yes", "y"):
            emit_err("key grant cancelled: no envelope was created.")
            return 1
    posted, _keyless, failures = _e2ee_distribute_key(
        ctx, args.topic, key_id_hex, key_id_bytes, topic_key, [args.member]
    )
    if failures:
        raise HubError(
            "error",
            "Grant FAILED for %d agent(s): %s. The grant is incomplete; fix the "
            "cause and re-run." % (len(failures), "; ".join(failures)),
        )
    emit_json(
        {
            "topic_id": str(args.topic),
            "member_id": args.member,
            "key_id": key_id_hex,
            "envelopes_posted": posted,
        }
    )
    return 0


def cmd_key_fetch(args, transport):
    """Fetch our own key envelopes; merge unknown keys into the keystore.

    Loud and explicit (unlike the opportunistic refresh inside `hub sync`):
    a missing identity key or a failed fetch fails here with guidance.
    """
    ctx = _ctx(args, transport)
    fresh = _e2ee_refresh_own_keys(ctx.client, ctx.profile, args.topic, quiet=False)
    emit_json({"topic_id": str(args.topic), "new_keys": fresh})
    if fresh:
        emit_err("stored %d new key(s) in the local keystore." % len(fresh))
    else:
        emit_err("no new key envelopes.")
    return 0


def _pending_notice_state(hist_entries):
    """Latest pending_key_distribution notice per member_id from history."""
    notices = {}
    for e in hist_entries:
        if not isinstance(e, dict) or e.get("kind") != "pending_key_distribution":
            continue
        data = e.get("data")
        if isinstance(data, dict) and data.get("member_id"):
            notices[data["member_id"]] = e
    return notices


def cmd_topic_key_status(args, transport):
    """Show per-participant key-distribution state for an E2EE topic.

    key_state per participant: "pending" (notice posted, still no registered
    keys), "ready" (keys are now registered — re-run `hub topic-add-member`
    to finish distribution), "ok" (no pending notice). Envelope receipt by
    other agents is NOT observable server-side — only each member's own
    `hub key-fetch`/`hub sync` can confirm it.
    """
    ctx = _ctx(args, transport)
    topic = _e2ee_require_topic(ctx, args.topic)
    try:
        current_id, _key = _e2ee_current_key(ctx.profile, args.topic, ctx)
    except HubError:
        current_id = None
    participants = _topic_participants(ctx, args.topic)
    hist = ctx.client.call(
        "GET",
        "/v1/topics/%s/history" % urlparse.quote(str(args.topic), safe=""),
        query={"limit": 200},
    )
    notices = _pending_notice_state(_as_list(hist, "entries"))
    rows = []
    for mid in sorted(participants):
        p = participants[mid]
        directory = ctx.client.call("GET", "/v1/agent-keys", query={"member_id": mid})
        agents = [
            {"agent_label": e.get("agent_label")}
            for e in _as_list(directory, "keys")
            if isinstance(e, dict) and e.get("agent_label")
        ]
        notice = notices.get(mid)
        if notice is None:
            state = "ok"
        elif agents:
            state = "ready"
        else:
            state = "pending"
        rows.append(
            {
                "member_id": mid,
                "name": p.get("name"),
                "agents": agents,
                "key_state": state,
                "pending_since": notice.get("ts") if notice else None,
            }
        )
    emit_json(
        {
            "topic_id": str(args.topic),
            "e2ee": 1,
            "current_key_id": current_id,
            "participants": rows,
        }
    )
    return 0


# ---------------------------------------------------------------------------
# E2EE recovery ladder (Phase 5) — the abandonment antidote.
#
# `hub recover` walks the rungs in order and stops at the first that works:
#   rung 1 — local backup: restore the identity key from a key-backup file
#            (conventional locations, --backup-file, or prompted path) or the
#            24-word recovery phrase. A restored identity key re-opens the
#            agent's envelopes, which is usually the whole fix.
#   rung 2 — re-registration + member-assisted re-envelopment: with the Bearer
#            token as bootstrap, register a fresh keypair (hub key-init guts)
#            and post a visible key-request for a member-agent to grant after
#            explicit human approval. --wait polls for the grant; without it
#            the command exits 2 ("request posted, waiting for grant").
#   rung 3 — provisioning code: no usable Bearer token at all. Nothing can
#            run automatically; exact out-of-band instructions are printed for
#            the human to relay.
# Every rung is narrated: what was tried, what failed, what comes next.
# Rungs are never silently skipped.
# ---------------------------------------------------------------------------

# Exit status when recovery is correctly parked waiting on a human grant.
_RECOVER_EXIT_WAITING = 2


def _prompt(text):
    """input() wrapper so tests can drive interactive prompts."""
    try:
        return input(text)
    except EOFError:
        return ""


def _recover_backup_search_paths(profile):
    """Conventional locations for an identity-key backup file (rung 1)."""
    pdir = profile_dir(profile)
    home = os.path.expanduser("~")
    return [
        os.path.join(pdir, "identity-key-backup.json"),
        os.path.join(home, "family-hub-identity-key-backup.json"),
        os.path.join(home, ".config", "family-hub", "identity-key-backup.json"),
    ]


def _looks_like_key_backup(path):
    """True when path parses as a hub identity-key backup blob. Read-only."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            blob = json.load(fh)
    except (OSError, ValueError):
        return False
    return isinstance(blob, dict) and blob.get("kdf") == _BACKUP_KDF


def _recover_rung1_backup(profile, key_path, backup_file_arg, phrase_file_arg):
    """Rung 1 — restore the identity key from a local backup.

    Tries, in order: --backup-file, conventional locations, a prompted path,
    then the 24-word recovery phrase (--phrase-file or prompted). Returns
    True when the identity key is now present and valid. Every attempt is
    narrated; a wrong password or bad file fails this rung loudly, never
    silently.
    """
    emit_err("[rung 1/3] local backup — restoring the identity key from backup…")
    candidates = []
    if (backup_file_arg or "").strip():
        candidates.append(os.path.expanduser(backup_file_arg.strip()))
    else:
        for path in _recover_backup_search_paths(profile):
            if os.path.isfile(path):
                if _looks_like_key_backup(path):
                    emit_err(
                        "[rung 1/3] found a backup file at a conventional "
                        "location: %s" % path
                    )
                    candidates.append(path)
                else:
                    emit_err(
                        "[rung 1/3] %s exists but is not a hub key-backup "
                        "file — skipping it." % path
                    )
        if not candidates:
            emit_err(
                "[rung 1/3] no backup file in the conventional locations "
                "(checked: %s)."
                % ", ".join(_recover_backup_search_paths(profile))
            )
            answer = _prompt("Path to a key-backup file (Enter to skip): ").strip()
            if answer:
                candidates.append(os.path.expanduser(answer))
    for path in candidates:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                blob = json.load(fh)
        except (OSError, ValueError) as exc:
            emit_err("[rung 1/3] cannot read %s: %s" % (path, exc))
            continue
        password = getpass.getpass("Backup password for %s: " % path)
        note_secret(password)
        try:
            priv = _decrypt_key_backup(blob, password)
        except HubError as exc:
            emit_err(
                "[rung 1/3] the backup at %s did not decrypt (%s) — "
                "wrong password or a corrupt file." % (path, exc)
            )
            continue
        _note_key_secrets(priv)
        _write_secret_file_0600(key_path, priv, "identity private key")
        emit_err(
            "[rung 1/3] identity key restored from backup %s "
            "(mode 0600)." % path
        )
        return True
    # The recovery phrase is the other half of rung 1 (same thing
    # `hub key-restore` accepts).
    phrase = None
    if (phrase_file_arg or "").strip():
        try:
            with open(os.path.expanduser(phrase_file_arg.strip()), "r",
                      encoding="utf-8") as fh:
                phrase = fh.read()
        except OSError as exc:
            emit_err("[rung 1/3] cannot read phrase file: %s" % exc)
            return False
    else:
        answer = _prompt(
            "Restore from the 24-word recovery phrase instead? [y/N]: "
        ).strip().lower()
        if answer in ("y", "yes"):
            phrase = getpass.getpass("Recovery phrase (24 words): ")
    if phrase is None:
        return False
    note_secret(phrase)
    try:
        priv = _privkey_from_phrase(phrase)
    except HubError as exc:
        emit_err("[rung 1/3] the recovery phrase was rejected: %s" % exc)
        return False
    _note_key_secrets(priv)
    _write_secret_file_0600(key_path, priv, "identity private key")
    emit_err("[rung 1/3] identity key restored from the recovery phrase (mode 0600).")
    return True


def _recover_wait_for_grant(ctx, profile, topic_id, wait_interval, wait_timeout):
    """Poll our own envelopes until the granted key lands or time runs out.

    Uses the quiet refresh: envelopes sealed to the lost/superseded identity
    key can never open again and must not abort the wait — only a newly
    granted envelope matters here. A persistently unreachable server simply
    runs the clock out with clear re-run guidance.
    """
    emit_err(
        "waiting up to %ds for the grant (polling every %ds) — a human on "
        "the other side must approve it; this is not instant."
        % (wait_timeout, wait_interval)
    )
    deadline = time.time() + wait_timeout
    while True:
        time.sleep(wait_interval)
        fresh = _e2ee_refresh_own_keys(ctx.client, profile, topic_id, quiet=True)
        for kid in fresh:
            emit_err(
                "grant received: fetched a new key envelope (key …%s)."
                % kid[-8:]
            )
        if _load_topic_keys(profile, topic_id):
            emit_err("the topic key is now in the local keystore — recovered.")
            return True
        if time.time() >= deadline:
            emit_err(
                "timed out waiting for the grant. The key-request is still "
                "visible in the topic — ask a key holder to run `hub key-grant "
                "--topic %s`, then re-run `hub recover --topic %s --wait`."
                % (topic_id, topic_id)
            )
            return False


def _recover_pending_exit(topic_id):
    """Exit 2: the request is posted; a human grant is still pending."""
    err = HubError(
        "pending",
        "Key request posted and visible to all participants; waiting for a "
        "member-agent to grant it (explicit human approval required — never "
        "automatic). Re-run `hub recover --topic %s --wait` or "
        "`hub key-fetch --topic %s` after the grant lands." % (topic_id, topic_id),
    )
    err.exit_code = _RECOVER_EXIT_WAITING
    raise err


def _recover_rung3_instructions(cfg, profile, server, topic_id):
    """Rung 3 — no usable Bearer token: print the exact out-of-band steps."""
    member = cfg.get("member") or {}
    mid = member.get("id") or "<your member id — ask the hub owner>"
    label = cfg.get("agent_label") or "<this agent's label>"
    emit_err("[rung 3/3] provisioning code — out-of-band; a human must help.")
    emit_err("")
    emit_err(
        "This agent has no working Bearer token, so it cannot authenticate to "
        "the hub at all. Nothing below can run automatically — relay these "
        "steps to a human:"
    )
    emit_err("")
    emit_err(
        "1. Ask the hub owner to mint a fresh single-use provisioning code for "
        "this agent:"
    )
    emit_err("     member_id:   %s" % mid)
    emit_err("     agent_label: %s" % label)
    emit_err("   The owner mints it with an authenticated call:")
    emit_err("     POST %s/v1/provisioning-codes" % server.rstrip("/"))
    emit_err('     {"member_id": "%s", "agent_label": "%s"}' % (mid, label))
    emit_err(
        "   (Only the owner can mint for another member; any member can "
        "self-mint for their own agent.) The code is single-use and expires — "
        "have them send it to you OUT OF BAND, not through the hub."
    )
    emit_err("")
    emit_err(
        "2. Run `hub setup --server %s` and paste the code when prompted. "
        "Setup generates a FRESH identity keypair and prints a NEW 24-word "
        "recovery phrase — write it down this time." % server.rstrip("/")
    )
    emit_err("")
    if topic_id:
        emit_err(
            "3. Then climb back up the ladder: `hub recover --topic %s` "
            "(rung 2: re-register the new key, post a key-request, wait for a "
            "member-agent to grant it)." % topic_id
        )
    else:
        emit_err(
            "3. Then climb back up the ladder: `hub recover --topic <id>` "
            "for each E2EE topic (rung 2: re-register the new key, post a "
            "key-request, wait for a member-agent to grant it)."
        )


def _is_auth_failure(exc):
    """True when a HubError means the Bearer token is dead (401 mapping)."""
    return isinstance(exc, HubError) and (exc.code == "auth" or exc.exit_code == 3)


def cmd_recover(args, transport):
    """Walk the E2EE recovery ladder when this agent has no usable topic key.

    Rung 1 (local backup) → rung 2 (re-register + member-assisted
    re-envelopment) → rung 3 (provisioning code, out-of-band). Each rung is
    narrated: what was tried, what failed, what comes next. Rungs are never
    silently skipped.

    Exit status: 0 = recovered (or nothing to do); 2 = key-request posted,
    waiting on a human grant; 1/3 = blocked (see the message).
    """
    _require_nacl()
    profile = args.profile
    cfg = load_config(profile)
    circle_id = _active_circle_id(cfg)
    server = (
        args.server
        or os.environ.get("FAMILY_HUB_URL")
        or cfg.get("server_url")
        or ""
    )
    topic_id = str(args.topic) if args.topic else None
    scope = "topic %s" % topic_id if topic_id else "this agent's identity key"
    emit_err(
        "Recovery ladder for %s — rungs are tried in order; the first that "
        "works ends the run." % scope
    )
    key_path = agent_key_path(profile)
    has_token = _has_usable_token(cfg, profile, circle_id)
    if not has_token:
        emit_err(
            "no usable Bearer token found for this profile — rung 2 "
            "(re-registration) cannot authenticate."
        )

    try:
        _load_identity_key(key_path)
        identity_ok = True
        emit_err("identity key: present at %s." % key_path)
    except HubError:
        identity_ok = False
        emit_err(
            "identity key: missing or unusable at %s." % key_path
        )

    ctx = None
    if has_token:
        if not server:
            raise HubError(
                "bad_request", "No server configured. Use --server or run `hub setup`."
            )
        try:
            ctx = _ctx(args, transport)
        except HubError as exc:
            emit_err("cannot build an authenticated session: %s" % exc.friendly())
            has_token = False

    def authed_call(fn, what):
        """Run fn(); a dead token demotes us to rung 3 instead of crashing."""
        nonlocal has_token
        try:
            return fn()
        except HubError as exc:
            if _is_auth_failure(exc):
                has_token = False
                emit_err(
                    "%s: the stored Bearer token was rejected by the server "
                    "(expired or revoked)." % what
                )
                return None
            raise

    # Pre-check (not a rung): maybe a grant already landed server-side.
    topic = None
    if topic_id and has_token and ctx is not None:
        topic = authed_call(lambda: _e2ee_require_topic(ctx, topic_id), "topic lookup")
        if topic is not None and identity_ok:
            fresh = authed_call(
                lambda: _e2ee_refresh_own_keys(ctx.client, profile, topic_id, quiet=True),
                "envelope refresh",
            )
            if fresh:
                emit_err(
                    "pre-check: fetched %d key envelope(s) without climbing "
                    "the ladder." % len(fresh)
                )

    if topic_id and identity_ok and _load_topic_keys(profile, topic_id):
        n = len(_load_topic_keys(profile, topic_id))
        emit(
            "no recovery needed: this agent already holds %d topic key(s) "
            "for %s." % (n, topic_id)
        )
        emit_json(
            {"topic_id": topic_id, "recovered": False, "reason": "keys already present"}
        )
        return 0

    # -- Rung 1: local backup -------------------------------------------
    if not identity_ok:
        restored = _recover_rung1_backup(
            profile, key_path, args.backup_file, args.phrase_file
        )
        if restored:
            identity_ok = True
            if topic_id and has_token and ctx is not None:
                # The restored private key re-opens this agent's envelopes.
                authed_call(
                    lambda: _e2ee_refresh_own_keys(ctx.client, profile, topic_id, quiet=False),
                    "envelope refresh",
                )
                if has_token and _load_topic_keys(profile, topic_id):
                    n = len(_load_topic_keys(profile, topic_id))
                    emit(
                        "recovered at rung 1: the backup restored the identity "
                        "key and %d topic key(s) for %s were fetched from "
                        "existing envelopes." % (n, topic_id)
                    )
                    emit_json({"topic_id": topic_id, "recovered": True, "rung": 1})
                    return 0
                emit_err(
                    "[rung 1/3] the identity key is back, but no envelope for "
                    "topic %s could be opened with it. Next: rung 2." % topic_id
                )
        else:
            emit_err("[rung 1/3] FAILED — no usable backup. Next: rung 2.")
    else:
        emit_err("[rung 1/3] skipped: the identity key is present (nothing to restore).")

    # -- Rung 2: re-registration + member-assisted re-envelopment ---------
    # Runs whenever the Bearer token works: _key_init_register generates a
    # fresh keypair when the identity key is missing, and is a no-op when the
    # current key is already registered.
    if has_token and ctx is not None:
        if topic_id is None:
            emit_err("[rung 2/3] re-registration (identity-level; no topic given)…")
            ok = authed_call(lambda: _key_init_register(ctx), "key re-registration")
            if has_token and ok is not None:
                emit(
                    "identity key registered. Per-topic key requests still "
                    "need `hub recover --topic <id>`."
                )
                emit_json({"recovered": True, "rung": 2, "topic_id": None})
                return 0
        else:
            if topic is None:
                topic = authed_call(
                    lambda: _e2ee_require_topic(ctx, topic_id), "topic lookup"
                )
            if topic is not None:
                emit_err(
                    "[rung 2/3] re-registration + member-assisted re-envelopment…"
                )
                ok = authed_call(lambda: _key_init_register(ctx), "key re-registration")
                if has_token and ok is not None:
                    posted = authed_call(
                        lambda: _post_key_request(
                            ctx, topic,
                            note="recovery: posted by `hub recover` (rung 2)",
                        ),
                        "key-request post",
                    )
                    if has_token and posted is not None:
                        emit_err(
                            "key request posted and visible to all participants. "
                            "A member-agent holding the key must run `hub key-grant` "
                            "— ONLY after its human explicitly approves. This is "
                            "not instant."
                        )
                        if args.wait:
                            if _recover_wait_for_grant(
                                ctx, profile, topic_id,
                                args.wait_interval, args.wait_timeout,
                            ):
                                emit_json(
                                    {"topic_id": topic_id, "recovered": True, "rung": 2}
                                )
                                return 0
                        _recover_pending_exit(topic_id)
    elif not has_token:
        emit_err(
            "[rung 2/3] SKIPPED — no usable Bearer token, so this agent cannot "
            "re-register or post a key-request. Next: rung 3."
        )

    # -- Rung 3: provisioning code (out-of-band) --------------------------
    if not has_token:
        _recover_rung3_instructions(cfg, profile, server, topic_id)
        err = HubError(
            "auth",
            "Recovery is blocked at rung 3: this agent has no working Bearer "
            "token. The steps printed above must be carried out by a human "
            "out-of-band.",
        )
        err.exit_code = 3  # same convention as any other auth failure
        raise err
    # Token works but we still have nothing (e.g. topic lookup failed).
    raise HubError(
        "error",
        "Recovery failed: the ladder is exhausted and topic %s is still "
        "unreadable. Do NOT spin up a replacement topic — ask your human "
        "whether to archive it with `hub topic-archive`." % (topic_id or "<none>",),
    )


def cmd_topic_archive(args, transport):
    """Archive a dead topic with a plaintext pointer to its successor.

    Total-loss case only: every recovery rung is exhausted and the human has
    confirmed. Posts a PLAINTEXT `topic_archived` entry stating why the old
    topic is unreadable, who authorized the archive, and where discussion
    continues. The old topic is NEVER deleted — it stays readable as history
    for anyone who still holds keys.

    Requires explicit confirmation (prompt, or --yes to bypass): archiving
    is destructive to readability.
    """
    ctx = _ctx(args, transport)
    topic = _fetch_topic_record(ctx.client, args.topic)
    topic_id = str(topic.get("id") or args.topic)
    me = ctx.client.call("GET", "/v1/me")
    me = me if isinstance(me, dict) else {}
    mid = me.get("id") or ""
    name = me.get("name") or mid or "unknown member"
    role = me.get("role") or ""
    holds_key = bool(_load_topic_keys(ctx.profile, topic_id))
    if role not in ("owner", "parent") and not holds_key:
        raise HubError(
            "forbidden",
            "Only the topic owner/parent or a remaining key-holder may archive "
            "topic %s (your role is '%s' and you hold no topic key)."
            % (topic_id, role),
        )
    successor = (args.successor or "").strip()
    if successor:
        # The successor must exist before the old topic points at it.
        _fetch_topic_record(ctx.client, successor)
    reason = (args.reason or "").strip()
    if not reason:
        reason = _prompt(
            "Why is this topic unreadable? (goes into the public archive entry): "
        ).strip()
    if not reason:
        raise HubError(
            "bad_request",
            "A reason is required — the archive entry must say why the old "
            "topic is unreadable.",
        )
    check_pii(reason)
    if not args.yes:
        emit_err(
            "You are about to ARCHIVE topic %s.\n"
            "Its history stays readable for key-holders, but agents without "
            "the key will never read it again. Successor: %s.\n"
            "Type 'yes' to archive, anything else aborts."
            % (
                topic_id,
                successor
                or "(none — create the successor topic first if discussion continues)",
            )
        )
        answer = _prompt("")
        if answer.strip().lower() not in ("yes", "y"):
            emit_err("archive cancelled: nothing was posted.")
            return 1
    where = (
        "Discussion continues in topic %s." % successor
        if successor
        else "No successor topic was named — create one if discussion continues."
    )
    body = (
        "[topic archived] This topic is no longer readable by all members "
        "(%s). Archived by %s (%s). %s "
        "The old messages remain in history for anyone who still holds the "
        "topic key." % (reason, name, mid, where)
    )
    data = {
        "successor_topic_id": successor or None,
        "reason": reason,
        "archived_by": mid,
    }
    entry = _post_system_entry(ctx, topic, "topic_archived", body, data)
    emit_json({"topic_id": topic_id, "entry": entry})
    emit_err(
        "topic %s archived%s."
        % (topic_id, " → successor %s" % successor if successor else "")
    )
    return 0


def _e2ee_flags_for_entries(client, entries):
    """{topic_id: is_e2ee} with one topic-record fetch per distinct topic.

    Lets sync refresh key envelopes BEFORE decrypting, so a rotation that
    landed since the last sync is usable on first sight instead of showing
    placeholders until the next run.
    """
    flags = {}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        topic_id = entry.get("topic_id")
        if topic_id is None:
            continue
        topic_id = str(topic_id)
        if topic_id not in flags:
            flags[topic_id] = _fetch_topic_record(client, topic_id).get("e2ee") == 1
    return flags


def _decrypt_entries_for_display(client, profile, entries, e2ee_flags=None):
    """Decrypt E2EE entries in place; plaintext topics untouched.

    E2EE auto-detect is O(1) per topic: the topic record is fetched once per
    distinct topic_id in this batch and cached for the run — never per
    entry, never per crypto operation. Callers may pass a precomputed
    e2ee_flags dict (see _e2ee_flags_for_entries); missing topics are
    fetched on demand.
    """
    if e2ee_flags is None:
        e2ee_flags = {}
    keystores = {}  # topic_id -> {key_id_hex: key_bytes}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        topic_id = entry.get("topic_id")
        if topic_id is None:
            continue
        topic_id = str(topic_id)
        if topic_id not in e2ee_flags:
            e2ee_flags[topic_id] = (
                _fetch_topic_record(client, topic_id).get("e2ee") == 1
            )
        if not e2ee_flags[topic_id]:
            continue  # plaintext topic: byte-identical behavior
        if topic_id not in keystores:
            keystores[topic_id] = _load_topic_keys(profile, topic_id)
        _decrypt_entry_in_place(entry, keystores[topic_id])


def _load_identity_key(path):
    """Load and validate the 32-byte private key; HubError when unusable.

    Auto-detects the passphrase-wrapped form (FHWRAP1 magic header) and
    unwraps it, sourcing the passphrase from FAMILY_HUB_KEY_PASSPHRASE or
    an interactive getpass prompt (see `hub key-wrap`). Legacy unwrapped
    keys keep working but emit a loud deprecation warning on every use.
    """
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as exc:
        raise HubError(
            "config",
            "Cannot read the identity key at %s (%s). If this agent never "
            "had one, run `hub key-init`; if the file was lost, run "
            "`hub key-restore`." % (path, exc),
        )
    # Warn (don't fail) when the file is readable by others — same posture
    # as the token file check in load_token().
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
        if mode & 0o077:
            emit_err(
                "warning: identity key file %s is readable by others (mode %o); "
                "run: chmod 600 %s" % (path, mode, path)
            )
    except OSError:
        pass
    if data.startswith(_KEYWRAP_MAGIC):
        priv = _unwrap_identity_key(data)
        _note_key_secrets(priv)
        return priv
    emit_err(
        "warning: identity key at %s is stored UNWRAPPED on disk — anyone "
        "who can read this file can impersonate this agent's E2EE identity. "
        "Run `hub key-wrap` to encrypt it with a passphrase, then export "
        "FAMILY_HUB_KEY_PASSPHRASE=<passphrase> for non-interactive use "
        "(cron, agents). See agent-skill/INSTALL.md." % path
    )
    if len(data) != 32:
        raise HubError(
            "config",
            "Identity key at %s is %d bytes, expected 32 — it is corrupt. "
            "Restore from backup with `hub key-restore`." % (path, len(data)),
        )
    _note_key_secrets(data)
    return data


def _ensure_identity_keypair(profile):
    """Return (priv_bytes, public_b64, is_new), generating + storing when missing.

    Never overwrites an existing key: re-running enrollment for a profile
    reuses its identity. The write happens BEFORE any server call that
    would register the key, so a storage failure can never strand the agent.
    """
    _require_nacl()
    path = agent_key_path(profile)
    if os.path.exists(path):
        priv = _load_identity_key(path)
        return priv, _public_key_b64(priv), False
    priv = _generate_identity_keypair()
    _note_key_secrets(priv)
    _write_secret_file_0600(path, priv, "identity private key")
    # Prove the file round-trips before anyone depends on it.
    if _load_identity_key(path) != priv:
        raise HubError(
            "config",
            "Identity key write verification failed for %s — the file does "
            "not read back identically. Not proceeding." % path,
        )
    return priv, _public_key_b64(priv), True


def _recovery_phrase(priv_bytes):
    """24-word BIP-39 phrase encoding the 32-byte private key."""
    Mnemonic = _require_mnemonic()
    return Mnemonic("english").to_mnemonic(priv_bytes)


def _privkey_from_phrase(phrase):
    """Decode + checksum-verify a 24-word phrase back to 32 key bytes."""
    Mnemonic = _require_mnemonic()
    words = phrase.strip().split()
    if len(words) != 24:
        raise HubError(
            "bad_request",
            "Recovery phrase must be exactly 24 words (got %d)." % len(words),
        )
    try:
        entropy = Mnemonic("english").to_entropy(" ".join(words))
    except Exception:
        raise HubError(
            "bad_request",
            "Recovery phrase is invalid (checksum failed). Check the words "
            "against what was written down and try again.",
        )
    if len(entropy) != 32:
        raise HubError(
            "bad_request",
            "Recovery phrase decoded to %d bytes, expected 32." % len(entropy),
        )
    return entropy


def _print_recovery_phrase(priv_bytes):
    """Show the 24-word phrase ONCE, deliberately bypassing redaction.

    Mirrors cmd_dashboard_token: the warning precedes the secret, the secret
    is written raw so it stays usable, and note_secret() is registered
    afterwards so the phrase can never leak into later output.
    """
    phrase = _recovery_phrase(priv_bytes)
    emit(
        "Write these 24 words down NOW and keep them somewhere safe (a "
        "password manager, or paper in a drawer). Anyone holding them can "
        "recreate this agent's identity key and read its encrypted topics. "
        "hub shows them once and never stores them."
    )
    sys.stdout.write(phrase + "\n")
    note_secret(phrase)


# Argon2id parameters for key backups. MODERATE (~256 MiB, ~0.5-1 s) is the
# balance between brute-force resistance and small/old machines; the exact
# values are stored in the backup file so restore always re-derives with
# the same parameters.
_BACKUP_KDF = "argon2id"
# F5: Argon2 parameters arrive inside the backup file, so a tampered file
# could otherwise force a giant allocation (OOM). Clamp to libsodium's
# minimums at the floor and 1 GiB / 64 passes at the ceiling — far above
# the MODERATE parameters _encrypt_key_backup writes (3 passes, 256 MiB).
_BACKUP_KDF_OPSLIMIT_MAX = 64
_BACKUP_KDF_MEMLIMIT_MAX = 1 << 30


def _encrypt_key_backup(priv_bytes, password):
    """Encrypt the 32-byte private key with Argon2id(password) → JSON blob."""
    nacl = _require_nacl()
    pw = password.encode("utf-8")
    salt = nacl.utils.random(nacl.pwhash.argon2id.SALTBYTES)
    ops = nacl.pwhash.argon2id.OPSLIMIT_MODERATE
    mem = nacl.pwhash.argon2id.MEMLIMIT_MODERATE
    key = nacl.pwhash.argon2id.kdf(32, pw, salt, opslimit=ops, memlimit=mem)
    nonce = nacl.utils.random(nacl.bindings.crypto_aead_xchacha20poly1305_ietf_NPUBBYTES)
    ct = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_encrypt(priv_bytes, None, nonce, key)
    return {
        "kdf": _BACKUP_KDF,
        "opslimit": ops,
        "memlimit": mem,
        "salt": base64.b64encode(salt).decode("ascii"),
        "nonce": base64.b64encode(nonce).decode("ascii"),
        "ciphertext": base64.b64encode(ct).decode("ascii"),
    }


def _decrypt_key_backup(blob, password):
    """Reverse _encrypt_key_backup; HubError on wrong password / bad blob."""
    nacl = _require_nacl()
    if not isinstance(blob, dict) or blob.get("kdf") != _BACKUP_KDF:
        raise HubError("bad_request", "Not a hub identity-key backup file.")
    try:
        ops = int(blob["opslimit"])
        mem = int(blob["memlimit"])
        salt = base64.b64decode(blob["salt"])
        nonce = base64.b64decode(blob["nonce"])
        ct = base64.b64decode(blob["ciphertext"])
    except Exception:
        raise HubError("bad_request", "Backup file is malformed.")
    if len(salt) != nacl.pwhash.argon2id.SALTBYTES:
        raise HubError("bad_request", "Backup file is malformed (bad salt).")
    # F5: clamp the KDF parameters read from the file — unbounded values
    # would let a tampered backup force a huge allocation (OOM). Out of
    # bounds is a loud HubError, never a crash.
    ops_min = nacl.pwhash.argon2id.OPSLIMIT_MIN
    mem_min = nacl.pwhash.argon2id.MEMLIMIT_MIN
    if not (ops_min <= ops <= _BACKUP_KDF_OPSLIMIT_MAX):
        raise HubError(
            "bad_request",
            "Backup file is malformed (opslimit %d out of bounds [%d, %d]); "
            "refusing to derive a key from it."
            % (ops, ops_min, _BACKUP_KDF_OPSLIMIT_MAX),
        )
    if not (mem_min <= mem <= _BACKUP_KDF_MEMLIMIT_MAX):
        raise HubError(
            "bad_request",
            "Backup file is malformed (memlimit %d out of bounds [%d, %d]); "
            "refusing to derive a key from it."
            % (mem, mem_min, _BACKUP_KDF_MEMLIMIT_MAX),
        )
    try:
        key = nacl.pwhash.argon2id.kdf(
            32, password.encode("utf-8"), salt, opslimit=ops, memlimit=mem
        )
    except Exception as exc:
        # Allocation (or other libsodium) failure surfaces as a HubError,
        # never a crash.
        raise HubError("error", "Backup key derivation failed (%s)." % exc)
    try:
        priv = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_decrypt(ct, None, nonce, key)
    except Exception:
        raise HubError("auth", "Wrong password — the backup could not be decrypted.")
    if len(priv) != 32:
        raise HubError("bad_request", "Backup decrypted to %d bytes, expected 32." % len(priv))
    return priv


# ---------------------------------------------------------------------------
# Key wrapping at rest (passphrase-encrypted agent.key; `hub key-wrap`)
#
# Migrates an unwrapped 32-byte agent.key to the wrapped form:
#
#   FHWRAP1\n || salt(16) || nonce(24) || ciphertext
#
# where ciphertext is the 32-byte private key encrypted with
# XChaCha20-Poly1305 (IETF) under a 32-byte key derived from the
# operator's passphrase with Argon2id (libsodium MODERATE ops/mem limits,
# frozen by this format — there is no parameter field, so wrap and unwrap
# always use the same constants). Every primitive comes from
# PyNaCl/libsodium; no custom constructions. A wrong passphrase fails the
# Poly1305 MAC and surfaces as a clean "Incorrect passphrase" HubError —
# never garbage bytes.
#
# Passphrase sourcing, in order:
#   1. FAMILY_HUB_KEY_PASSPHRASE env var (agents/cron — non-interactive),
#   2. interactive getpass prompt (never echoed).
# It is NEVER a CLI flag (it would land in `ps` / shell history), NEVER
# logged, and NEVER included in error messages. It is registered with
# note_secret() so redact() scrubs it from all output.
# ---------------------------------------------------------------------------

_KEYWRAP_MAGIC = b"FHWRAP1\n"
_KEYWRAP_ENV_VAR = "FAMILY_HUB_KEY_PASSPHRASE"
_KEYWRAP_MIN_PASSPHRASE_LEN = 8  # same floor as `hub key-backup`


def _key_wrap_passphrase():
    """Return the key-wrapping passphrase: env var first, else getpass.

    The value is registered with note_secret() so it can never leak into
    output, and is never echoed, logged, or placed in error messages.
    """
    pw = os.environ.get(_KEYWRAP_ENV_VAR)
    if pw:
        note_secret(pw)
        return pw
    pw = getpass.getpass("Identity key passphrase: ")
    note_secret(pw)
    return pw


def _key_wrap_derive(passphrase, salt):
    """Derive the 32-byte wrapping key from passphrase+salt (Argon2id)."""
    nacl = _require_nacl()
    return nacl.pwhash.argon2id.kdf(
        32,
        passphrase.encode("utf-8"),
        salt,
        opslimit=nacl.pwhash.argon2id.OPSLIMIT_MODERATE,
        memlimit=nacl.pwhash.argon2id.MEMLIMIT_MODERATE,
    )


def _wrap_identity_key(priv_bytes, passphrase):
    """Encrypt a 32-byte private key; returns magic || salt || nonce || ct."""
    nacl = _require_nacl()
    if len(priv_bytes) != 32:
        raise HubError(
            "bad_request",
            "Cannot wrap: expected a 32-byte private key, got %d bytes."
            % len(priv_bytes),
        )
    salt = nacl.utils.random(nacl.pwhash.argon2id.SALTBYTES)
    nonce = nacl.utils.random(
        nacl.bindings.crypto_aead_xchacha20poly1305_ietf_NPUBBYTES
    )
    key = _key_wrap_derive(passphrase, salt)
    ct = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_encrypt(
        priv_bytes, None, nonce, key
    )
    return _KEYWRAP_MAGIC + salt + nonce + ct


def _unwrap_identity_key_with(blob, passphrase):
    """Decrypt a wrapped blob with an explicit passphrase (no prompting).

    Raises HubError("auth") with a clean "Incorrect passphrase" message on
    MAC failure, HubError("config") on truncated/malformed blobs. Never
    returns garbage.
    """
    nacl = _require_nacl()
    salt_len = nacl.pwhash.argon2id.SALTBYTES
    nonce_len = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_NPUBBYTES
    off = len(_KEYWRAP_MAGIC)
    if len(blob) < off + salt_len + nonce_len + 16:  # 16 = Poly1305 tag
        raise HubError(
            "config",
            "Wrapped identity key is truncated or corrupt (%d bytes) — it "
            "cannot be unwrapped. Restore from backup with `hub key-restore`."
            % len(blob),
        )
    salt = blob[off : off + salt_len]
    nonce = blob[off + salt_len : off + salt_len + nonce_len]
    ct = blob[off + salt_len + nonce_len :]
    key = _key_wrap_derive(passphrase, salt)
    try:
        priv = nacl.bindings.crypto_aead_xchacha20poly1305_ietf_decrypt(
            ct, None, nonce, key
        )
    except Exception:
        raise HubError(
            "auth",
            "Incorrect passphrase — the wrapped identity key could not be "
            "decrypted.",
        )
    if len(priv) != 32:
        raise HubError(
            "config",
            "Wrapped identity key decrypted to %d bytes, expected 32 — it "
            "is corrupt. Restore from backup with `hub key-restore`."
            % len(priv),
        )
    return priv


def _unwrap_identity_key(blob):
    """Decrypt a wrapped blob, sourcing the passphrase (env var / prompt)."""
    return _unwrap_identity_key_with(blob, _key_wrap_passphrase())


def _prompt_new_key_wrap_passphrase():
    """Get + confirm the passphrase for `hub key-wrap`.

    From the env var when set (automation), else a double getpass prompt.
    Enforces the minimum length so the wrap is real protection.
    """
    pw = os.environ.get(_KEYWRAP_ENV_VAR)
    if pw:
        note_secret(pw)
    else:
        pw1 = getpass.getpass(
            "New key passphrase (min %d characters): "
            % _KEYWRAP_MIN_PASSPHRASE_LEN
        )
        pw2 = getpass.getpass("Confirm key passphrase: ")
        note_secret(pw1)
        note_secret(pw2)
        if pw1 != pw2:
            raise HubError(
                "bad_request", "Passphrases do not match — key not wrapped."
            )
        pw = pw1
    if len(pw) < _KEYWRAP_MIN_PASSPHRASE_LEN:
        raise HubError(
            "bad_request",
            "Passphrase must be at least %d characters — key not wrapped."
            % _KEYWRAP_MIN_PASSPHRASE_LEN,
        )
    return pw


def cmd_key_wrap(args, transport):
    """Wrap the identity private key with a passphrase (Argon2id + XChaCha20-Poly1305).

    Migrates agent.key in place: backs the unwrapped original up to
    agent.key.bak-0600 FIRST, writes the wrapped blob at 0600, then proves
    the wrapped file on disk round-trips to the identical key before the
    job is done. On any verification failure the original is restored
    from the backup and the error is loud — the agent is never stranded.
    Idempotent: an already-wrapped key is a no-op.
    """
    _require_nacl()
    profile = args.profile
    key_path = agent_key_path(profile)
    try:
        with open(key_path, "rb") as fh:
            data = fh.read()
    except OSError as exc:
        raise HubError(
            "config",
            "No identity key at %s (%s). Run `hub key-init` first."
            % (key_path, exc),
        )
    if data.startswith(_KEYWRAP_MAGIC):
        emit(
            "Identity key at %s is already passphrase-wrapped — nothing to do."
            % key_path
        )
        return 0
    if len(data) != 32:
        raise HubError(
            "config",
            "Identity key at %s is %d bytes, expected 32 — it is corrupt. "
            "Restore from backup with `hub key-restore`." % (key_path, len(data)),
        )
    bak_path = key_path + ".bak-0600"
    if os.path.exists(bak_path) and not args.force:
        raise HubError(
            "bad_request",
            "Refusing to overwrite existing backup %s (use --force to "
            "overwrite — it still holds the unwrapped key)." % bak_path,
        )
    passphrase = _prompt_new_key_wrap_passphrase()
    # 1. Back up the unwrapped original FIRST (0600, verified like any secret).
    _write_secret_file_0600(bak_path, data, "unwrapped identity key backup")
    # 2. Wrap and write the new agent.key (0600).
    wrapped = _wrap_identity_key(data, passphrase)
    _write_secret_file_0600(key_path, wrapped, "passphrase-wrapped identity key")
    # 3. Prove the wrapped file round-trips BEFORE trusting it: decrypt what
    #    is actually on disk with the same passphrase.
    with open(key_path, "rb") as fh:
        on_disk = fh.read()
    if _unwrap_identity_key_with(on_disk, passphrase) != data:
        # Restore the original so the agent keeps working, then fail loudly.
        _write_secret_file_0600(key_path, data, "identity private key")
        raise HubError(
            "config",
            "Wrapped key verification failed for %s: the file on disk does "
            "not decrypt to the original key. The original was restored "
            "from backup — nothing was lost." % key_path,
        )
    _note_key_secrets(data)
    emit(
        "Identity key wrapped with a passphrase at %s (0600). The unwrapped "
        "original is backed up at %s (0600) — move it somewhere safe; once "
        "the passphrase is stored safely (password manager / vault), delete "
        "the on-machine backup, since an unwrapped copy on disk defeats the "
        "wrap." % (key_path, bak_path)
    )
    emit(
        "Ops note: non-interactive use (cron, agents) must now export "
        "%s=<passphrase> — without it, hub blocks on a passphrase prompt. "
        "See agent-skill/INSTALL.md." % _KEYWRAP_ENV_VAR
    )
    return 0


# ---------------------------------------------------------------------------
# HTTP client (urllib; a fake transport can be injected for tests)
# ---------------------------------------------------------------------------


def _auto_idem_key(path):
    """True when a POST to this path should auto-carry an idempotency key.

    Covers the create operations (circle/topic/invite/provisioning-code).
    Redeem/accept paths are deliberately excluded: their codes are single-use
    by design, and a key would give a false sense of retry safety.
    """
    if path in ("/v1/families", "/v1/topics", "/v1/provisioning-codes"):
        return True
    return bool(re.match(r"^/v1/families/[^/]+/invites$", path))


def _single_use_code_path(path):
    """True for redeem/accept paths whose codes are single-use.

    Retrying these can never duplicate the effect: if the first attempt
    committed, the retry gets 409 code_used/invite_used (which callers
    handle); if it never arrived, the retry succeeds. So they are retry-safe
    without an idempotency key.
    """
    return bool(
        re.match(r"^/v1/provisioning-codes/.+/redeem$", path)
        or re.match(r"^/v1/invites/.+/accept$", path)
    )


# Network-level failures worth retrying. Note http.client.RemoteDisconnected
# ("Remote end closed connection without response") is NOT wrapped in
# URLError by urlopen — it propagates raw, which is exactly what bit the
# circle-create flow.
_RETRYABLE_EXC = (
    OSError,
    http.client.HTTPException,
    TimeoutError,
    socket.timeout,
)


class _NoRedirect(urlrequest.HTTPRedirectHandler):
    """Refuse all HTTP redirects: fail closed instead of following them.

    urllib follows redirects automatically and honors non-HTTP schemes
    (e.g. file://) found in a Location header. The hub API never
    legitimately redirects, so any redirect is treated as hostile.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise HubError(
            "connection",
            "Refusing to follow redirect from hub server (code %d)" % code,
        )


# Module-level opener shared by all requests: no redirects, ever.
_opener = urlrequest.build_opener(_NoRedirect)


class HubClient:
    def __init__(self, base_url, token=None, timeout=20, debug=False, transport=None):
        self.base_url = base_url.rstrip("/")
        self.token = token
        if token:
            note_secret(token)
        self.timeout = timeout
        self.debug = debug
        self.transport = transport or self._urllib_transport

    # -- low level ------------------------------------------------------
    def _urllib_transport(self, method, url, headers, body_bytes):
        # SECURITY: never send the credential to a non-HTTPS origin.
        # _validate_server_url enforces https-only (loopback http excepted);
        # the base URL comes from the operator's own config, but defense in
        # depth costs one call.
        _validate_server_url(url)
        req = urlrequest.Request(url, data=body_bytes, headers=headers, method=method)
        try:
            with _opener.open(req, timeout=self.timeout) as resp:
                return resp.status, resp.read().decode("utf-8", "replace")
        except urlerror.HTTPError as exc:
            return exc.code, exc.read().decode("utf-8", "replace")
        except urlerror.URLError as exc:
            raise HubError("connection", "Cannot reach %s: %s" % (self.base_url, exc))

    def _debug_dump(self, method, url, headers, body_bytes, status, resp_text):
        safe_headers = {
            k: ("[redacted]" if k.lower() == "authorization" else v)
            for k, v in headers.items()
        }
        emit_err("--- hub debug [%s] ---" % time.strftime("%H:%M:%S"))
        emit_err("%s %s" % (method, _scrub_url(url)))
        emit_err("request headers: %s" % json.dumps(safe_headers))
        if body_bytes:
            emit_err("request body: %s"
                     % _scrub_sensitive_text(
                         body_bytes.decode("utf-8", "replace"))[:2000])
        emit_err("response status: %s" % status)
        emit_err("response body: %s"
                 % _scrub_sensitive_text(resp_text or "")[:2000])
        emit_err("--- end debug ---")

    # -- public ---------------------------------------------------------
    def _transport_with_retry(self, method, url, headers, body_bytes, retries):
        """Run the transport with exponential backoff.

        Retries network-level failures (dropped connections, timeouts),
        HTTP 429 and 5xx. Never retries 4xx: those are deterministic. Every
        retry reuses the same idempotency key (set by the caller), so retried
        creates cannot duplicate.
        """
        last_status = None
        last_text = None
        for attempt in range(retries + 1):
            try:
                status, resp_text = self.transport(method, url, headers, body_bytes)
            except _RETRYABLE_EXC as exc:
                reason = "network error: %s" % exc
                status, resp_text = None, None
            except HubError as exc:
                if exc.code != "connection":
                    raise
                reason = "connection error: %s" % exc
                status, resp_text = None, None
            else:
                if status == 429 or status >= 500:
                    reason = "http %d" % status
                else:
                    return status, resp_text
            last_status, last_text = status, resp_text
            if attempt >= retries:
                break
            delay = min(2 ** attempt, 8) + random.uniform(0, 1)  # nosec B311 -- retry jitter is not a security use
            if self.debug:
                emit_err(
                    "hub debug [%s]: %s %s failed (%s); retry %d/%d in %.1fs"
                    % (time.strftime("%H:%M:%S"), method, _scrub_url(url), reason,
                       attempt + 1, retries, delay)
                )
            time.sleep(delay)
        if last_status is not None:
            return last_status, last_text
        raise HubError(
            "connection",
            "Cannot reach %s after %d attempts (%s)"
            % (self.base_url, retries + 1, reason),
        )

    def call(self, method, path, query=None, json_body=None,
             idempotency_key=None, auth=True, retries=3):
        url = self.base_url + path
        if query:
            url += "?" + urlparse.urlencode(query)
        headers = {
            "Accept": "application/json",
            # Cloudflare bot protection (Error 1010) blocks Python-urllib's
            # default UA. Identify honestly as the family-hub agent client.
            # The version is the real CLI version (contract C1); the server
            # gates stale clients on it (WS-B).
            "User-Agent": "family-hub-agent/" + VERSION,
        }
        if auth:
            if not self.token:
                raise HubError("auth", "No credential available for this request.")
            headers["Authorization"] = "Bearer " + self.token
        body_bytes = None
        if json_body is not None:
            body_bytes = json.dumps(json_body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        # Mutating POSTs always carry an idempotency key so a retried request
        # can never duplicate the operation. Generated once per call, shared
        # across all retry attempts. Redeem/accept paths are excluded: their
        # codes are single-use by design.
        if idempotency_key is None and method == "POST" and _auto_idem_key(path):
            idempotency_key = uuid.uuid4().hex
        if idempotency_key:
            headers["Idempotency-Key"] = idempotency_key
        # Retry is only safe when the operation cannot duplicate: GETs are
        # inherently safe; POSTs are safe with an idempotency key the server
        # honors, or on single-use-code paths (redeem/accept) where a retry
        # can at worst return 409. Without that, a dropped connection after
        # the server committed would duplicate the operation on retry (e.g.
        # token rotation would rotate twice, leaving the client tokenless).
        safe_to_retry = (
            method == "GET"
            or idempotency_key is not None
            or (method == "POST" and _single_use_code_path(path))
        )
        status, resp_text = self._transport_with_retry(
            method, url, headers, body_bytes, retries if safe_to_retry else 0
        )
        if self.debug:
            self._debug_dump(method, url, headers, body_bytes, status, resp_text)
        if 200 <= status < 300:
            if not resp_text:
                return None
            try:
                return json.loads(resp_text)
            except ValueError:
                raise HubError("error", "Server returned non-JSON response.")
        try:
            payload = json.loads(resp_text) if resp_text else {}
        except ValueError:
            payload = {}
        raise _friendly_from_http(status, payload)


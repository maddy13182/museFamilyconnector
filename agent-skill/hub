# ---------------------------------------------------------------------------
# Tamper-evidence (WS-E) — supply-chain integrity of the installed CLI.
#
# HONEST LIMIT (see docs/CLIENT_HARDENING_SPEC.md section 2): these checks
# catch supply-chain tampering (a corrupted or unofficially modified `hub`
# installed on this machine), accidental corruption, and casual
# modification. They do NOT defend against an attacker with root on this
# machine: root can read the bearer token and agent.key straight off disk,
# which is easier than tampering with the CLI. The checks below are real
# checks with clear failure modes — not theater — but they are not a
# substitute for endpoint security.
#
# Two mechanisms:
#   1. `hub verify-install` — on-demand verification of the installed CLI
#      against the release `manifest.json` installed next to it (contract
#      C5: {version, files: {hub: sha256}, signature: <sigstore bundle
#      ref>}), including the sigstore bundle's attestation.
#   2. Startup self-integrity check — every invocation hashes this file's
#      own bytes and compares against the manifest's recorded hash.
#      Mismatch -> refuse to run (exit 5). Missing/corrupt manifest ->
#      warn once and continue (dev checkouts have no manifest).
# ---------------------------------------------------------------------------

# Exit status when the installed CLI does not match the signed release.
EXIT_TAMPERED = 5

# Expected sigstore certificate identity for the CLI release workflow
# (contracts C3/C5; the workflow is `.github/workflows/release.yml`,
# owned by WS-C). Used only for the best-effort full chain validation in
# verify-install — never for the startup check.
_RELEASE_WORKFLOW_IDENTITY = (
    "https://github.com/maddy13182/museFamilyconnector"
    "/.github/workflows/release.yml@refs/heads/main"
)
_SIGSTORE_OIDC_ISSUER = "https://token.actions.githubusercontent.com"

# Warn-once flag for the missing/corrupt-manifest (dev checkout) path.
_integrity_warned = False


def _cli_install_dir():
    """Directory holding the running `hub` script — the install location."""
    return os.path.dirname(os.path.abspath(__file__))


def _installed_manifest_path():
    """Path of the release manifest.json installed next to the CLI."""
    return os.path.join(_cli_install_dir(), "manifest.json")


def _sha256_file(path):
    """Hex SHA-256 of a file's bytes, streamed."""
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _load_integrity_manifest(path):
    """Load and schema-check the installed release manifest.

    Returns (manifest, error): on success error is None. A missing or
    corrupt manifest is NOT fatal here — it means a dev checkout or a
    hand-rolled copy, and callers degrade to warn (startup) or FAIL
    (verify-install) accordingly.
    """
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return None, "no manifest.json next to the CLI (dev checkout?)"
    except (OSError, ValueError) as exc:
        return None, "manifest.json is unreadable or corrupt: %s" % exc
    if not isinstance(data, dict):
        return None, "manifest.json is corrupt: top-level value is not an object"
    files = data.get("files")
    hub_hash = files.get("hub") if isinstance(files, dict) else None
    if not isinstance(data.get("version"), str):
        return None, "manifest.json is corrupt: missing/invalid 'version'"
    if not isinstance(hub_hash, str) or not re.fullmatch(r"[0-9a-f]{64}", hub_hash):
        return None, "manifest.json is corrupt: missing/invalid files.hub sha256"
    return data, None


def _startup_integrity_check():
    """Startup self-integrity check.

    Hashes this CLI's own file bytes and compares against the installed
    manifest's recorded hash. Returns True to proceed, False to refuse.
    Missing/corrupt manifest -> warn once on stderr and return True (dev
    checkouts have no manifest and must keep working).
    """
    global _integrity_warned
    manifest, err = _load_integrity_manifest(_installed_manifest_path())
    if manifest is None:
        if not _integrity_warned:
            _integrity_warned = True
            emit_err(
                "warning: integrity manifest unavailable (%s); "
                "startup self-check skipped." % err
            )
        return True
    try:
        actual = _sha256_file(os.path.abspath(__file__))
    except OSError as exc:
        # Fail open: we cannot establish a mismatch, so warn and continue
        # rather than bricking a working install over an I/O error.
        if not _integrity_warned:
            _integrity_warned = True
            emit_err(
                "warning: could not hash the CLI file (%s); "
                "startup self-check skipped." % exc
            )
        return True
    if actual != manifest["files"]["hub"]:
        emit_err(
            "error: installed CLI does not match the signed release; "
            "reinstall from the server (`hub upgrade`, or re-download from the server's /v2/client/download/* endpoints)."
        )
        return False
    return True


def _bundle_artifact_digest(bundle_path):
    """Hex SHA-256 the sigstore bundle attests to, or (None, error).

    Compares the bundle's embedded messageDigest against the artifact:
    this proves the signature was made over exactly these bytes. It does
    not by itself prove *who* signed — that needs the full chain check.
    """
    try:
        with open(bundle_path, "r", encoding="utf-8") as handle:
            bundle = json.load(handle)
    except (OSError, ValueError) as exc:
        return None, "cannot read bundle: %s" % exc
    if not isinstance(bundle, dict) or "verificationMaterial" not in bundle:
        return None, "not a sigstore bundle (missing verificationMaterial)"
    message_sig = bundle.get("messageSignature") or {}
    message_digest = message_sig.get("messageDigest") or {}
    digest_b64 = message_digest.get("digest")
    algorithm = (message_digest.get("algorithm") or "").upper()
    if not digest_b64:
        return None, (
            "bundle carries no messageDigest for the artifact "
            "(DSSE-envelope bundles are not supported)"
        )
    if algorithm and algorithm != "SHA2_256":
        return None, "bundle digest algorithm is %s, expected SHA2_256" % algorithm
    try:
        raw = base64.b64decode(digest_b64)
    except ValueError:
        return None, "bundle messageDigest is not valid base64"
    if len(raw) != 32:
        return None, "bundle messageDigest is not a 32-byte SHA-256 digest"
    return raw.hex(), None


def _sigstore_chain_verify(bundle_path, hub_path):
    """Best-effort full sigstore trust-chain validation.

    Returns (status, detail) with status 'ok', 'fail', or 'skipped'.
    'skipped' is honest, not a pass: it means the chain was not validated
    because the `sigstore` CLI is not installed here.
    """
    sigstore_bin = shutil.which("sigstore")
    if sigstore_bin is None:
        return (
            "skipped",
            "sigstore CLI not installed — certificate and transparency-log "
            "validation not performed (install `sigstore` for the full chain)",
        )
    try:
        proc = subprocess.run(  # noqa: S603
            # nosec B603 -- no shell; fixed argv, values never interpreted, binary via shutil.which
            [
                sigstore_bin,
                "verify",
                "identity",
                "--bundle",
                bundle_path,
                "--cert-identity",
                _RELEASE_WORKFLOW_IDENTITY,
                "--cert-oidc-issuer",
                _SIGSTORE_OIDC_ISSUER,
                hub_path,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=120,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return "fail", "sigstore verification errored: %s" % exc
    if proc.returncode == 0:
        return "ok", "certificate + transparency log validated"
    detail = proc.stdout.decode("utf-8", "replace").strip().splitlines()
    return "fail", "sigstore rejected the bundle: %s" % (
        detail[-1] if detail else "no output"
    )


def cmd_verify_install(args, transport):
    """Verify the installed CLI against the release manifest + sigstore bundle.

    Checks, in order: manifest present and well-formed; sha256 of this
    file matches the manifest; the sigstore bundle exists, is
    structurally a bundle, and attests to exactly these bytes; then (best
    effort) the full sigstore trust chain. Exit 0 on PASS, 1 on FAIL.
    """
    hub_path = os.path.abspath(__file__)
    manifest_path = _installed_manifest_path()
    manifest_dir = os.path.dirname(manifest_path)

    emit("verify-install: %s" % hub_path)

    manifest, err = _load_integrity_manifest(manifest_path)
    if manifest is None:
        emit("[FAIL] manifest.json: %s" % err)
        emit("RESULT: FAIL — no trustworthy release manifest to verify against.")
        return 1
    emit("[ OK ] manifest.json (version %s)" % manifest["version"])

    try:
        actual = _sha256_file(hub_path)
    except OSError as exc:
        emit("[FAIL] sha256: cannot read the installed file: %s" % exc)
        emit("RESULT: FAIL — cannot verify the installed CLI.")
        return 1
    expected = manifest["files"]["hub"]
    if actual != expected:
        emit("[FAIL] sha256: manifest records %s…" % expected[:16])
        emit("       but the installed file hashes to %s…" % actual[:16])
        emit(
            "RESULT: FAIL — installed CLI does not match the signed release; "
            "reinstall from the server (`hub upgrade`, or re-download from the server's /v2/client/download/* endpoints)."
        )
        return 1
    emit("[ OK ] sha256 matches manifest (%s…)" % actual[:16])

    sig_ref = manifest.get("signature")
    if not sig_ref or not isinstance(sig_ref, str):
        emit("[FAIL] signature: manifest has no sigstore bundle reference")
        emit("RESULT: FAIL — release manifest carries no signature to validate.")
        return 1
    bundle_path = (
        sig_ref if os.path.isabs(sig_ref) else os.path.join(manifest_dir, sig_ref)
    )
    if not os.path.isfile(bundle_path):
        emit("[FAIL] signature: bundle %r not found next to the CLI" % sig_ref)
        emit(
            "RESULT: FAIL — signature bundle missing; "
            "reinstall from the server (`hub upgrade`, or re-download from the server's /v2/client/download/* endpoints)."
        )
        return 1
    emit("[ OK ] sigstore bundle present: %s" % sig_ref)

    bundle_digest, err = _bundle_artifact_digest(bundle_path)
    if bundle_digest is None:
        emit("[FAIL] sigstore bundle: %s" % err)
        emit("RESULT: FAIL — the signature does not attest to this artifact.")
        return 1
    if bundle_digest != actual:
        emit("[FAIL] sigstore bundle: bundle attests to %s…" % bundle_digest[:16])
        emit("       but the installed file hashes to %s…" % actual[:16])
        emit("RESULT: FAIL — the signature does not attest to this artifact.")
        return 1
    emit("[ OK ] bundle attests to exactly these bytes")

    status, detail = _sigstore_chain_verify(bundle_path, hub_path)
    if status == "fail":
        emit("[FAIL] sigstore trust chain: %s" % detail)
        emit("RESULT: FAIL — signature chain validation failed.")
        return 1
    if status == "skipped":
        emit("[SKIP] sigstore trust chain: %s" % detail)
    else:
        emit("[ OK ] sigstore trust chain: %s" % detail)

    emit(
        "RESULT: PASS — installed CLI matches the signed release "
        "(version %s)." % manifest["version"]
    )
    return 0


# ---------------------------------------------------------------------------
# CLI self-upgrade (WS-C: release management)
#
# `hub upgrade` pulls the signed release advertised by
# GET /v2/client/latest, verifies it (sigstore signature + sha256), and
# swaps it in atomically, keeping the previous binary for `hub rollback`.
# It also records the installed release next to the CLI (contract C5) for
# WS-E's `hub verify-install`.
#
# Tamper-evidence limit (docs/CLIENT_HARDENING_SPEC.md §2): this defends
# the *supply chain* — what gets installed — plus accidental corruption
# and casual tampering. It cannot stop a root-level adversary on this
# machine (root can read agent.key and the bearer token straight off
# disk); that limit is documented, not hand-waved.
# ---------------------------------------------------------------------------

# Signed artifacts are cut by the release workflow on GitHub Releases and
# served by the hub server itself (same bytes, same seal — only the host
# changed). The release workflow signs with GitHub Actions' keyless OIDC
# signer (sigstore-python), so the expected certificate identity pins this
# repo's release workflow on main.
_RELEASE_IDENTITY_ISSUER = "https://token.actions.githubusercontent.com"
_RELEASE_IDENTITY = (
    "https://github.com/maddy13182/museFamilyconnector"
    "/.github/workflows/release.yml@refs/heads/main"
)
_RELEASE_ASSET_HUB = "hub"
_RELEASE_ASSET_BUNDLE = "hub.sigstore"
_RELEASE_ASSET_MANIFEST = "manifest.json"
_ROLLBACK_SUFFIX = ".prev"

_VERSION_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)([-+][0-9A-Za-z.-]+)?$")
# Absolute https URL (no whitespace). Server-supplied asset URLs must at
# least be well-formed; _validate_download_url additionally pins them to
# the configured server's origin before anything is fetched.
_ABSOLUTE_HTTPS_URL_RE = re.compile(r"^https://[^\s/$.?#].[^\s]*$")
_SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")


def _script_path():
    """Absolute path of the running `hub` script (symlinks resolved)."""
    here = globals().get("__file__") or sys.argv[0]
    return os.path.realpath(os.path.abspath(here))


def _parse_version(text):
    """Parse ``x.y.z[-pre]`` into (major, minor, patch, pre)."""
    m = _VERSION_RE.match(str(text).strip())
    if not m:
        raise HubError(
            "bad_request",
            "Unparseable version %r (expected semver like 0.7.0)." % (text,),
        )
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4) or "")


def _is_newer(candidate, current):
    """True when `candidate` is strictly newer than `current`.

    (major, minor, patch) compare first; a stable release beats its own
    prerelease (0.7.0 > 0.7.0-rc1); prereleases compare lexically.
    """
    cand = _parse_version(candidate)
    cur = _parse_version(current)
    if cand[:3] != cur[:3]:
        return cand[:3] > cur[:3]
    if cand[3] == cur[3]:
        return False
    if not cand[3]:
        return True  # stable beats a prerelease of the same numbers
    if not cur[3]:
        return False
    return cand[3] > cur[3]


def _validate_skill_block(manifest):
    """Validate the manifest's `skill` block (contract §3.6, server 1.0.0+).

    Shape: {url, sha256, version} — the server-hosted skill bundle
    (skill.tar.gz) advertised by GET /v2/client/latest. `url` must be an
    absolute https URL; the same-origin pin to the configured server is
    enforced at download time by `_download_bytes` (exactly like the
    release assets) before a single byte is fetched. `sha256` is the
    64-hex digest the tarball must match; `version` is the skill version
    (SKILL.md header) used for the newer-than-installed comparison.
    Raises HubError on anything missing or malformed — fail loud, never
    a partial or unverified refresh.
    """
    skill = manifest.get("skill")
    if not isinstance(skill, dict):
        raise HubError(
            "bad_request", "Client manifest is missing the 'skill' object."
        )
    for field in ("url", "sha256", "version"):
        if not skill.get(field):
            raise HubError(
                "bad_request", "Client manifest 'skill' is missing %r." % (field,)
            )
    url = str(skill["url"])
    if not _ABSOLUTE_HTTPS_URL_RE.match(url):
        raise HubError(
            "bad_request",
            "Client manifest skill.url is not an absolute https URL: %r." % url,
        )
    _parse_version(skill["version"])  # raises on garbage
    if not _SHA256_RE.match(str(skill["sha256"])):
        raise HubError(
            "bad_request", "Client manifest skill.sha256 is not 64 hex chars."
        )
    return skill


def _validate_client_manifest(obj):
    """Validate a GET /v2/client/latest payload (contract C2).

    New shape (spec §3.5 + §3.6): {version, min_cli_version,
    server_version, sha256, released_at, download_url,
    assets: {hub, sigstore, manifest}, skill: {url, sha256, version}}.
    The CLI downloads from `assets.*` (this server's download endpoints);
    `download_url` is kept for field continuity and validated too.
    Returns the manifest dict; raises HubError on any schema violation.
    """
    if not isinstance(obj, dict):
        raise HubError("bad_request", "Client manifest is not a JSON object.")
    for field in ("version", "min_cli_version", "download_url", "sha256", "assets"):
        if not obj.get(field):
            raise HubError(
                "bad_request", "Client manifest is missing %r." % (field,)
            )
    _parse_version(obj["version"])  # raises on garbage
    _parse_version(obj["min_cli_version"])  # raises on garbage
    assets = obj["assets"]
    if not isinstance(assets, dict):
        raise HubError(
            "bad_request", "Client manifest 'assets' is not an object."
        )
    for name in ("hub", "sigstore", "manifest"):
        url = assets.get(name)
        if not url or not _ABSOLUTE_HTTPS_URL_RE.match(str(url)):
            raise HubError(
                "bad_request",
                "Client manifest assets.%s is not an absolute https URL: %r."
                % (name, url),
            )
    if not _ABSOLUTE_HTTPS_URL_RE.match(str(obj["download_url"])):
        raise HubError(
            "bad_request",
            "Client manifest download_url is not an absolute https URL: %r."
            % (obj["download_url"],),
        )
    if not _SHA256_RE.match(str(obj["sha256"])):
        raise HubError(
            "bad_request", "Client manifest sha256 is not 64 hex chars."
        )
    _validate_skill_block(obj)
    return obj


def _validate_download_url(url, server):
    """Pin release-asset downloads to the configured server's origin.

    The asset URLs are supplied by the server (from /v2/client/latest), so
    the downloader refuses anything that is not that same origin: a
    compromised/misbehaving server cannot bounce the fetch off to an
    attacker host. https-only, with the same loopback-http exception as
    the server URL itself (F03). The sha256 + sigstore verification after
    the download remains the real trust anchor — this is defense in depth.
    """
    try:
        parts = urlparse.urlsplit(str(url))
        srv = urlparse.urlsplit(str(server))
        host = (parts.hostname or "").lower().rstrip(".")
        srv_host = (srv.hostname or "").lower().rstrip(".")
        port = parts.port
        srv_port = srv.port
    except ValueError as exc:
        raise HubError(
            "bad_request", "Malformed download URL %r: %s" % (url, exc)
        )
    if parts.scheme not in ("http", "https"):
        raise HubError(
            "bad_request",
            "Refusing to download over a non-HTTP(S) URL: %r." % (url,),
        )
    if parts.scheme == "http" and host not in _LOOPBACK_HOSTS:
        raise HubError(
            "bad_request",
            "Refusing to download over plain http from non-loopback host "
            "%r." % host,
        )
    if parts.username or parts.password:
        raise HubError(
            "bad_request",
            "Refusing download URL with embedded credentials — the Bearer "
            "token is the only credential and it travels in the "
            "Authorization header.",
        )
    # Same origin as the configured server (default ports normalized):
    # the server's own /v2/client/download/* endpoints.
    default_port = {"http": 80, "https": 443}
    port = port or default_port[parts.scheme]
    srv_port = srv_port or default_port.get(srv.scheme)
    if not host or host != srv_host or port != srv_port:
        raise HubError(
            "bad_request",
            "Refusing to download from unexpected origin %r (expected the "
            "configured hub server %r)." % (url, server),
        )


def _download_bytes(url, what, server, timeout=90):
    """Fetch a release asset from the hub server. Raises HubError on any failure."""
    _validate_download_url(url, server)
    req = urlrequest.Request(
        url,
        headers={
            # Cloudflare bot protection blocks Python-urllib's default UA;
            # identify honestly as the family-hub agent client.
            "User-Agent": "family-hub-agent/" + _cli_version(),
            "Accept": "application/octet-stream",
        },
    )
    try:
        # nosemgrep: dynamic-urllib-use-detected -- URL validated by _validate_download_url (same-origin https pin to the configured hub server) immediately above
        with urlrequest.urlopen(req, timeout=timeout) as resp:  # nosec B310
            if resp.status != 200:
                raise HubError(
                    "connection",
                    "Download of %s failed: HTTP %d." % (what, resp.status),
                )
            data = resp.read()
    except urlerror.URLError as exc:
        raise HubError("connection", "Download of %s failed: %s." % (what, exc))
    if not data:
        raise HubError("connection", "Download of %s returned an empty body." % what)
    return data


def _have_sigstore():
    """True when the `sigstore` package can run (needed to verify releases)."""
    try:
        # Fixed argv; no untrusted input.
        proc = subprocess.run(  # nosec B603
            [sys.executable, "-m", "sigstore", "--version"],
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.returncode == 0


def _verify_sigstore(artifact_path, bundle_path):
    """Verify the sigstore bundle against the artifact; raise on failure.

    A missing `sigstore` package is a hard refusal (with the install
    command), not a skipped check — an unverified upgrade is a failed
    upgrade. Verification is networked (Rekor / timestamp lookups).
    """
    if not _have_sigstore():
        raise HubError(
            "config",
            "Cannot verify the release signature: the `sigstore` package is "
            "not installed. Run `pip install sigstore`, then retry "
            "`hub upgrade`. The upgrade is refused rather than skipping "
            "signature verification.",
        )
    cmd = [
        sys.executable,
        "-m",
        "sigstore",
        "verify",
        "identity",
        "--bundle",
        bundle_path,
        "--cert-identity",
        _RELEASE_IDENTITY,
        "--cert-oidc-issuer",
        _RELEASE_IDENTITY_ISSUER,
        artifact_path,
    ]
    try:
        # Fixed argv; only internal temp paths vary. No shell.
        proc = subprocess.run(cmd, capture_output=True, timeout=180)  # nosec B603
    except (OSError, subprocess.SubprocessError) as exc:
        raise HubError("config", "sigstore verification could not run: %s." % exc)
    if proc.returncode != 0:
        detail = (proc.stderr or b"").decode("utf-8", "replace").strip().splitlines()
        raise HubError(
            "config",
            "Signature verification FAILED for the downloaded CLI: %s "
            "The artifact is NOT installed — the current version is kept."
            % (detail[-1] if detail else "no detail from sigstore."),
        )


def _self_test(path, expect_version=None):
    """Run the candidate binary's --version; raise HubError when it fails."""
    try:
        # Fixed argv; `path` is the upgrade candidate or the installed CLI.
        proc = subprocess.run(
            [sys.executable, path, "--version"], capture_output=True, timeout=60
        )  # nosec B603
    except (OSError, subprocess.SubprocessError) as exc:
        raise HubError("config", "Self-test could not run %s: %s." % (path, exc))
    out = (proc.stdout or b"").decode("utf-8", "replace")
    if proc.returncode != 0:
        raise HubError(
            "config",
            "Self-test FAILED for %s (exit %d): %s"
            % (path, proc.returncode, out.strip()[:200]),
        )
    if expect_version and expect_version not in out:
        raise HubError(
            "config",
            "Self-test version mismatch for %s: expected %s in %r."
            % (path, expect_version, out.strip()[:200]),
        )


def _atomic_install(data, target):
    """Write `data` to `target` atomically, preserving the existing mode.

    The temp file lives in the target directory (same filesystem, so
    os.replace is atomic) and is fsynced before the rename. A failure
    leaves the old file untouched.
    """
    directory = os.path.dirname(target) or "."
    try:
        mode = stat.S_IMODE(os.stat(target).st_mode)
    except OSError:
        mode = 0o755
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".hub-upgrade-")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _write_integrity_manifest(install_dir, version, sha256):
    """Record the installed release next to the CLI (contract C5).

    ``{version, files: {hub: sha256}, signature, identity}`` — consumed by
    WS-E's `hub verify-install`, which re-checks the installed file's
    sha256 and validates the sigstore bundle saved alongside it.
    """
    manifest = {
        "version": version,
        "files": {_RELEASE_ASSET_HUB: sha256},
        "signature": _RELEASE_ASSET_BUNDLE,
        "identity": {
            "issuer": _RELEASE_IDENTITY_ISSUER,
            "identity": _RELEASE_IDENTITY,
        },
    }
    tmp = os.path.join(install_dir, ".manifest.json.tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, os.path.join(install_dir, "manifest.json"))


# ---------------------------------------------------------------------------
# Skill-docs refresh (skill bundle distribution, contract §3.6)
# ---------------------------------------------------------------------------
#
# GET /v2/client/latest advertises a versioned skill bundle (the full
# installable skill: SKILL.md, references/, INSTALL.md, requirements.txt,
# plus the signed hub + hub.sigstore + manifest.json) at
# /v2/client/download/skill.tar.gz, in the manifest's `skill` block:
# {url, sha256, version}. `hub upgrade` refreshes the doc files when the
# server's skill version is newer than the installed one — whether or not
# the binary was upgraded, because skill and CLI versions are independent.
#
# Trust model: the tarball is bytes from the hub server, exactly like the
# release assets. Its sha256 (from the already-validated manifest) is
# verified BEFORE extraction, and extraction is fail-closed (see
# _safe_extract_skill_bundle). Only the doc allowlist is ever copied into
# the skill dir — the binary flow owns hub/hub.sigstore/manifest.json, and
# credentials (config.json, token files, *.key, profiles) are never within
# reach of the copy.

# Doc files/dirs the refresh may copy, relative to the skill dir (the dir
# containing the running `hub` script).
_SKILL_DOC_FILES = ("SKILL.md", "INSTALL.md", "requirements.txt")
_SKILL_DOC_DIR = "references"
# Files the refresh must never write, even if the tarball contains them —
# the binary flow owns the release artifacts. Disjoint from the allowlist
# by construction (covered by a test).
_SKILL_BUNDLE_NEVER_WRITE = ("hub", "hub.sigstore", "manifest.json")

_UNSAFE_TAR_NAME_RE = re.compile(r"(?:^|[\\/])\.\.(?:[\\/]|$)")
_UNSAFE_TAR_DRIVE_RE = re.compile(r"^[A-Za-z]:")


def _check_tar_member(member):
    """Fail-closed safety check for one skill-bundle tar member.

    Rejects, with HubError and before anything is written:
      - absolute paths ("/etc/x", "\\x", "C:/x" — the drive-letter form
        matters on Windows, where os.path.join would otherwise resolve
        it outside the staging dir),
      - any `..` path component (tarball-slip),
      - symlinks and hardlinks — rejected outright rather than
        resolve-then-contain, because skill docs are plain files: any
        link member is either a build bug or an attack,
      - anything that is not a regular file or a directory
        (devices, FIFOs, sockets).
    """
    name = member.name
    if (
        not name
        or name in (".", "./")
        or name.startswith(("/", "\\"))
        or _UNSAFE_TAR_DRIVE_RE.match(name)
        or _UNSAFE_TAR_NAME_RE.search(name)
    ):
        raise HubError(
            "config",
            "The skill bundle contains an unsafe path %r; refusing to extract."
            % (name,),
        )
    if member.issym() or member.islnk():
        raise HubError(
            "config",
            "The skill bundle contains a symlink/hardlink %r; "
            "refusing to extract." % (name,),
        )
    if not (member.isreg() or member.isdir()):
        raise HubError(
            "config",
            "The skill bundle contains a non-regular member %r; "
            "refusing to extract." % (name,),
        )


def _safe_extract_skill_bundle(tarball_bytes, staging_dir):
    """Extract sha256-verified tarball bytes into staging_dir, fail-closed.

    Every member passes _check_tar_member before anything is written, and
    extraction is manual (member file objects -> plain files via
    copyfileobj), never tarfile.extract(): no member can trigger a
    privileged operation or escape the staging dir. A final commonpath
    containment check is defense in depth under the name checks. On any
    failure nothing in the skill dir has been touched — extraction happens
    in the temp staging dir only, which the caller cleans up.
    """
    staging_abs = os.path.abspath(staging_dir)
    try:
        tfile = tarfile.open(fileobj=io.BytesIO(tarball_bytes), mode="r:*")
    except tarfile.TarError as exc:
        raise HubError(
            "config", "The skill bundle is not a readable tar archive: %s" % exc
        )
    try:
        members = tfile.getmembers()
        for member in members:
            _check_tar_member(member)
        for member in members:
            target = os.path.abspath(os.path.join(staging_abs, member.name))
            if os.path.commonpath([staging_abs, target]) != staging_abs:
                raise HubError(
                    "config",
                    "The skill bundle would write outside its staging area "
                    "(%r); refusing." % (member.name,),
                )
            if member.isdir():
                os.makedirs(target, exist_ok=True)
            else:
                parent = os.path.dirname(target) or staging_abs
                os.makedirs(parent, exist_ok=True)
                with tfile.extractfile(member) as fin, open(target, "wb") as fout:
                    shutil.copyfileobj(fin, fout)
    except HubError:
        raise
    except (tarfile.TarError, OSError) as exc:
        raise HubError(
            "config", "The skill bundle could not be extracted: %s" % exc
        )
    finally:
        tfile.close()


def _install_skill_docs(staging_dir, skill_dir):
    """Copy only the doc allowlist from staging into the skill dir.

    Files: SKILL.md, INSTALL.md, requirements.txt — each copied (via an
    atomic temp+rename) when present. SKILL.md must be present: it carries
    the version signal, so a bundle without it is rejected.
    Directory: references/ is replaced wholesale (rmtree + copytree).
    Everything else in the bundle — hub, hub.sigstore, manifest.json,
    config.json, token files, *.key, profiles — is never written: the
    allowlist is the credential-safety boundary. Modes: docs 0644,
    dirs 0755. Returns the refreshed items for the summary emit.
    """
    if not set(_SKILL_DOC_FILES).isdisjoint(_SKILL_BUNDLE_NEVER_WRITE):
        raise AssertionError("skill-doc allowlist overlaps NEVER_WRITE")
    refreshed = []
    for fname in _SKILL_DOC_FILES:
        src = os.path.join(staging_dir, fname)
        if not os.path.isfile(src):
            if fname == "SKILL.md":
                raise HubError(
                    "config",
                    "The skill bundle has no SKILL.md; refusing to install "
                    "a versionless skill.",
                )
            emit("Skill bundle has no %s; keeping the installed one." % fname)
            continue
        dst = os.path.join(skill_dir, fname)
        tmp = dst + ".tmp"
        try:
            shutil.copyfile(src, tmp)
            os.chmod(tmp, 0o644)
            os.replace(tmp, dst)
        except OSError as exc:
            raise HubError(
                "config",
                "Could not refresh %s (%s); the skill docs may be partial — "
                "re-run `hub upgrade`." % (fname, exc),
            )
        refreshed.append(fname)
    ref_src = os.path.join(staging_dir, _SKILL_DOC_DIR)
    if os.path.isdir(ref_src):
        ref_dst = os.path.join(skill_dir, _SKILL_DOC_DIR)
        try:
            shutil.rmtree(ref_dst, ignore_errors=True)
            shutil.copytree(ref_src, ref_dst)
        except OSError as exc:
            raise HubError(
                "config",
                "Could not refresh references/ (%s); the skill docs may be "
                "partial — re-run `hub upgrade`." % exc,
            )
        for root, dirs, files in os.walk(ref_dst):
            for d in dirs:
                # 0700 on doc dirs: owner-only traversal (more restrictive than
                # 0755; docs are local-only, no need for group/other x bit).
                os.chmod(os.path.join(root, d), 0o700)
            for f in files:
                os.chmod(os.path.join(root, f), 0o644)
        refreshed.append(_SKILL_DOC_DIR + "/")
    else:
        emit("Skill bundle has no references/; keeping the installed tree.")
    return refreshed


def _refresh_skill_docs(ctx, manifest):
    """Refresh the skill's doc files from the server-hosted skill bundle.

    Runs at the end of `hub upgrade`, whether or not the binary was
    upgraded (skill and CLI versions are independent). When the server's
    skill version is newer than the installed skill's, the tarball is
    downloaded (same-origin pinned https via _download_bytes), its sha256
    is verified against the manifest BEFORE extraction — the hash covers
    the exact bytes that are then extracted from memory, so there is no
    TOCTOU between check and use — and only the doc allowlist is copied
    into the skill dir.

    Fail-closed throughout: hash mismatch, unsafe tarball, or a bundle
    without SKILL.md raises HubError and touches nothing in the skill dir.
    """
    skill = manifest["skill"]  # validated by _validate_client_manifest
    server_version = str(skill["version"])
    skill_dir = _script_dir()
    installed = _skill_version()
    if installed == "unknown":
        emit(
            "No SKILL.md next to the CLI (not a skill install); "
            "skipping the skill-docs refresh."
        )
        return 0
    if not _is_newer(server_version, installed):
        emit(
            "Skill docs are current: installed skill %s, server advertises %s."
            % (installed, server_version)
        )
        return 0
    emit("New skill docs available: skill %s → %s." % (installed, server_version))
    tarball = _download_bytes(
        str(skill["url"]), "skill bundle %s" % server_version, ctx.server
    )
    want = str(skill["sha256"]).lower()
    got = hashlib.sha256(tarball).hexdigest()
    if got != want:
        raise HubError(
            "config",
            "sha256 MISMATCH for the downloaded skill bundle %s: expected %s, "
            "got %s. The installed skill files are NOT touched."
            % (server_version, want, got),
        )
    tmpdir = tempfile.mkdtemp(prefix="hub-skill-")
    try:
        staging = os.path.join(tmpdir, "bundle")
        os.makedirs(staging)
        _safe_extract_skill_bundle(tarball, staging)
        refreshed = _install_skill_docs(staging, skill_dir)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    emit("Skill docs refreshed to %s: %s." % (server_version, ", ".join(refreshed)))
    return 0


def _latest_release(client):
    """Fetch and validate GET /v2/client/latest (unauthenticated)."""
    try:
        payload = client.call("GET", "/v2/client/latest", auth=False, retries=1)
    except HubError as exc:
        raise HubError(
            exc.code,
            "Could not check for updates at /v2/client/latest: %s" % exc,
            http_status=exc.http_status,
            server_code=exc.server_code,
        )
    return _validate_client_manifest(payload)


def cmd_upgrade(args, transport):
    """Upgrade to the latest signed CLI release.

    Checks GET /v2/client/latest, downloads the new artifact when newer,
    verifies sigstore signature + sha256, self-tests the candidate, swaps
    it in atomically, and keeps the previous binary as <script>.prev for
    `hub rollback`. No-op (exit 0) when already current.

    The three assets are downloaded from THIS server's download endpoints
    (assets.{hub,sigstore,manifest} in the manifest) — never GitHub.
    Verification is unchanged: sha256 against both the server manifest and
    the release manifest, mandatory sigstore check, self-test before AND
    after the atomic cutover.

    After the binary flow, a skill-docs refresh phase runs: when the
    server's skill bundle (manifest `skill` block, contract §3.6) is newer
    than the installed skill docs, the verified tarball's doc files
    (SKILL.md, INSTALL.md, requirements.txt, references/) are refreshed.
    It runs whether or not the binary was upgraded — skill and CLI versions
    are independent.
    """
    current = _cli_version()
    emit("hub %s — checking for updates…" % current)
    ctx = _ctx(args, transport, need_auth=False)
    manifest = _latest_release(ctx.client)
    _binary_upgrade_flow(current, ctx, manifest)
    _refresh_skill_docs(ctx, manifest)
    return 0


def _binary_upgrade_flow(current, ctx, manifest):
    """The binary-upgrade flow for `hub upgrade`.

    Moved verbatim out of cmd_upgrade (only indentation changed) so the
    skill-docs refresh phase can run after it on every path — both when the
    binary was upgraded and when it was already current. The flow itself is
    unchanged: same checks, same messages, same atomic-swap + rollback
    behavior.
    """
    new_version = str(manifest["version"])
    emit("This server requires CLI ≥ %s." % manifest["min_cli_version"])
    if not _is_newer(new_version, current):
        emit(
            "Already current: hub %s (server advertises %s). Nothing to do."
            % (current, new_version)
        )
        return 0
    emit("New release available: %s → %s." % (current, new_version))

    want = str(manifest["sha256"]).lower()
    assets = manifest["assets"]
    hub_url = str(assets["hub"])
    bundle_url = str(assets["sigstore"])
    rel_manifest_url = str(assets["manifest"])
    tmpdir = tempfile.mkdtemp(prefix="hub-upgrade-")
    try:
        artifact = _download_bytes(hub_url, "hub %s" % new_version, ctx.server)
        got = hashlib.sha256(artifact).hexdigest()
        if got != want:
            raise HubError(
                "config",
                "sha256 MISMATCH for the downloaded hub %s: expected %s, "
                "got %s. The artifact is NOT installed."
                % (new_version, want, got),
            )
        bundle = _download_bytes(bundle_url, _RELEASE_ASSET_BUNDLE, ctx.server)
        rel_manifest_raw = _download_bytes(
            rel_manifest_url, _RELEASE_ASSET_MANIFEST, ctx.server
        )
        try:
            rel_manifest = json.loads(rel_manifest_raw.decode("utf-8"))
        except ValueError:
            raise HubError(
                "config",
                "The release manifest.json is not valid JSON; refusing.",
            )
        if str(rel_manifest.get("sha256", "")).lower() != want:
            raise HubError(
                "config",
                "Release manifest.json disagrees with the server manifest "
                "on sha256; refusing.",
            )
        if str(rel_manifest.get("version", "")) != new_version:
            raise HubError(
                "config",
                "Release manifest.json disagrees with the server manifest "
                "on version; refusing.",
            )

        art_path = os.path.join(tmpdir, _RELEASE_ASSET_HUB)
        bundle_path = os.path.join(tmpdir, _RELEASE_ASSET_BUNDLE)
        with open(art_path, "wb") as fh:
            fh.write(artifact)
        # 0755: the candidate must be executable for its self-test. It lives
        # in a 0700 temp dir and its bytes are the sha256-verified artifact.
        os.chmod(art_path, 0o755)  # nosec B103
        with open(bundle_path, "wb") as fh:
            fh.write(bundle)

        emit("Verifying sigstore signature…")
        _verify_sigstore(art_path, bundle_path)
        emit("Signature OK. Running the candidate's self-test…")
        _self_test(art_path, expect_version=new_version)

        target = _script_path()
        install_dir = os.path.dirname(target) or "."
        emit("Installing to %s…" % target)
        # Keep the previous binary for rollback *before* cutting over.
        shutil.copy2(target, target + _ROLLBACK_SUFFIX)
        try:
            _atomic_install(artifact, target)
        except BaseException as exc:
            raise HubError(
                "config",
                "Install failed (%s); the previous binary is kept at %s%s."
                % (exc, target, _ROLLBACK_SUFFIX),
            )
        try:
            _self_test(target, expect_version=new_version)
        except HubError as exc:
            # Cut-over self-test failed: restore the previous binary.
            shutil.copy2(target + _ROLLBACK_SUFFIX, target)
            raise HubError(
                "config",
                "The new binary failed its self-test after install (%s); "
                "restored the previous version." % exc,
            )
        # Contract C5: integrity manifest + bundle live next to the CLI.
        _write_integrity_manifest(install_dir, new_version, want)
        shutil.copy2(bundle_path, os.path.join(install_dir, _RELEASE_ASSET_BUNDLE))
        emit("Upgraded hub %s → %s." % (current, new_version))
        emit(
            "Previous binary kept at %s%s — `hub rollback` restores it."
            % (target, _ROLLBACK_SUFFIX)
        )
        emit(
            "Note: keep the rest of the skill files (e.g. SKILL.md) in "
            "lockstep with the CLI version."
        )
        return 0
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)




def cmd_rollback(args, transport):
    """Restore the previous CLI binary saved by `hub upgrade`.

    Atomically swaps <script>.prev back into place, self-tests it, and
    keeps the rolled-back-from binary as the new fallback (so a second
    `hub rollback` rolls forward again).
    """
    target = _script_path()
    prev = target + _ROLLBACK_SUFFIX
    if not os.path.exists(prev):
        raise HubError(
            "config",
            "No previous binary to roll back to (%s is missing). Only "
            "`hub upgrade` leaves one." % prev,
        )
    emit("Self-testing the previous binary…")
    _self_test(prev)
    with open(target, "rb") as fh:
        current_data = fh.read()
    with open(prev, "rb") as fh:
        prev_data = fh.read()
    _atomic_install(prev_data, target)
    try:
        _self_test(target)
    except HubError:
        _atomic_install(current_data, target)
        raise HubError(
            "config",
            "The previous binary failed its self-test after restore; "
            "kept the current version.",
        )
    _atomic_install(current_data, prev)
    emit("Rolled back: %s is restored from %s." % (target, prev))
    return 0


# ---------------------------------------------------------------------------
# Server version contract (spec §1, §4.2–§4.3)
# ---------------------------------------------------------------------------
#
# Once per process, before any server-touching command runs, the CLI fetches
# GET /v2/health (unauthenticated, cheap) and requires:
#   1. server_version >= _MIN_SERVER_VERSION, AND
#   2. the server's advertised `api_versions` includes an API major this
#      CLI implements (v2).
# Outside this the CLI fails loudly with upgrade instructions — never
# silently, never by guessing. There is no env var, flag, or config that
# skips this check; the only exemptions are commands that never touch the
# server at all (see _LOCAL_COMMANDS), plus --version/--help which exit in
# argparse before main() runs.

# Selected API major for this process, set once by _require_server_version.
# Stays "v1" for exempt local flows (no check) and until the check runs.
_api_major = "v2"
# server_url -> selected API major. The check is one call per process per
# server, not per sub-request.
_version_check_cache = {}


def _reset_server_version_cache():
    """Clear the per-process version-check cache. Test hook only."""
    global _api_major
    _api_major = "v2"
    _version_check_cache.clear()


def _version_at_least(version, floor):
    """True when semver `version` >= `floor`.

    A prerelease of the floor triple itself (e.g. 0.12.0-rc1 vs floor
    0.12.0) does NOT satisfy the floor. Unparseable input never does.
    """
    try:
        have = _parse_version(version)
        want = _parse_version(floor)
    except HubError:
        return False
    if have[:3] != want[:3]:
        return have[:3] > want[:3]
    return not have[3]


def _select_api_major(api_versions):
    """Highest API major this CLI implements that the server advertises.

    Returns None when there is no overlap (or the field is missing /
    malformed) — the caller treats that as "too old".
    """
    if not isinstance(api_versions, list):
        return None
    for major in _API_MAJORS_IMPLEMENTED:
        if major in api_versions:
            return major
    return None


def _require_server_version(args, transport):
    """Per-invocation gate: fail loudly when the server is too old.

    Fetches GET /v2/health (unauthenticated) once per process per server
    and caches the result; sets the process-wide API major used to prefix
    requests. Raises HubError("version") with the exact contract message
    when the server is below the floor or advertises no usable API major.
    An unreachable server propagates the existing "connection" error —
    never a version error. No-server-configured propagates the existing
    config error.
    """
    global _api_major
    # `setup` names its server flag --server but argparse stores it as
    # setup_server (normalized by _wrap_setup when the command runs).
    # Mirror that here so the pre-command check uses the same server.
    if getattr(args, "setup_server", None):
        args.server = args.setup_server
    if getattr(args, "resume", False):
        try:
            with open(_pending_enrollment(args.profile), encoding="utf-8") as stream:
                args.server = json.load(stream)["server"]
        except FileNotFoundError:
            raise HubError("config", "No enrollment is pending for this profile.")
    ctx = _ctx(args, transport, need_auth=False)
    cached = _version_check_cache.get(ctx.server)
    if cached is not None:
        _api_major = cached
        return
    health = ctx.client.call("GET", "/v2/health", auth=False, retries=1)
    if not isinstance(health, dict):
        health = {}
    srv_ver = health.get("version")
    major = _select_api_major(health.get("api_versions"))
    if not _version_at_least(srv_ver, _MIN_SERVER_VERSION) or major is None:
        raise HubError(
            "version",
            "hub %s needs server %s+ (this server runs %s). "
            "Ask the server operator to upgrade."
            % (VERSION, _MIN_SERVER_VERSION, srv_ver if srv_ver else "unknown"),
        )
    _api_major = major
    _version_check_cache[ctx.server] = major


def _apply_api_major(path):
    """Rewrite the /v2/ prefix to the API major selected by the version check."""
    if _api_major != "v2" and path.startswith("/v2/"):
        return "/" + _api_major + path[3:]
    return path



def _script_dir():
    """Directory containing the `hub` script itself."""
    return os.path.dirname(os.path.abspath(__file__))


def _read_toml_version():
    """Version from the `pyproject.toml` next to the script, or None."""
    try:
        with open(
            os.path.join(_script_dir(), "pyproject.toml"), "r", encoding="utf-8"
        ) as f:
            toml_text = f.read()
    except OSError:
        return None
    match = re.search(r'^version\s*=\s*"([^"]+)"', toml_text, re.M)
    return match.group(1) if match else None


def _installed_version():
    """Installed `family-hub-cli` package version, or None when the CLI was
    not installed via pip (single-file / dev checkout)."""
    try:
        from importlib import metadata

        return metadata.version("family-hub-cli")
    except Exception:  # noqa: BLE001 -- expected outside pip installs
        return None


def _cli_version():
    """CLI version, read from the single source of truth (contract C6).

    `agent-skill/pyproject.toml` owns the version. When installed as the
    `family-hub-cli` package, installed metadata wins; otherwise the TOML
    next to the script is read (dev checkout / single-file install).
    "0.0.0-dev" only when neither is available.
    """
    return _installed_version() or _read_toml_version() or "0.0.0-dev"


def _skill_version():
    """Skill version from the `<!-- SKILL VERSION: x.y.z -->` header of
    SKILL.md next to the script. Kept in lockstep with the CLI version;
    "unknown" only when the header or the file is missing (dev checkout)."""
    try:
        with open(
            os.path.join(_script_dir(), "SKILL.md"), "r", encoding="utf-8"
        ) as f:
            head = f.read(2048)
    except OSError:
        return "unknown"
    match = re.search(r"<!--\s*SKILL VERSION:\s*([0-9A-Za-z.\-+]+)\s*-->", head)
    return match.group(1) if match else "unknown"


VERSION = _cli_version()
SKILL_VERSION = _skill_version()


# ---------------------------------------------------------------------------
# Secret handling / redaction
# ---------------------------------------------------------------------------

_REDACT_VALUES = []


def note_secret(value):
    """Register a secret value so redact() can scrub it from all output."""
    if value and value not in _REDACT_VALUES:
        _REDACT_VALUES.append(value)


def clear_secrets():
    del _REDACT_VALUES[:]


def redact(text):
    """Scrub every registered secret from text. Never fails."""
    if text is None:
        return ""
    out = str(text)
    for secret in _REDACT_VALUES:
        if secret and len(secret) >= 8 and secret in out:
            out = out.replace(secret, "[redacted]")
    return out


def emit(msg=""):
    sys.stdout.write(redact(msg) + "\n")


def emit_err(msg=""):
    sys.stderr.write(redact(msg) + "\n")


def emit_json(obj):
    sys.stdout.write(redact(json.dumps(obj, indent=2, ensure_ascii=False)) + "\n")


# ---------------------------------------------------------------------------
# Debug-output scrubbing. _debug_dump runs *inside* client.call, i.e. before
# a freshly minted token (redeem response) can be registered with
# note_secret(), so redact() alone cannot protect it. These scrubs are
# structural and need no registration.
# ---------------------------------------------------------------------------

_SENSITIVE_JSON_KEYS = frozenset({"token", "provisioning_code", "provisioningCode"})


def _scrub_sensitive_value(obj):
    """Recursively replace sensitive JSON values with [redacted]."""
    if isinstance(obj, dict):
        return {
            k: ("[redacted]" if k in _SENSITIVE_JSON_KEYS
                else _scrub_sensitive_value(v))
            for k, v in obj.items()
        }
    if isinstance(obj, list):
        return [_scrub_sensitive_value(v) for v in obj]
    return obj


def _scrub_sensitive_text(text):
    """Scrub secrets from a debug-dump payload.

    JSON bodies get sensitive fields redacted structurally. Non-JSON text
    passes through unchanged (redact() still applies to registered values).
    Never raises.
    """
    if not text:
        return ""
    try:
        parsed = json.loads(text)
    except ValueError:
        return text
    if isinstance(parsed, (dict, list)):
        try:
            return json.dumps(_scrub_sensitive_value(parsed))
        except (TypeError, ValueError):
            return "[unprintable]"
    return text


_CODE_IN_URL = re.compile(r"(fhp_|fhi_)[^/?#\s]*")


def _scrub_url(url):
    """Redact bearer codes embedded in URL paths.

    note_secret() covers the literal code, but URL-quoting can alter its
    bytes; the regex covers that edge.
    """
    return _CODE_IN_URL.sub(r"\1[redacted]", url or "")



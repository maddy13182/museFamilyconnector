def cmd_circle_create(args, transport):
    ctx = _ctx(args, transport)
    name = (args.name or "").strip()
    if not name:
        raise HubError("bad_request", "A non-empty --name is required.")
    check_pii(name)
    create_path = os.path.join(profile_dir(ctx.profile), "pending-circle-create.json")
    request_body = {"name": name, "kind": args.kind}
    if os.path.exists(create_path):
        with open(create_path, encoding="utf-8") as stream:
            pending = json.load(stream)
        if pending["server"] != ctx.server or pending["body"] != request_body:
            raise HubError("config", "A different circle creation is pending; resume that same command first.")
    else:
        pending = {"server": ctx.server, "body": request_body, "idempotency_key": uuid.uuid4().hex}
        _atomic_private_json(create_path, pending)
    circle = pending.get("response")
    if circle is None:
        try:
            circle = ctx.client.call("POST", "/v2/families", json_body=request_body,
                                     idempotency_key=pending["idempotency_key"]) or {}
        except HubError as exc:
            if exc.server_code == "circle_name_taken":
                os.unlink(create_path)
                raise HubError("bad_request", "A circle with that name already exists. Choose another name or inspect `hub circles`.")
            raise
        if not circle.get("id"):
            raise HubError("error", "Circle response is incomplete; pending creation preserved.")
        pending["response"] = circle
        _atomic_private_json(create_path, pending)
    cid = circle["id"]
    if cid not in {row.get("id") for row in _profile_circles(ctx)}:
        raise HubError("protocol", "Created circle was not returned as an active membership; pending creation preserved.")
    ctx.cfg["active_circle_id"] = cid
    save_config(ctx.profile, ctx.cfg)
    os.unlink(create_path)
    emit('created circle "%s" (id=%s) — now active' % (circle.get("name", name), cid))
    return 0


def cmd_circle_join(args, transport):
    """Join a circle with a provisioning or invite code someone shared."""
    ctx = _ctx(args, transport)
    # F11: the redeemed token is persisted to this profile's 0600 config —
    # prove the sink works BEFORE the single-use code is burned.
    _probe_profile_writable(ctx.profile)
    code = (args.code or "").strip()
    if not code:
        # Prompt rather than require argv: codes in argv land in shell
        # history and ps output.
        code = getpass.getpass("Invite or provisioning code: ").strip()
    if not code:
        raise HubError("bad_request", "An invite or provisioning code is required.")
    member = ctx.cfg.get("member") or {}
    display_name = (args.name or member.get("name") or "").strip()
    agent_label = (args.label or ctx.cfg.get("agent_label") or "").strip()
    token, new_member = _redeem_code(
        ctx.server, transport, args.debug, code, profile=ctx.profile,
        display_name=display_name, agent_label=agent_label,
        verification_code_file=getattr(args, "verification_code_file", None),
    )
    cid = new_member.get("family_id")
    if not cid:
        raise HubError("error", "Enrollment response has no circle ID. Pending enrollment preserved; export diagnostics.")
    _store_membership(ctx, cid, new_member)
    ctx.cfg["active_circle_id"] = cid
    save_config(ctx.profile, ctx.cfg)
    # F11: report success only after the new token proves it authenticates.
    diagnostic("credential_verification_started", flow="circle")
    _verify_new_token(ctx.server, transport, args.debug, token, "circle join", cid)
    diagnostic("credential_verified", flow="circle")
    _complete_enrollment(ctx.profile)
    # Friendly output: resolve the circle name with the new token.
    try:
        probe = HubClient(ctx.server, token, transport=transport)
        names = {
            c.get("id"): c.get("name")
            for c in _as_list(probe.call("GET", "/v2/families"), "families")
            if isinstance(c, dict)
        }
        cname = names.get(cid, cid)
    except HubError:
        cname = cid
    emit('joined circle "%s" (id=%s) — now active' % (cname, cid))
    return 0



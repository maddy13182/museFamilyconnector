def _redeem_code(server, transport, debug, code, display_name="",
                 agent_label=""):
    """Redeem a provisioning (fhp_) or invite (fhi_) code; no auth needed.

    Returns (token, member dict). The raw code is registered as a secret so
    it can never appear in output (e.g. the --debug URL dump).
    """
    note_secret(code)
    client = HubClient(server, token=None, debug=debug, transport=transport)
    if code.startswith("fhp_"):
        path = "/v1/provisioning-codes/%s/redeem" % urlparse.quote(code, safe="")
        body = {}
    else:
        path = "/v1/invites/%s/accept" % urlparse.quote(code, safe="")
        if not display_name or not agent_label:
            raise HubError(
                "bad_request",
                "Invite codes need --name and --label (or a configured "
                "profile member/label).",
            )
        body = {"display_name": display_name, "agent_label": agent_label}
    resp = client.call("POST", path, json_body=body, auth=False)
    if not isinstance(resp, dict) or "token" not in resp or "member" not in resp:
        raise HubError("error", "Unexpected redeem response from the server.")
    return resp["token"], resp["member"]


def _store_circle_token(ctx, circle_id, token, member):
    """Persist a circle token + member record; never prints the token."""
    note_secret(token)
    circle_tokens = ctx.cfg.get("circle_tokens") or {}
    circle_tokens[circle_id] = token
    ctx.cfg["circle_tokens"] = circle_tokens
    if isinstance(member, dict) and member.get("id"):
        circle_members = ctx.cfg.get("circle_members") or {}
        circle_members[circle_id] = {
            "id": member.get("id"),
            "name": member.get("name"),
            "role": member.get("role"),
            "email": member.get("email"),
        }
        ctx.cfg["circle_members"] = circle_members
    save_config(ctx.profile, ctx.cfg)


def cmd_circle_create(args, transport):
    ctx = _ctx(args, transport)
    name = (args.name or "").strip()
    if not name:
        raise HubError("bad_request", "A non-empty --name is required.")
    check_pii(name)
    # One idempotency key for the whole create→redeem flow, generated up
    # front: any retry (dropped connection, lost response) reuses it, so the
    # server returns the already-created circle instead of duplicating it.
    idem_key = uuid.uuid4().hex
    circle = None
    for cycle in range(3):
        try:
            circle = ctx.client.call(
                "POST",
                "/v1/families",
                json_body={"name": name, "kind": args.kind},
                idempotency_key=idem_key,
            ) or {}
        except HubError as exc:
            if exc.server_code == "circle_name_taken":
                raise HubError(
                    "bad_request",
                    'A circle named "%s" already exists. Circle names are '
                    "unique — pick another name or join the existing one with "
                    "`hub circles`." % name,
                )
            raise
        cid = circle.get("id")
        if not cid:
            raise HubError("error", "Server did not return a circle id.")
        code = circle.get("provisioning_code")
        if not code:
            # Older server: no auto-redeem possible; fall back to manual steps.
            emit('created circle "%s" (id=%s)' % (circle.get("name", name), cid))
            emit("select it with: hub circle use %s" % cid)
            return 0
        if circle.get("deduped") and args.debug:
            emit_err("hub debug: create dedup hit — server re-issued a fresh code")
        # Auto-redeem: mint this agent's token for the new circle immediately,
        # so the creator can use it without a second round-trip.
        try:
            token, member = _redeem_code(
                ctx.server, transport, args.debug, code,
            )
        except HubError as exc:
            # The redeem landed but its response was lost: the code is spent
            # and we hold no token. Loop back — the keyed create dedups and
            # hands us a fresh code.
            if exc.server_code == "code_used" and cycle < 2:
                if args.debug:
                    emit_err("hub debug: redeem already applied; re-issuing via dedup")
                continue
            raise
        break
    else:
        raise HubError("error", "Circle created but the token could not be issued; "
                                "run `hub circles` to check, then `hub circle join --code` "
                                "with a fresh code from an owner.")
    if member.get("family_id") and member.get("family_id") != cid:
        raise HubError(
            "error",
            "Redeem returned a member for a different circle; refusing to "
            "store the token.",
        )
    _store_circle_token(ctx, cid, token, member)
    ctx.cfg["active_circle_id"] = cid
    save_config(ctx.profile, ctx.cfg)
    emit('created circle "%s" (id=%s) — now active' % (circle.get("name", name), cid))
    return 0


def cmd_circle_join(args, transport):
    """Join a circle with a provisioning or invite code someone shared."""
    ctx = _ctx(args, transport, need_auth=False)
    # F11: the redeemed token is persisted to this profile's 0600 config —
    # prove the sink works BEFORE the single-use code is burned.
    _probe_profile_writable(ctx.profile)
    code = (args.code or "").strip()
    if not code:
        # Prompt rather than require argv: codes in argv land in shell
        # history and ps output.
        code = getpass.getpass("Invite or provisioning code: ").strip()
    if not code:
        raise HubError("bad_request", "An invite or provisioning code is required.")
    member = ctx.cfg.get("member") or {}
    display_name = (args.name or member.get("name") or "").strip()
    agent_label = (args.label or ctx.cfg.get("agent_label") or "").strip()
    try:
        token, new_member = _redeem_code(
            ctx.server, transport, args.debug, code,
            display_name=display_name, agent_label=agent_label,
        )
    except HubError as exc:
        # The redeem landed but its response was lost: this code is spent and
        # we hold no token. The server tells us who the member is — surface a
        # precise recovery step instead of a cryptic error.
        if exc.server_code in ("code_used", "invite_used"):
            member_info = (exc.details or {}).get("member") or {}
            who = member_info.get("name") or display_name or "you"
            where = member_info.get("family_id") or "the circle"
            raise HubError(
                "auth",
                "This code was already used — %s is already a member (%s) but "
                "this device holds no token for it. Ask an owner for a fresh "
                "invite code and run `hub circle join --code` again."
                % (who, where),
            )
        raise
    cid = new_member.get("family_id")
    if not cid:
        # The token is issued and irreplaceable — never lose it over a
        # malformed response. Fall back to resolving the circle with the new
        # token itself: it is scoped to exactly the circle just joined.
        if args.debug:
            emit_err("hub debug: redeem response lacked family_id; resolving via /v1/families")
        probe = HubClient(ctx.server, token, transport=transport)
        fams = [
            c for c in _as_list(probe.call("GET", "/v1/families"), "families")
            if isinstance(c, dict) and c.get("id")
        ]
        if len(fams) == 1:
            cid = fams[0]["id"]
    if not cid:
        # Truly unresolvable — but the token must still survive. Persist it
        # keyed by member id and give a precise recovery step instead of
        # dropping the credential.
        mid = new_member.get("id") or "redeemed"
        _store_circle_token(ctx, "pending-" + str(mid), token, new_member)
        raise HubError(
            "error",
            "Joined, but the circle could not be identified. Your token was "
            "saved — run `hub circles` to find the circle, then "
            "`hub circle use <id>`.",
        )
    _store_circle_token(ctx, cid, token, new_member)
    ctx.cfg["active_circle_id"] = cid
    save_config(ctx.profile, ctx.cfg)
    # F11: report success only after the new token proves it authenticates.
    _verify_new_token(ctx.server, transport, args.debug, token, "circle join")
    # Friendly output: resolve the circle name with the new token.
    try:
        probe = HubClient(ctx.server, token, transport=transport)
        names = {
            c.get("id"): c.get("name")
            for c in _as_list(probe.call("GET", "/v1/families"), "families")
            if isinstance(c, dict)
        }
        cname = names.get(cid, cid)
    except HubError:
        cname = cid
    emit('joined circle "%s" (id=%s) — now active' % (cname, cid))
    return 0


def cmd_circle_use(args, transport):
    ctx = _ctx_loose(args, transport)
    cid = _match_circle(_list_circles(ctx.client), args.target)
    ctx.cfg["active_circle_id"] = cid
    save_config(ctx.profile, ctx.cfg)
    emit("active circle set to %s" % cid)
    if not _has_usable_token(ctx.cfg, ctx.profile, cid):
        emit_err(
            "warning: no token stored for this circle — run "
            "`hub circle join --code <invite code>` to join it."
        )
    return 0


def _transfer_path(family_id, suffix=""):
    return "/v1/families/%s/transfer%s" % (
        urlparse.quote(family_id, safe=""), suffix)


def _emit_transfer_result(resp):
    """Print a transfer endpoint response — structural secret-scrubbed.

    These endpoints never issue credentials (only IDs), but if a server
    ever slipped a secret field into its response, it must not reach
    stdout — hence the scrub (same keys as the debug-dump scrubber).
    """
    emit_json(_scrub_sensitive_value(resp if isinstance(resp, dict) else
                                     {"ok": True}))
    return 0


def cmd_circle_transfer(args, transport):
    """Initiate an ownership transfer of the active circle (owner only)."""
    ctx = _ctx(args, transport)
    family_id = _resolve_circle(args, ctx)
    to_member_id = (args.to_member or "").strip()
    if not to_member_id:
        raise HubError("bad_request", "A --to member id is required.")
    resp = ctx.client.call(
        "POST",
        _transfer_path(family_id),
        json_body={"to_member_id": to_member_id,
                   "on_complete": args.on_complete},
    )
    return _emit_transfer_result(resp)


def cmd_circle_transfer_accept(args, transport):
    """Accept a pending ownership transfer of the active circle."""
    ctx = _ctx(args, transport)
    family_id = _resolve_circle(args, ctx)
    body = {}
    transfer_id = (args.transfer_id or "").strip()
    if transfer_id:
        body["transfer_id"] = transfer_id
    resp = ctx.client.call(
        "POST",
        _transfer_path(family_id, "/accept"),
        json_body=body,
    )
    return _emit_transfer_result(resp)


def cmd_circle_transfer_status(args, transport):
    """Show the pending ownership transfer for the active circle, if any."""
    ctx = _ctx(args, transport)
    family_id = _resolve_circle(args, ctx)
    resp = ctx.client.call("GET", _transfer_path(family_id))
    if isinstance(resp, dict) and "transfer" in resp:
        transfer = resp.get("transfer")
    elif resp:
        transfer = resp
    else:
        transfer = None
    if transfer is None:
        emit("none")
        return 0
    emit_json(_scrub_sensitive_value(transfer))
    return 0


def cmd_circle_transfer_cancel(args, transport):
    """Cancel the pending ownership transfer of the active circle (owner only)."""
    ctx = _ctx(args, transport)
    family_id = _resolve_circle(args, ctx)
    resp = ctx.client.call(
        "POST",
        _transfer_path(family_id, "/cancel"),
    )
    return _emit_transfer_result(resp)


def cmd_dashboard_token(args, transport):
    """Print the stored token for a circle (for pasting into the dashboard).

    The ONLY command that prints a token — and a HUMAN admin command, not
    an agent command. Agents must never run it or transmit its output: the
    raw credential goes to stdout, visible to anyone who can see the tool
    output. The warning precedes the token; the token is written raw
    (bypassing redaction) so it stays usable.
    """
    ctx = _ctx_loose(args, transport)
    cid = _match_circle(_list_circles(ctx.client), args.circle)
    tok = (ctx.cfg.get("circle_tokens") or {}).get(cid)
    tok = str(tok).strip() if tok else ""
    if not tok:
        if cid == ctx.cfg.get("family_id"):
            try:
                tok, _src = load_token(ctx.cfg, ctx.profile)
            except HubError:
                tok = None
        if not tok:
            raise HubError(
                "auth",
                "No token stored for this circle. Run "
                "`hub circle join --code <invite code>` first.",
            )
    note_secret(tok)  # keep it out of any later redacted output
    emit(
        "WARNING: this token is a password-equivalent credential. "
        "Never share it, never paste it anywhere untrusted."
    )
    sys.stdout.write(str(tok).strip() + "\n")
    return 0

# ---------------------------------------------------------------------------
# CLI self-upgrade (WS-C: release management)
#
# `hub upgrade` pulls the signed release advertised by
# GET /v1/client/latest, verifies it (sigstore signature + sha256), and
# swaps it in atomically, keeping the previous binary for `hub rollback`.
# It also records the installed release next to the CLI (contract C5) for
# WS-E's `hub verify-install`.
#
# Tamper-evidence limit (docs/CLIENT_HARDENING_SPEC.md §2): this defends
# the *supply chain* — what gets installed — plus accidental corruption
# and casual tampering. It cannot stop a root-level adversary on this
# machine (root can read agent.key and the bearer token straight off
# disk); that limit is documented, not hand-waved.
# ---------------------------------------------------------------------------

# Signed artifacts live on GitHub Releases. The release workflow signs with
# GitHub Actions' keyless OIDC signer (sigstore-python), so the expected
# certificate identity pins this repo's release workflow on main.
_RELEASE_IDENTITY_ISSUER = "https://token.actions.githubusercontent.com"
_RELEASE_IDENTITY = (
    "https://github.com/maddy13182/museFamilyconnector"
    "/.github/workflows/release.yml@refs/heads/main"
)
_RELEASE_ASSET_HUB = "hub"
_RELEASE_ASSET_BUNDLE = "hub.sigstore"
_RELEASE_ASSET_MANIFEST = "manifest.json"
_ROLLBACK_SUFFIX = ".prev"

_VERSION_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)([-+][0-9A-Za-z.-]+)?$")
_MANIFEST_URL_RE = re.compile(
    r"^https://github\.com/[^/]+/[^/]+/releases/download/[^/]+/hub$"
)
_SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")


def _script_path():
    """Absolute path of the running `hub` script (symlinks resolved)."""
    here = globals().get("__file__") or sys.argv[0]
    return os.path.realpath(os.path.abspath(here))


def _cli_version():
    """The installed CLI version.

    Contract C6 names ``agent-skill/pyproject.toml`` the single source of
    truth (WS-A owns the canonical reader). Until that lands, prefer the
    TOML next to this script and fall back to the legacy ``VERSION``
    constant, so upgrade works in both states.
    """
    pyproject = os.path.join(
        os.path.dirname(_script_path()), "pyproject.toml"
    )
    try:
        with open(pyproject, "r", encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r'\s*version\s*=\s*"([^"]+)"\s*$', line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return VERSION


def _parse_version(text):
    """Parse ``x.y.z[-pre]`` into (major, minor, patch, pre)."""
    m = _VERSION_RE.match(str(text).strip())
    if not m:
        raise HubError(
            "bad_request",
            "Unparseable version %r (expected semver like 0.7.0)." % (text,),
        )
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4) or "")


def _is_newer(candidate, current):
    """True when `candidate` is strictly newer than `current`.

    (major, minor, patch) compare first; a stable release beats its own
    prerelease (0.7.0 > 0.7.0-rc1); prereleases compare lexically.
    """
    cand = _parse_version(candidate)
    cur = _parse_version(current)
    if cand[:3] != cur[:3]:
        return cand[:3] > cur[:3]
    if cand[3] == cur[3]:
        return False
    if not cand[3]:
        return True  # stable beats a prerelease of the same numbers
    if not cur[3]:
        return False
    return cand[3] > cur[3]


def _validate_client_manifest(obj):
    """Validate a GET /v1/client/latest payload (contract C2).

    Returns the manifest dict; raises HubError on any schema violation.
    """
    if not isinstance(obj, dict):
        raise HubError("bad_request", "Client manifest is not a JSON object.")
    for field in ("version", "download_url", "sha256"):
        if not obj.get(field):
            raise HubError(
                "bad_request", "Client manifest is missing %r." % (field,)
            )
    _parse_version(obj["version"])  # raises on garbage
    if not _MANIFEST_URL_RE.match(str(obj["download_url"])):
        raise HubError(
            "bad_request",
            "Client manifest download_url is not a GitHub Release asset "
            "URL: %r." % (obj["download_url"],),
        )
    if not _SHA256_RE.match(str(obj["sha256"])):
        raise HubError(
            "bad_request", "Client manifest sha256 is not 64 hex chars."
        )
    return obj


def _validate_download_url(url):
    """Only https GitHub Release asset URLs are acceptable download sources."""
    parts = urlparse.urlparse(str(url))
    if parts.scheme != "https":
        raise HubError(
            "bad_request",
            "Refusing to download over a non-https URL: %r." % (url,),
        )
    if parts.hostname != "github.com":
        raise HubError(
            "bad_request",
            "Refusing to download from unexpected host %r (expected "
            "github.com)." % (parts.hostname,),
        )


def _download_bytes(url, what, timeout=90):
    """Fetch a release asset. Raises HubError on any failure."""
    _validate_download_url(url)
    req = urlrequest.Request(
        url,
        headers={
            # Cloudflare bot protection blocks Python-urllib's default UA;
            # identify honestly as the family-hub agent client.
            "User-Agent": "family-hub-agent/" + _cli_version(),
            "Accept": "application/octet-stream",
        },
    )
    try:
        with urlrequest.urlopen(req, timeout=timeout) as resp:  # nosec B310 -- URL is the validated GitHub Release asset URL
            if resp.status != 200:
                raise HubError(
                    "connection",
                    "Download of %s failed: HTTP %d." % (what, resp.status),
                )
            data = resp.read()
    except urlerror.URLError as exc:
        raise HubError("connection", "Download of %s failed: %s." % (what, exc))
    if not data:
        raise HubError("connection", "Download of %s returned an empty body." % what)
    return data


def _have_sigstore():
    """True when the `sigstore` package can run (needed to verify releases)."""
    try:
        # Fixed argv; no untrusted input.
        proc = subprocess.run(  # nosec B603
            [sys.executable, "-m", "sigstore", "--version"],
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.returncode == 0


def _verify_sigstore(artifact_path, bundle_path):
    """Verify the sigstore bundle against the artifact; raise on failure.

    A missing `sigstore` package is a hard refusal (with the install
    command), not a skipped check — an unverified upgrade is a failed
    upgrade. Verification is networked (Rekor / timestamp lookups).
    """
    if not _have_sigstore():
        raise HubError(
            "config",
            "Cannot verify the release signature: the `sigstore` package is "
            "not installed. Run `pip install sigstore`, then retry "
            "`hub upgrade`. The upgrade is refused rather than skipping "
            "signature verification.",
        )
    cmd = [
        sys.executable,
        "-m",
        "sigstore",
        "verify",
        "identity",
        "--bundle",
        bundle_path,
        "--cert-identity",
        _RELEASE_IDENTITY,
        "--cert-oidc-issuer",
        _RELEASE_IDENTITY_ISSUER,
        artifact_path,
    ]
    try:
        # Fixed argv; only internal temp paths vary. No shell.
        proc = subprocess.run(cmd, capture_output=True, timeout=180)  # nosec B603
    except (OSError, subprocess.SubprocessError) as exc:
        raise HubError("config", "sigstore verification could not run: %s." % exc)
    if proc.returncode != 0:
        detail = (proc.stderr or b"").decode("utf-8", "replace").strip().splitlines()
        raise HubError(
            "config",
            "Signature verification FAILED for the downloaded CLI: %s "
            "The artifact is NOT installed — the current version is kept."
            % (detail[-1] if detail else "no detail from sigstore."),
        )


def _self_test(path, expect_version=None):
    """Run the candidate binary's --version; raise HubError when it fails."""
    try:
        # Fixed argv; `path` is the upgrade candidate or the installed CLI.
        proc = subprocess.run(
            [sys.executable, path, "--version"], capture_output=True, timeout=60
        )  # nosec B603
    except (OSError, subprocess.SubprocessError) as exc:
        raise HubError("config", "Self-test could not run %s: %s." % (path, exc))
    out = (proc.stdout or b"").decode("utf-8", "replace")
    if proc.returncode != 0:
        raise HubError(
            "config",
            "Self-test FAILED for %s (exit %d): %s"
            % (path, proc.returncode, out.strip()[:200]),
        )
    if expect_version and expect_version not in out:
        raise HubError(
            "config",
            "Self-test version mismatch for %s: expected %s in %r."
            % (path, expect_version, out.strip()[:200]),
        )


def _atomic_install(data, target):
    """Write `data` to `target` atomically, preserving the existing mode.

    The temp file lives in the target directory (same filesystem, so
    os.replace is atomic) and is fsynced before the rename. A failure
    leaves the old file untouched.
    """
    directory = os.path.dirname(target) or "."
    try:
        mode = stat.S_IMODE(os.stat(target).st_mode)
    except OSError:
        mode = 0o755
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".hub-upgrade-")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _write_integrity_manifest(install_dir, version, sha256):
    """Record the installed release next to the CLI (contract C5).

    ``{version, files: {hub: sha256}, signature, identity}`` — consumed by
    WS-E's `hub verify-install`, which re-checks the installed file's
    sha256 and validates the sigstore bundle saved alongside it.
    """
    manifest = {
        "version": version,
        "files": {_RELEASE_ASSET_HUB: sha256},
        "signature": _RELEASE_ASSET_BUNDLE,
        "identity": {
            "issuer": _RELEASE_IDENTITY_ISSUER,
            "identity": _RELEASE_IDENTITY,
        },
    }
    tmp = os.path.join(install_dir, ".manifest.json.tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, os.path.join(install_dir, "manifest.json"))


def _latest_release(client):
    """Fetch and validate GET /v1/client/latest (unauthenticated)."""
    try:
        payload = client.call("GET", "/v1/client/latest", auth=False, retries=1)
    except HubError as exc:
        raise HubError(
            exc.code,
            "Could not check for updates at /v1/client/latest: %s" % exc,
            http_status=exc.http_status,
            server_code=exc.server_code,
        )
    return _validate_client_manifest(payload)


def _release_asset_urls(manifest):
    """Derive the bundle + release-manifest URLs from the hub download URL."""
    dl = str(manifest["download_url"])
    base = re.sub(r"/hub$", "", dl)
    return (
        dl,
        base + "/" + _RELEASE_ASSET_BUNDLE,
        base + "/" + _RELEASE_ASSET_MANIFEST,
    )


def cmd_upgrade(args, transport):
    """Upgrade to the latest signed CLI release.

    Checks GET /v1/client/latest, downloads the new artifact when newer,
    verifies sigstore signature + sha256, self-tests the candidate, swaps
    it in atomically, and keeps the previous binary as <script>.prev for
    `hub rollback`. No-op (exit 0) when already current.
    """
    current = _cli_version()
    emit("hub %s — checking for updates…" % current)
    ctx = _ctx(args, transport, need_auth=False)
    manifest = _latest_release(ctx.client)
    new_version = str(manifest["version"])
    if not _is_newer(new_version, current):
        emit(
            "Already current: hub %s (server advertises %s). Nothing to do."
            % (current, new_version)
        )
        return 0
    emit("New release available: %s → %s." % (current, new_version))

    want = str(manifest["sha256"]).lower()
    hub_url, bundle_url, rel_manifest_url = _release_asset_urls(manifest)
    tmpdir = tempfile.mkdtemp(prefix="hub-upgrade-")
    try:
        artifact = _download_bytes(hub_url, "hub %s" % new_version)
        got = hashlib.sha256(artifact).hexdigest()
        if got != want:
            raise HubError(
                "config",
                "sha256 MISMATCH for the downloaded hub %s: expected %s, "
                "got %s. The artifact is NOT installed."
                % (new_version, want, got),
            )
        bundle = _download_bytes(bundle_url, _RELEASE_ASSET_BUNDLE)
        rel_manifest_raw = _download_bytes(
            rel_manifest_url, _RELEASE_ASSET_MANIFEST
        )
        try:
            rel_manifest = json.loads(rel_manifest_raw.decode("utf-8"))
        except ValueError:
            raise HubError(
                "config",
                "The release manifest.json is not valid JSON; refusing.",
            )
        if str(rel_manifest.get("sha256", "")).lower() != want:
            raise HubError(
                "config",
                "Release manifest.json disagrees with the server manifest "
                "on sha256; refusing.",
            )
        if str(rel_manifest.get("version", "")) != new_version:
            raise HubError(
                "config",
                "Release manifest.json disagrees with the server manifest "
                "on version; refusing.",
            )

        art_path = os.path.join(tmpdir, _RELEASE_ASSET_HUB)
        bundle_path = os.path.join(tmpdir, _RELEASE_ASSET_BUNDLE)
        with open(art_path, "wb") as fh:
            fh.write(artifact)
        # 0755: the candidate must be executable for its self-test. It lives
        # in a 0700 temp dir and its bytes are the sha256-verified artifact.
        os.chmod(art_path, 0o755)  # nosec B103
        with open(bundle_path, "wb") as fh:
            fh.write(bundle)

        emit("Verifying sigstore signature…")
        _verify_sigstore(art_path, bundle_path)
        emit("Signature OK. Running the candidate's self-test…")
        _self_test(art_path, expect_version=new_version)

        target = _script_path()
        install_dir = os.path.dirname(target) or "."
        emit("Installing to %s…" % target)
        # Keep the previous binary for rollback *before* cutting over.
        shutil.copy2(target, target + _ROLLBACK_SUFFIX)
        try:
            _atomic_install(artifact, target)
        except BaseException as exc:
            raise HubError(
                "config",
                "Install failed (%s); the previous binary is kept at %s%s."
                % (exc, target, _ROLLBACK_SUFFIX),
            )
        try:
            _self_test(target, expect_version=new_version)
        except HubError as exc:
            # Cut-over self-test failed: restore the previous binary.
            shutil.copy2(target + _ROLLBACK_SUFFIX, target)
            raise HubError(
                "config",
                "The new binary failed its self-test after install (%s); "
                "restored the previous version." % exc,
            )
        # Contract C5: integrity manifest + bundle live next to the CLI.
        _write_integrity_manifest(install_dir, new_version, want)
        shutil.copy2(bundle_path, os.path.join(install_dir, _RELEASE_ASSET_BUNDLE))
        emit("Upgraded hub %s → %s." % (current, new_version))
        emit(
            "Previous binary kept at %s%s — `hub rollback` restores it."
            % (target, _ROLLBACK_SUFFIX)
        )
        emit(
            "Note: keep the rest of the skill files (e.g. SKILL.md) in "
            "lockstep with the CLI version."
        )
        return 0
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def cmd_rollback(args, transport):
    """Restore the previous CLI binary saved by `hub upgrade`.

    Atomically swaps <script>.prev back into place, self-tests it, and
    keeps the rolled-back-from binary as the new fallback (so a second
    `hub rollback` rolls forward again).
    """
    target = _script_path()
    prev = target + _ROLLBACK_SUFFIX
    if not os.path.exists(prev):
        raise HubError(
            "config",
            "No previous binary to roll back to (%s is missing). Only "
            "`hub upgrade` leaves one." % prev,
        )
    emit("Self-testing the previous binary…")
    _self_test(prev)
    with open(target, "rb") as fh:
        current_data = fh.read()
    with open(prev, "rb") as fh:
        prev_data = fh.read()
    _atomic_install(prev_data, target)
    try:
        _self_test(target)
    except HubError:
        _atomic_install(current_data, target)
        raise HubError(
            "config",
            "The previous binary failed its self-test after restore; "
            "kept the current version.",
        )
    _atomic_install(current_data, prev)
    emit("Rolled back: %s is restored from %s." % (target, prev))
    return 0



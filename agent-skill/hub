def cmd_tasks(args, transport):
    ctx = _ctx(args, transport)
    resp = ctx.client.call(
        "GET", "/v2/topics/%s/tasks" % urlparse.quote(args.topic, safe="")
    )
    tasks = _as_list(resp, "tasks")
    me = _member_for_circle(ctx.cfg, _active_circle_id(ctx.cfg)).get("id")
    wanted_assignee = me if args.assigned_to == "me" else args.assigned_to
    out = []
    for task in tasks:
        if not isinstance(task, dict):
            continue
        if wanted_assignee and task.get("assignee_member_id") != wanted_assignee:
            continue
        if args.status and task.get("status") != args.status:
            continue
        _e2ee_refresh_own_keys(ctx.client, ctx.profile, args.topic, quiet=True)
        for field in ("title", "description", "result"):
            if task.get(field) is not None:
                if not isinstance(task[field], str) or not task[field].startswith("fh1."):
                    raise HubError("error", "Refusing unencrypted task content from the server.")
                item = {"topic_id": args.topic, "body": task[field], "seq": "task " + field}
                _decrypt_entry_in_place(item, _load_topic_keys(ctx.profile, args.topic))
                task[field] = item["body"]
                if field == "result" and item["body"] != _E2EE_MISSING_KEY_BODY:
                    task[field] = json.loads(item["body"])
        out.append(task)
    emit_json(out)
    return 0



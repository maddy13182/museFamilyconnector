# Always-on, metadata-only diagnostics survive a failed non-debug invocation.
_DIAGNOSTIC_PROFILE = "default"
_DIAGNOSTIC_RUN = uuid.uuid4().hex
_DIAGNOSTIC_WARNED = False
_DIAGNOSTIC_STARTED = False


def diagnostic(event, **fields):
    """Private bounded JSONL; never pass bodies, headers, URLs or exception text."""
    global _DIAGNOSTIC_WARNED
    record = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
              "event": event, "run_id": _DIAGNOSTIC_RUN, "version": VERSION}
    record.update(fields)
    try:
        directory = profile_dir(_DIAGNOSTIC_PROFILE)
        os.makedirs(directory, mode=0o700, exist_ok=True)
        path = os.path.join(directory, "diagnostics.jsonl")
        flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path, flags, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            # Keep recent history bounded; logging must never interrupt
            # credential persistence. Older history is discarded at 1 MiB.
            if os.fstat(stream.fileno()).st_size > 1024 * 1024:
                stream.seek(0)
                stream.truncate(0)
            stream.write(json.dumps(record, sort_keys=True) + "\n")
            stream.flush()
    except OSError:
        if not _DIAGNOSTIC_WARNED:
            emit_err("warning: could not write private diagnostics; troubleshooting history is incomplete")
            _DIAGNOSTIC_WARNED = True



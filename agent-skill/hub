    briefing = _message_text(args, attr="briefing", file_attr="briefing_file")
    check_pii(args.subject, briefing)
    members = _id_list(args.with_)
    if not members:
        raise HubError("bad_request", "At least one participant member ID is required.")
    # N05 field-level contract (spec §1.5): on E2EE topics the briefing must
    # be fh1 (encrypted under the PARENT topic's current key); the subject
    # stays plaintext (routing metadata, as today). check_pii already ran
    # on the plaintext above — the server cannot scan ciphertext, so the
    # CLI is the enforcement point.
    trec = _fetch_topic_record(ctx.client, args.topic)
    if trec.get("e2ee") == 1:
        briefing = _e2ee_encrypt_content_field(ctx, trec, args.topic, briefing)
    topic = ctx.client.call(
        "POST",
        "/v1/topics/%s/spawn" % urlparse.quote(args.topic, safe=""),
        json_body={
            "subject": args.subject,
            "participant_member_ids": members,

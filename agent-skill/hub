import types


def _as_list(resp, key):
    """Tolerate {"key": [...]} or a bare [...] response."""
    if isinstance(resp, dict):
        val = resp.get(key, resp.get("items", []))
        return val if isinstance(val, list) else []
    return resp if isinstance(resp, list) else []


def _id_list(values):
    """Flatten ['a,b', 'c'] -> ['a', 'b', 'c']."""
    out = []
    for value in values or []:
        for part in str(value).split(","):
            part = part.strip()
            if part:
                out.append(part)
    return out


def _message_text(args, attr="message", file_attr="message_file"):
    if getattr(args, file_attr, None):
        path = getattr(args, file_attr)
        if path == "-":
            text = sys.stdin.read()
        else:
            with open(path, "r", encoding="utf-8") as fh:
                text = fh.read()
    else:
        text = getattr(args, attr, None)
    if not text or not text.strip():
        raise HubError("bad_request", "Message text is empty.")
    return text


# ---------------------------------------------------------------------------
# Server credential selection. Membership authorization stays on the server.
# ---------------------------------------------------------------------------


def _has_usable_token(cfg, profile, circle_id):
    return bool(os.environ.get("FAMILY_HUB_TOKEN", "").strip()
                or cfg.get("vault_cmd") or os.environ.get("FAMILY_HUB_VAULT_CMD")
                or os.path.exists(cfg.get("token_file") or default_token_path(profile)))


def _member_for_circle(cfg, circle_id):
    """This agent's member record for a circle (per-circle id/role)."""
    cm = (cfg.get("circle_members") or {}).get(circle_id) or {}
    if cm.get("id"):
        return cm
    return cfg.get("member") or {}


def _ctx(args, transport, need_auth=True):
    profile = args.profile
    cfg = load_config(profile)
    pinned = cfg.get("server_url")
    server = args.server or os.environ.get("FAMILY_HUB_URL") or pinned
    if not server:
        raise HubError(
            "bad_request", "No server configured. Use --server or run `hub setup`."
        )
    # F03: the enrollment origin is pinned; a differing --server must be
    # explicit, and plain http is only for loopback.
    _check_server_override(args, pinned, server)
    _validate_server_url(server)
    token = None
    if need_auth:
        token, _source = load_token(cfg, profile)
    client = HubClient(server, token, debug=args.debug, transport=transport, circle_id=_active_circle_id(cfg))
    ctx = types.SimpleNamespace(profile=profile, cfg=cfg, server=server, client=client, resolved_circle=None)
    if need_auth and getattr(args, "circle", None):
        cid = _match_circle(_profile_circles(ctx), args.circle)
        cfg["_request_circle_id"] = cid
        ctx.client.circle_id = ctx.resolved_circle = cid
    return ctx


def _ctx_loose(args, transport):
    return _ctx(args, transport)


def _retarget_client(ctx, args, circle_id):
    ctx.client = HubClient(ctx.server, ctx.client.token, debug=ctx.client.debug,
                           transport=ctx.client.transport, circle_id=circle_id)



# ---------------------------------------------------------------------------
# Circles (v0.2.0: a profile can belong to many circles; one is active)
# ---------------------------------------------------------------------------


def _active_circle_id(cfg):
    """Effective circle id: explicit active_circle_id, else the first enrolled family_id."""
    return cfg.get("_request_circle_id") or cfg.get("active_circle_id") or cfg.get("family_id")


def _list_circles(client):
    """GET /v2/families -> the circles this agent belongs to."""
    return _as_list(client.call("GET", "/v2/families"), "families")


def _profile_circles(ctx):
    """The server is authoritative for every active membership of this user."""
    circles = _list_circles(ctx.client)
    for circle in circles:
        if circle.get("member_id"):
            ctx.cfg.setdefault("circle_members", {})[circle["id"]] = {
                "id": circle["member_id"], "role": circle["my_role"],
                "name": (ctx.cfg.get("member") or {}).get("name"),
                "email": (ctx.cfg.get("member") or {}).get("email"),
                "user_id": circle.get("user_id")}
    return circles


def _match_circle(circles, spec):
    """Resolve a circle name or id/prefix to a circle id. Never guesses.

    Exact name match wins; otherwise an id prefix must match exactly one
    circle. Ambiguity or no match raises HubError listing the candidates.
    """
    by_name = [
        c for c in circles if isinstance(c, dict) and c.get("name") == spec
    ]
    if len(by_name) == 1:
        return by_name[0].get("id")
    if len(by_name) > 1:
        raise HubError(
            "bad_request",
            "Multiple circles named %r; use an id instead: %s"
            % (spec, ", ".join(str(c.get("id")) for c in by_name)),
        )
    by_id = [
        c
        for c in circles
        if isinstance(c, dict) and str(c.get("id") or "").startswith(spec)
    ]
    if len(by_id) == 1:
        return by_id[0].get("id")
    if len(by_id) > 1:
        raise HubError(
            "bad_request",
            "Ambiguous circle %r; matches: %s"
            % (
                spec,
                ", ".join(
                    "%s (%s)" % (c.get("id"), c.get("name")) for c in by_id
                ),
            ),
        )
    available = ", ".join(
        repr(c.get("name")) for c in circles if isinstance(c, dict)
    )
    raise HubError(
        "not_found",
        "No circle matches %r. Available: %s" % (spec, available or "(none)"),
    )


def _resolve_circle(args, ctx):
    """Central circle resolution for every command.

    `--circle <name-or-id>` wins; otherwise the profile's active circle
    (active_circle_id, otherwise the initial registration family_id). Raises HubError
    when nothing resolves — callers never see a bare None.

    An explicit --circle override also retargets the client to that
    circle membership while retaining the server credential.
    """
    override = getattr(args, "circle", None)
    if override:
        if getattr(ctx,"resolved_circle",None):
            return ctx.resolved_circle
        cid = _match_circle(_profile_circles(ctx), override)
        _retarget_client(ctx, args, cid)
        return cid
    cid = _active_circle_id(ctx.cfg)
    if not cid:
        raise HubError(
            "config",
            "No active circle in this profile — run `hub circle use <name>` "
            "or re-run `hub setup` to refresh it.",
        )
    return cid


